<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Spobras.Core/Spobras.Core.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fonte do relatorio fotografico: subconjunto da Carlito (SIL Open Font License 1.1, ver Fontes/OFL.txt), so com as letras
         que o relatorio aceita e com outro nome, como a licenca pede para versao modificada (Fontes/reduzir-fonte.py). -->
    <EmbeddedResource Include="Fontes/SpobrasRelatorio-Regular.ttf" LogicalName="Spobras.Documentos.Fontes.SpobrasRelatorio-Regular.ttf" />
    <EmbeddedResource Include="Fontes/SpobrasRelatorio-Bold.ttf" LogicalName="Spobras.Documentos.Fontes.SpobrasRelatorio-Bold.ttf" />
  </ItemGroup>
</Project>
