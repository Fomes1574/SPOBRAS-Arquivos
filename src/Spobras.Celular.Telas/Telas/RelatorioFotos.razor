@page "/relatorio/fotos"
@using Spobras.Core.Relatorio
@inherits Tela
@implements IAsyncDisposable
@inject IJSRuntime JS

<Barra Titulo="Relatório fotográfico" Sub="@Resumo" Voltar="relatorio">
    <a class="acao texto" href="relatorio/conferir" style="text-decoration:none">Seguir</a>
</Barra>
<div class="conteudo" style="padding-bottom:@(TemDesfazer ? "170px" : "90px")">
    <Etapas Atual="1" />
    @if (Erro is not null)
    {
        <Aviso Tipo="erro">@Erro</Aviso>
    }
    @if (App.Rascunho.AvisoDeRecuperacao is { } recuperado)
    {
        <Aviso Tipo="atencao"><span>@recuperado</span> <button class="link" @onclick="() => App.Rascunho.AvisoDeRecuperacao = null">Entendi</button></Aviso>
    }
    @foreach (var r in _recusadas)
    {
        <Aviso Tipo="atencao">@r</Aviso>
    }
    @if (_avisoLegenda is not null)
    {
        <Aviso Tipo="ok">@_avisoLegenda</Aviso>
    }
    <div class="secao-modo" role="radiogroup" aria-label="O que vai embaixo de cada foto">
        <div class="titulo-modo">O que vai embaixo de cada foto</div>
        <button class="modo @(ComDescricao ? "" : "on")" role="radio" aria-checked="@(ComDescricao ? "false" : "true")" @onclick="() => TrocarModo(ModoLegenda.LegendaCurta)">
            <span class="radio"></span><DesenhoPagina Fotos="6" /><span class="txt"><b>Só legenda</b><span>Até 6 fotos por página</span></span>
        </button>
        <button class="modo @(ComDescricao ? "on" : "")" role="radio" aria-checked="@(ComDescricao ? "true" : "false")" @onclick="() => TrocarModo(ModoLegenda.DescricaoServico)">
            <span class="radio"></span><DesenhoPagina Fotos="4" /><span class="txt"><b>Legenda e descrição do serviço</b><span>Até 4 fotos por página: o texto ocupa mais espaço</span></span>
        </button>
    </div>
    @if (!_selecionando)
    {
        <button class="cartao-carimbo @(Ajuste.Ligado ? "on" : "")" @onclick="AbrirCarimbo" aria-label="Carimbo nas fotos: @(Ajuste.Ligado ? "ligado" : "desligado")">
            <span class="txt"><b>Carimbo nas fotos</b><span>@ResumoCarimbo</span></span>
            <span class="estado-carimbo">@(Ajuste.Ligado ? "Ligado" : "Desligado")</span>
        </button>
    }
    @if (App.Rascunho.DescricoesGuardadas > 0)
    {
        <Aviso Tipo="atencao">@Formato.Plural(App.Rascunho.DescricoesGuardadas, "foto tem", "fotos têm") descrição guardada. Com “Só legenda” ela não sai no relatório, mas continua aqui.</Aviso>
    }
    <div class="linha-btns" style="margin-bottom:10px">
        <button class="btn linha pequeno" @onclick="DaGaleria">Da galeria</button>

        @if (Fotos.Count > 0 && !_selecionando)
        {
            <button class="btn linha pequeno" @onclick="() => _ordenar = true">Ordenar ▾</button>
            <button class="btn linha pequeno" @onclick="IniciarSelecao">Selecionar</button>
        }
    </div>
    @if (_selecionando)
    {
        <div class="painel legenda-varias">
            <div class="barra-selecao">
                <span class="conta" aria-live="polite">@Formato.Plural(_marcadas.Count, "marcada", "marcadas")</span>
                <button class="btn linha pequeno" @onclick="CancelarSelecao">Cancelar</button>
            </div>
            <div class="linha-btns" style="margin-bottom:10px">
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == Fotos.Count)" @onclick="MarcarTodas">Marcar todas</button>
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == 0)" @onclick="DesmarcarTodas">Desmarcar todas</button>
            </div>
            <div class="linha-btns" style="margin-bottom:12px">
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == 0)" @onclick="() => MoverMarcadas(false)">Mover para o início</button>
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == 0)" @onclick="() => MoverMarcadas(true)">Mover para o fim</button>
            </div>
            <div class="titulo-modo" style="margin-top:4px">@(_marcadas.Count switch { 0 => "Mesmo texto para várias fotos", 1 => "Mesmo texto para a marcada", var n => $"Mesmo texto para as {n} marcadas" })</div>
            <CampoTexto @key="_rodadaLote" Rotulo="Legenda" Ajuda="Sai em negrito, logo embaixo da foto." Valor="@_legenda" Maximo="RascunhoRelatorio.MaximoDaLegenda"
                        Dica="Ex.: concretagem do bloco B1" AoDigitar="v => _legenda = v" AoMudar="v => _legenda = v" />
            @if (ComDescricao)
            {
                <CampoTexto @key="(_rodadaLote, 1)" Rotulo="Descrição do serviço" Ajuda="Texto mais detalhado, embaixo da legenda." Valor="@_descricao" Linhas="3"
                            Maximo="RascunhoRelatorio.MaximoDaDescricao" Dica="Ex.: concreto usinado fck 30 MPa, adensado e com cura úmida"
                            AoDigitar="v => _descricao = v" AoMudar="v => _descricao = v" />
            }
            <p class="mini" style="margin:-4px 2px 10px">@(_marcadas.Count > 0 ? "Campo deixado vazio aqui não apaga nada nas fotos." : "Sem nenhuma marcada, o texto vai só para as fotos com o campo em branco.")</p>
            <button class="btn primario" @onclick="AplicarTexto">@TextoAplicar</button>
            <button class="btn perigo" disabled="@(_marcadas.Count == 0)" @onclick="() => _confirmarVarias = true">@(_marcadas.Count == 1 ? "Tirar a marcada do relatório" : $"Tirar as {_marcadas.Count} do relatório")</button>
        </div>
    }
    <div class="fotos" @ref="_grade" data-selecao="@(_selecionando ? "true" : "false")">
        @for (int i = 0; i < Fotos.Count; i++)
        {
            int n = i;
            var f = Fotos[n];
            <button class="foto" @key="f.Arquivo" data-foto="true" @onclick="() => TocarFoto(n)" aria-pressed="@(_selecionando ? (_marcadas.Contains(n) ? "true" : "false") : null)" aria-label="@Rotulo(n, f)">
                @{ string mini = App.Rascunho.Miniatura(f); }
                @if (mini.Length > 0)
                {
                    <img src="@mini" alt="" />
                }
                else if (App.Rascunho.SemPrevia(f))
                {
                    <span class="sem-previa">Sem prévia</span>
                }
                <span class="n">@(n + 1)</span>
                @if (_selecionando && _marcadas.Contains(n))
                {
                    <span class="foto-marcada" aria-hidden="true">✓</span>
                }
                @if (f.Legenda.Length == 0)
                {
                    <span class="falta">Sem legenda</span>
                }
                else if (ComDescricao && f.Descricao.Trim().Length == 0 && !_selecionando)
                {
                    <span class="falta">Falta descrição</span>
                }
                else
                {
                    <span class="leg">@f.Legenda</span>
                }
            </button>
        }
        @foreach (var sv in App.Rascunho.Salvando)
        {
            var esta = sv;
            if (esta.Erro is null)
            {
                <div class="foto salvando" @key="esta.Id" role="img" aria-label="Foto @(Fotos.Count + 1): salvando">
                    @if (esta.Previa.Length > 0)
                    {
                        <img src="@esta.Previa" alt="" />
                    }
                    <span class="girando" aria-hidden="true"></span>
                    <span class="estado">Salvando…</span>
                </div>
            }
            else
            {
                <button class="foto nao-salva" @key="esta.Id" @onclick="() => _naoSalva = esta.Id" aria-label="Foto não salva. Tocar para tentar de novo ou tirar">
                    @if (esta.Previa.Length > 0)
                    {
                        <img src="@esta.Previa" alt="" />
                    }
                    <span class="estado">Não salva · toque</span>
                </button>
            }
        }
        <a class="foto add" href="relatorio/camera" style="text-decoration:none">+ Tirar foto</a>
    </div>
    <Aviso Tipo="ok"><span>Fotos guardadas no rascunho dentro do app. Pode sair, atender ligação ou desligar o celular: ao voltar, está tudo aqui.</span></Aviso>
    <p class="mini" style="margin:10px 2px 0">Toque numa foto para escrever @(ComDescricao ? "a legenda e a descrição" : "a legenda"), girar, mudar de lugar ou tirar. Segure e arraste para mudar a ordem.</p>
</div>
@if (!_selecionando)
{
    <a class="fab @(TemDesfazer ? "acima" : "")" href="relatorio/camera" style="text-decoration:none"><Icone Nome="relatorio" Cor="#fff" />Tirar foto</a>
}
@if (TemDesfazer)
{
    <div class="desfazer" role="status" aria-live="polite">
        @if (_textoOrdem is null && _ultimaRemovida is { Length: > 0 } urlRemovida)
        {
            <img class="mini-foto" src="@urlRemovida" alt="" />
        }
        <span class="txt">@(_textoOrdem ?? (_removidas == 1 ? "Foto removida" : $"{_removidas} fotos removidas"))</span>
        <button @onclick="Desfazer">Desfazer</button>
        <i class="tempo-desfazer" @key="_rodada"></i>
    </div>
}
<Nav Ativo="relatorio" />
<Ocupado Texto="@Trabalhando" />

@if (_confirmarVarias)
{
    <div class="veu" @onclick="() => _confirmarVarias = false"></div>
    <div class="dialogo" role="dialog" aria-label="Tirar fotos do relatório">
        <h3>Tirar @Formato.Plural(_marcadas.Count, "foto", "fotos") do relatório?</h3>
        <p class="texto2" style="margin:0">As fotos da galeria do celular não são apagadas. Dá para desfazer logo depois.</p>
        <div class="linha-btns"><button class="btn linha" @onclick="() => _confirmarVarias = false">Manter</button><button class="btn primario" @onclick="RemoverMarcadas">Tirar @_marcadas.Count</button></div>
    </div>
}

@if (_naoSalva is long idNaoSalva && App.Rascunho.Salvando.FirstOrDefault(x => x.Id == idNaoSalva) is { Erro: { } motivo } naoSalva)
{
    <Folha Aberta="true" Titulo="Esta foto não foi salva" AoFechar="() => _naoSalva = null">
        @if (naoSalva.Previa.Length > 0)
        {
            <img class="previa-foto" src="@naoSalva.Previa" alt="Foto que não foi salva" />
        }
        <p class="texto2" style="margin:0 0 12px">Não foi possível salvar esta foto (@motivo). Ela ainda pode estar na memória do celular: tente de novo. Se não der, tire a foto outra vez.</p>
        <button class="btn primario" style="margin-bottom:8px" @onclick="() => TentarDeNovo(idNaoSalva)">Tentar de novo</button>
        <button class="btn linha" @onclick="() => TirarNaoSalva(idNaoSalva)">Tirar da lista</button>
    </Folha>
}

<Folha Aberta="_carimbo" Titulo="Carimbo nas fotos" AoFechar="FecharCarimbo">
    <button class="opcao @(Ajuste.Ligado ? "on" : "")" @onclick="() => App.Carimbar(a => a with { Ligado = !a.Ligado })">
        <span>Carimbar as fotos<small>Vai gravado na cópia que entra no relatório. A foto original não muda.</small></span><span class="marca"></span>
    </button>
    @if (Ajuste.Ligado)
    {
        <div class="chips" role="group" aria-label="O que entra no carimbo" style="margin:10px 0 8px">
            <button class="chip @(Ajuste.Escola ? "on" : "")" aria-pressed="@(Ajuste.Escola ? "true" : "false")" @onclick="() => App.Carimbar(a => a with { Escola = !a.Escola })">Escola</button>
            <button class="chip @(Ajuste.Endereco ? "on" : "")" aria-pressed="@(Ajuste.Endereco ? "true" : "false")" @onclick="() => App.Carimbar(a => a with { Endereco = !a.Endereco })">Endereço</button>
            <button class="chip @(Ajuste.Data ? "on" : "")" aria-pressed="@(Ajuste.Data ? "true" : "false")" @onclick="() => App.Carimbar(a => a with { Data = !a.Data })">Data</button>
            <button class="chip @(Ajuste.Hora ? "on" : "")" aria-pressed="@(Ajuste.Hora ? "true" : "false")" @onclick="() => App.Carimbar(a => a with { Hora = !a.Hora })">Hora</button>
        </div>
        var ex = Exemplo();
        <PreviaCarimbo @ref="_previa" Url="@ex.Url" Largura="ex.Largura" Altura="ex.Altura" Carimbo="ex.Carimbo" Arrastavel="true" Versao="_versaoCarimbo" />
        @if (_exemploSemData && (Ajuste.Data || Ajuste.Hora))
        {
            <p class="mini" style="margin:6px 2px 0">Esta foto não tem data gravada (veio da galeria sem a data): o carimbo dela sai sem data e hora.</p>
        }
        @if (ex.Carimbo is null)
        {
            <p class="mini" style="margin:6px 2px 0">Escolha pelo menos um item. Sem nome da escola, endereço ou data, nada é carimbado.</p>
        }
        <p class="mini" style="margin:6px 2px 10px">Arraste o carimbo: ele gruda no canto mais perto. Com dois dedos, muda o tamanho.</p>
        <div class="campo" style="margin-bottom:8px">
            <label for="tamanho-carimbo">Tamanho</label>
            <input id="tamanho-carimbo" class="faixa" type="range" min="@((int)(AjusteCarimbo.TamanhoMinimo * 1000))" max="@((int)(AjusteCarimbo.TamanhoMaximo * 1000))" step="1"
                   value="@((int)Math.Round(Ajuste.Tamanho * 1000))" @onchange="MudarTamanho" aria-valuetext="@TextoTamanho" />
        </div>
        <div class="linha-btns" style="margin-bottom:8px">
            @if (TemDeitada && TemEmPe)
            {
                <button class="btn linha pequeno" @onclick="() => _verEmPe = !_verEmPe">@(_verEmPe ? "Ver deitada" : "Ver em pé")</button>
            }
            <button class="btn linha pequeno" @onclick="() => App.Carimbar(a => a.Padrao())">Padrão</button>
        </div>
        @if (Ajuste.Endereco)
        {
            <p class="mini" style="margin:0 2px 10px">@(App.Rascunho.Dados.Endereco.Length > 0 ? "Endereço: " + App.Rascunho.Dados.Endereco + "." : "O endereço é lido pelo GPS quando a câmera abrir (ou digite nos dados do relatório).") <a href="relatorio">Ver nos dados</a></p>
        }
        @if (App.Config.FotosNaGaleria)
        {
            <p class="mini" style="margin:0 2px 10px">As próximas fotos da câmera vão carimbadas também para a galeria.</p>
        }
    }
    <button class="btn primario" @onclick="FecharCarimbo">Pronto</button>
</Folha>

<Folha Aberta="_ordenar" Titulo="Ordenar fotos" AoFechar="() => _ordenar = false">
    <button class="opcao" @onclick="() => Ordenar(true)">Por data da foto</button>
    <button class="opcao" @onclick="() => Ordenar(false)">Por nome do arquivo</button>
    <button class="opcao" @onclick="DeitadasPrimeiro">Deitadas primeiro, em pé no fim</button>
</Folha>

@if (_aberta is int a && a < Fotos.Count)
{
    var f = Fotos[a];
    <Folha Aberta="true" Titulo="@($"Foto {a + 1} de {Fotos.Count}")" AoFechar="() => _aberta = null">
        @if (Ajuste.Ligado && !f.SemCarimbo)
        {
            var tam = App.Rascunho.TamanhoGirado(f);
            <div class="previa-foto-carimbo"><PreviaCarimbo Url="@App.Rascunho.Miniatura(f)" Largura="tam.Largura" Altura="tam.Altura" Carimbo="App.Rascunho.CarimboDe(f)" /></div>
        }
        else
        {
            <img class="previa-foto" src="@App.Rascunho.Miniatura(f)" alt="Foto @(a + 1)" hidden="@(App.Rascunho.Miniatura(f).Length == 0)" />
        }
        <CampoTexto @key="f.Arquivo" Rotulo="Legenda" Ajuda="Sai em negrito, logo embaixo da foto." Valor="@f.Legenda" Maximo="RascunhoRelatorio.MaximoDaLegenda" GravarAoDigitar="true"
                    Dica="Ex.: concretagem do bloco B1" AoMudar="v => App.Rascunho.Legendar(a, v)" />
        @if (ComDescricao)
        {
            <CampoTexto @key="(f.Arquivo, 1)" Rotulo="Descrição do serviço" Ajuda="Texto mais detalhado, embaixo da legenda." Valor="@f.Descricao" Linhas="4"
                        Maximo="RascunhoRelatorio.MaximoDaDescricao" GravarAoDigitar="true" Dica="Ex.: concreto usinado fck 30 MPa, adensado e com cura úmida"
                        AoMudar="v => App.Rascunho.Descrever(a, v)" />
        }
        <div class="linha-btns" style="margin-bottom:8px">
            <button class="btn linha pequeno" @onclick="() => App.Rascunho.Girar(a)">Girar ↻</button>
            <button class="btn linha pequeno" disabled="@(a == 0)" @onclick="() => Mover(a, a - 1)">‹ Mover</button>
            <button class="btn linha pequeno" disabled="@(a == Fotos.Count - 1)" @onclick="() => Mover(a, a + 1)">Mover ›</button>
        </div>
        <div class="linha-btns" style="margin-bottom:8px">
            <button class="btn linha pequeno" disabled="@(a == 0)" @onclick="() => _aberta = a - 1">‹ Anterior</button>
            <button class="btn linha pequeno" disabled="@(a == Fotos.Count - 1)" @onclick="() => _aberta = a + 1">Próxima ›</button>
        </div>
        @if (Ajuste.Ligado)
        {
            <button class="opcao @(f.SemCarimbo ? "" : "on")" style="margin-bottom:6px" @onclick="() => App.Rascunho.SemCarimbo(a, !f.SemCarimbo)"><span>Carimbo nesta foto<small>@(f.SemCarimbo ? "Esta foto sai sem carimbo" : "Sai com o carimbo do relatório")</small></span><span class="marca"></span></button>
        }
        <button class="link" style="color:var(--vermelho);margin-bottom:6px" @onclick="() => Remover([a])">Tirar esta foto do relatório</button>
        <button class="btn primario" @onclick="() => _aberta = null">Pronto</button>
    </Folha>
}

@code {
    private ElementReference _grade;
    private IJSObjectReference? _arrastar;
    private DotNetObjectReference<RelatorioFotos>? _referencia;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _arrastar = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/arrastar.js");
            _referencia = DotNetObjectReference.Create(this);
            await _arrastar.InvokeVoidAsync("ligar", _grade, _referencia);
        }

        // O editor liga o arrastar no desenho da foto; se o desenho foi refeito (carimbo desligado e ligado), liga de novo.
        if (_carimbo && _previa is not null && _previa.Elemento.Id is { } id && id != _svgLigado)
        {
            _svgLigado = id;
            _moduloCarimbo ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/carimbo.js");
            await _moduloCarimbo.InvokeVoidAsync("ligar", _previa.Elemento, _referencia);
        }
    }

    // ---- Carimbo ----
    private bool _carimbo, _verEmPe, _exemploSemData;
    private int _versaoCarimbo;
    private PreviaCarimbo? _previa;
    private IJSObjectReference? _moduloCarimbo;
    private string? _svgLigado;

    private AjusteCarimbo Ajuste => App.Config.Carimbo;

    private bool TemDeitada => Fotos.Any(f => App.Rascunho.TamanhoGirado(f) is var t && t.Largura >= t.Altura);
    private bool TemEmPe => Fotos.Any(f => App.Rascunho.TamanhoGirado(f) is var t && t.Altura > t.Largura);

    private string ResumoCarimbo
    {
        get
        {
            var a = Ajuste;
            var itens = new[] { (a.Escola, "escola"), (a.Endereco, "endereço"), (a.Data, "data"), (a.Hora, "hora") }.Where(x => x.Item1).Select(x => x.Item2).ToList();
            if (!a.Ligado) return "Escola, endereço, data e hora gravados na foto do relatório";
            return itens.Count == 0 ? "Nada escolhido para carimbar" : char.ToUpperInvariant(itens[0][0]) + string.Join(", ", itens)[1..];
        }
    }

    private string TextoTamanho => Ajuste.Tamanho >= 0.06 ? "grande" : Ajuste.Tamanho >= 0.04 ? "médio" : "pequeno";

    private void AbrirCarimbo()
    {
        _carimbo = true;
        _verEmPe = !TemDeitada && TemEmPe;
        _svgLigado = null;
    }

    private void FecharCarimbo() => _carimbo = false;

    /// <summary>Foto de exemplo do editor (a primeira deitada ou em pe) com o carimbo dela.</summary>
    private (CarimboFoto? Carimbo, int Largura, int Altura, string Url) Exemplo()
    {
        var foto = Fotos.FirstOrDefault(f => App.Rascunho.TamanhoGirado(f) is var t && (_verEmPe ? t.Altura > t.Largura : t.Largura >= t.Altura)) ?? Fotos.FirstOrDefault();
        if (foto is null)
        {
            _exemploSemData = false;
            var d = App.Rascunho.Dados;
            var semFoto = CarimboFoto.Montar(Ajuste, d.Unidade, d.Endereco, App.Agora().LocalDateTime);
            return _verEmPe ? (semFoto, 1200, 1600, "") : (semFoto, 1600, 1200, "");
        }

        var (l, a) = App.Rascunho.TamanhoGirado(foto);
        _exemploSemData = foto.CapturadaEm is null;
        var c = CarimboFoto.Montar(Ajuste, App.Rascunho.Dados.Unidade, App.Rascunho.Dados.Endereco, foto.CapturadaEm);
        return (c, l, a, App.Rascunho.Miniatura(foto));
    }

    [JSInvokable]
    public void CarimboSolto(double x, double y, double largura, double altura)
    {
        var (_, l, a, _) = Exemplo();
        App.Carimbar(aj => aj.Soltar(x, y, largura, altura, l, a));
        _versaoCarimbo++;
        StateHasChanged();
    }

    [JSInvokable]
    public void CarimboTamanho(double fator)
    {
        if (!double.IsFinite(fator) || fator <= 0) return;
        App.Carimbar(aj => aj with { Tamanho = aj.Tamanho * fator });
        _versaoCarimbo++;
        StateHasChanged();
    }

    private void MudarTamanho(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int milesimos))
        {
            App.Carimbar(aj => aj with { Tamanho = milesimos / 1000.0 });
            _versaoCarimbo++;
        }
    }

    // ---- Fotos que nao foram salvas ----
    private long? _naoSalva;

    private async Task TentarDeNovo(long id)
    {
        _naoSalva = null;
        bool voltou = false;
        try
        {
            _moduloCamera ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/camera.js");
            App.Rascunho.SalvarDeNovo(id);
            voltou = await _moduloCamera.InvokeAsync<bool>("tentarDeNovo", id, App.Camera.Referencia(JS));
        }
        catch (JSException)
        {
        }

        if (!voltou)
        {
            App.Rascunho.EsquecerSalvando(id);
            _avisoLegenda = null;
            Erro = "A foto não estava mais na memória do celular. Tire a foto de novo.";
        }
    }

    private async Task TirarNaoSalva(long id)
    {
        _naoSalva = null;
        App.Rascunho.EsquecerSalvando(id);
        try
        {
            _moduloCamera ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/camera.js");
            await _moduloCamera.InvokeVoidAsync("esquecer", id);
        }
        catch (JSException)
        {
        }
    }

    private IJSObjectReference? _moduloCamera;

    [JSInvokable]
    public void ReordenarFoto(int de, int para)
    {
        App.Rascunho.Mover(de, para);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        App.Rascunho.MiniaturaPronta -= AoFicarPronta;
        App.Rascunho.Mudou -= AoFicarPronta;
        // Saiu da tela com o Desfazer aberto: a remocao (ou a nova ordem) vale.
        App.Rascunho.EsquecerOrdem();
        if (_removidas > 0)
        {
            _relogio?.Cancel();
            App.Rascunho.FinalizarRemocoes();
        }

        try
        {
            if (_arrastar is not null)
            {
                await _arrastar.InvokeVoidAsync("desligar", _grade);
                await _arrastar.DisposeAsync();
            }

            if (_moduloCarimbo is not null) await _moduloCarimbo.DisposeAsync();
            if (_moduloCamera is not null) await _moduloCamera.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _referencia?.Dispose();
    }

    private bool _ordenar;

    private void Ordenar(bool porData)
    {
        App.Rascunho.OrdenarFotos(porData);
        App.Rascunho.EsquecerOrdem(); // a ordem nova vale; o Desfazer de uma reordenacao anterior nao volta mais
        _textoOrdem = null;
        _ordenar = false;
    }

    private bool _selecionando;
    private readonly HashSet<int> _marcadas = [];
    private string _legenda = "";
    private string? _avisoLegenda;

    private void IniciarSelecao()
    {
        _avisoLegenda = null;
        _selecionando = true;
    }

    private void TocarFoto(int indice)
    {
        if (!_selecionando) _aberta = indice;
        else if (!_marcadas.Add(indice)) _marcadas.Remove(indice);
    }

    private void MarcarTodas() => _marcadas.UnionWith(Enumerable.Range(0, Fotos.Count));

    private void DesmarcarTodas() => _marcadas.Clear();

    private void CancelarSelecao()
    {
        _selecionando = false;
        _marcadas.Clear();
        _legenda = _descricao = "";
        _rodadaLote++;
    }

    private string _descricao = "";
    private int _rodadaLote;

    private bool ComDescricao => App.Rascunho.Dados.Modo == ModoLegenda.DescricaoServico;

    private void TrocarModo(ModoLegenda modo) => App.Rascunho.TrocarModo(modo);

    private string TextoAplicar
    {
        get
        {
            if (_marcadas.Count > 0) return _marcadas.Count == 1 ? "Aplicar à marcada" : $"Aplicar às {_marcadas.Count} marcadas";
            int n = App.Rascunho.AlvoDoTexto([], _legenda.Trim().Length > 0 || _descricao.Trim().Length == 0, ComDescricao && _descricao.Trim().Length > 0);
            string vazio = ComDescricao ? "sem texto" : "sem legenda";
            return n == 0 ? $"Nenhuma foto {vazio}" : n == 1 ? $"Aplicar à foto {vazio}" : $"Aplicar às {n} fotos {vazio}";
        }
    }

    /// <summary>Aplica e continua selecionando: marca o proximo grupo e digita outro texto.</summary>
    private void AplicarTexto()
    {
        if (_legenda.Trim().Length == 0 && (!ComDescricao || _descricao.Trim().Length == 0))
        {
            _avisoLegenda = ComDescricao ? "Escreva a legenda ou a descrição para aplicar." : "Escreva a legenda para aplicar.";
            return;
        }

        int total = App.Rascunho.TextoEmVarias(_marcadas, _legenda, ComDescricao ? _descricao : null);
        _avisoLegenda = total == 0 ? "Nenhuma foto mudou: elas já tinham esse texto." : $"Texto aplicado a {Formato.Plural(total, "foto", "fotos")}.";
        _marcadas.Clear();
        _legenda = _descricao = "";
        _rodadaLote++; // limpa os campos
    }

    // ---- Remover com Desfazer (5 s) ----
    private const int SegundosDesfazer = 5;
    private bool _confirmarVarias;
    private int _removidas, _rodada;
    private string? _ultimaRemovida;
    private CancellationTokenSource? _relogio;

    private void RemoverMarcadas()
    {
        _confirmarVarias = false;
        var indices = _marcadas.ToList();
        CancelarSelecao();
        Remover(indices);
    }

    private void Remover(IReadOnlyList<int> indices)
    {
        if (indices.Count == 0)
        {
            return;
        }

        var ultima = Fotos.ElementAtOrDefault(indices.Max());
        _ultimaRemovida = ultima is null ? null : App.Rascunho.Miniatura(ultima);
        _removidas = App.Rascunho.Remover(indices);
        _textoOrdem = null; // o Desfazer passa a ser o desta remocao
        _aberta = null;
        _rodada++; // a barra vermelha comeca cheia de novo
        _relogio?.Cancel();
        var esta = _relogio = new CancellationTokenSource();
        _ = Contar(esta.Token);
    }

    private async Task Contar(CancellationToken cancelar)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(SegundosDesfazer), cancelar);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            App.Rascunho.FinalizarRemocoes();
            App.Rascunho.EsquecerOrdem();
            _removidas = 0;
            _textoOrdem = null;
            StateHasChanged();
        });
    }

    private void Desfazer()
    {
        _relogio?.Cancel();
        if (_textoOrdem is not null)
        {
            var marcadas = ArquivosMarcados();
            App.Rascunho.DesfazerOrdem();
            Remarcar(marcadas);
            _textoOrdem = null;
            return;
        }

        App.Rascunho.Desfazer();
        _removidas = 0;
    }

    // ---- Reordenar em grupo com Desfazer (5 s) ----
    private string? _textoOrdem;
    private bool TemDesfazer => _removidas > 0 || _textoOrdem is not null;

    private HashSet<string> ArquivosMarcados() => [.. _marcadas.Where(i => i < Fotos.Count).Select(i => Fotos[i].Arquivo)];

    /// <summary>Depois de reordenar, as mesmas fotos continuam marcadas (nas posicoes novas).</summary>
    private void Remarcar(HashSet<string> arquivos)
    {
        _marcadas.Clear();
        for (int i = 0; i < Fotos.Count; i++)
        {
            if (arquivos.Contains(Fotos[i].Arquivo)) _marcadas.Add(i);
        }
    }

    private void MoverMarcadas(bool paraOFim)
    {
        var marcadas = ArquivosMarcados();
        int n = App.Rascunho.MoverMarcadas(_marcadas, paraOFim);
        string onde = paraOFim ? "o fim" : "o início";
        if (n == 0)
        {
            _avisoLegenda = _marcadas.Count == 1 ? $"A foto marcada já está n{(paraOFim ? "o fim" : "o início")}." : $"As fotos marcadas já estão n{(paraOFim ? "o fim" : "o início")}.";
            return;
        }

        Remarcar(marcadas);
        MostrarDesfazerOrdem(n == 1 ? $"Foto marcada foi para {onde}" : $"{n} fotos foram para {onde}");
    }

    private void DeitadasPrimeiro()
    {
        _ordenar = false;
        if (!App.Rascunho.DeitadasPrimeiro())
        {
            _avisoLegenda = "As fotos já estão com as deitadas primeiro e as em pé no fim.";
            return;
        }

        MostrarDesfazerOrdem($"Deitadas primeiro, {Formato.Plural(App.Rascunho.EmPe, "foto em pé", "fotos em pé")} no fim");
    }

    private void MostrarDesfazerOrdem(string texto)
    {
        // Uma remocao ainda no Desfazer passa a valer: o Desfazer agora e o da nova ordem.
        if (_removidas > 0)
        {
            App.Rascunho.FinalizarRemocoes();
            _removidas = 0;
        }

        _textoOrdem = texto;
        _avisoLegenda = null;
        _rodada++;
        _relogio?.Cancel();
        var esta = _relogio = new CancellationTokenSource();
        _ = Contar(esta.Token);
    }

    private int? _aberta;
    private IReadOnlyList<string> _recusadas = [];

    private List<FotoRascunho> Fotos => App.Rascunho.Dados.Fotos;

    private string Resumo
    {
        get
        {
            int salvando = App.Rascunho.SalvandoAgora;
            string mais = salvando > 0 ? $" · {salvando} salvando" : "";
            if (Fotos.Count == 0)
            {
                return salvando > 0 ? $"{Formato.Plural(salvando, "foto", "fotos")} salvando" : "Nenhuma foto ainda";
            }

            int porPagina = Math.Max(1, App.Rascunho.Opcoes().Capacidade);
            int paginas = (Fotos.Count + porPagina - 1) / porPagina;
            return $"{Formato.Plural(Fotos.Count, "foto", "fotos")}{mais} · cerca de {Formato.Plural(paginas, "página", "páginas")}";
        }
    }

    private Task DaGaleria() => Executar("Copiando as fotos…", async () =>
    {
        var escolhidas = await App.Plataforma.EscolherArquivosAsync("image/*", true, App.Rascunho.PastaDasFotos);
        _recusadas = (await Task.Run(() => App.Rascunho.AdicionarCopiadas(escolhidas))).Avisos;
    });

    private static string Rotulo(int n, FotoRascunho f) => f.Legenda.Length > 0 ? $"Foto {n + 1}: {f.Legenda}" : $"Foto {n + 1}";

    private void Mover(int de, int para)
    {
        App.Rascunho.Mover(de, para);
        _aberta = para;
    }

    protected override void Iniciar()
    {
        App.Rascunho.MiniaturaPronta += AoFicarPronta;
        App.Rascunho.Mudou += AoFicarPronta; // foto da camera que terminou de gravar depois de sair dela
    }

    // Miniaturas ficam prontas uma atras da outra: junta e redesenha no maximo umas 8 vezes por segundo.
    private int _redesenho;

    private void AoFicarPronta()
    {
        if (Interlocked.Exchange(ref _redesenho, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(120);
            Volatile.Write(ref _redesenho, 0);
            StateHasChanged();
        });
    }
}
