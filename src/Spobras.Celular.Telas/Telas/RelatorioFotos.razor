@page "/relatorio/fotos"
@inherits Tela
@implements IAsyncDisposable
@inject IJSRuntime JS

<Barra Titulo="Relatório fotográfico" Sub="@Resumo" Voltar="relatorio">
    <a class="acao texto" href="relatorio/conferir" style="text-decoration:none">Seguir</a>
</Barra>
<div class="conteudo" style="padding-bottom:90px">
    <Etapas Atual="1" />
    @if (Erro is not null)
    {
        <Aviso Tipo="erro">@Erro</Aviso>
    }
    @foreach (var r in _recusadas)
    {
        <Aviso Tipo="atencao">@r</Aviso>
    }
    @if (_avisoLegenda is not null)
    {
        <Aviso Tipo="ok">@_avisoLegenda</Aviso>
    }
    <div class="linha-btns" style="margin-bottom:10px">
        <button class="btn linha pequeno" @onclick="DaGaleria">Da galeria</button>
        @if (Fotos.Count > 0 && !_selecionando)
        {
            <button class="btn linha pequeno" @onclick="() => _ordenar = true">Ordenar ▾</button>
            <button class="btn linha pequeno" @onclick="IniciarSelecao">Selecionar</button>
        }
    </div>
    @if (_selecionando)
    {
        <div class="painel legenda-varias">
            <div class="barra-selecao">
                <span class="conta" aria-live="polite">@Formato.Plural(_marcadas.Count, "marcada", "marcadas")</span>
                <button class="btn linha pequeno" @onclick="CancelarSelecao">Cancelar</button>
            </div>
            <div class="linha-btns" style="margin-bottom:10px">
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == Fotos.Count)" @onclick="MarcarTodas">Marcar todas</button>
                <button class="btn linha pequeno" disabled="@(_marcadas.Count == 0)" @onclick="DesmarcarTodas">Desmarcar todas</button>
            </div>
            <div class="campo">
                <label for="legenda-varias">Legenda para as marcadas</label>
                <input id="legenda-varias" type="text" value="@_legenda" @oninput="e => _legenda = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="linha-btns">
                <button class="btn primario" @onclick="AplicarLegenda">Aplicar legenda</button>
                <button class="btn pequeno perigo" disabled="@(_marcadas.Count == 0)" @onclick="() => _confirmarVarias = true">Tirar do relatório</button>
            </div>
        </div>
    }
    <div class="fotos" @ref="_grade" data-selecao="@(_selecionando ? "true" : "false")">
        @for (int i = 0; i < Fotos.Count; i++)
        {
            int n = i;
            var f = Fotos[n];
            <button class="foto" @key="f.Arquivo" data-foto="true" @onclick="() => TocarFoto(n)" aria-pressed="@(_selecionando ? (_marcadas.Contains(n) ? "true" : "false") : null)" aria-label="@Rotulo(n, f)">
                @{ string mini = App.Rascunho.Miniatura(f); }
                @if (mini.Length > 0)
                {
                    <img src="@mini" alt="" />
                }
                <span class="n">@(n + 1)</span>
                @if (_selecionando && _marcadas.Contains(n))
                {
                    <span class="foto-marcada" aria-hidden="true">✓</span>
                }
                @if (f.Legenda.Length > 0)
                {
                    <span class="leg">@f.Legenda</span>
                }
            </button>
        }
        <a class="foto add" href="relatorio/camera" style="text-decoration:none">+ Tirar foto</a>
    </div>
    <Aviso Tipo="ok"><span>Fotos guardadas no rascunho dentro do app. Pode sair, atender ligação ou desligar o celular: ao voltar, está tudo aqui.</span></Aviso>
    <p class="mini" style="margin:10px 2px 0">Toque numa foto para escrever a legenda, girar, mudar de lugar ou tirar. Foto sem legenda vai sem texto embaixo.</p>
</div>
@if (!_selecionando)
{
    <a class="fab @(_removidas > 0 ? "acima" : "")" href="relatorio/camera" style="text-decoration:none"><Icone Nome="relatorio" Cor="#fff" />Tirar foto</a>
}
@if (_removidas > 0)
{
    <div class="desfazer" role="status" aria-live="polite">
        @if (_ultimaRemovida is { Length: > 0 } urlRemovida)
        {
            <img class="mini-foto" src="@urlRemovida" alt="" />
        }
        <span class="txt">@(_removidas == 1 ? "Foto removida" : $"{_removidas} fotos removidas")</span>
        <button @onclick="Desfazer">Desfazer</button>
        <i class="tempo-desfazer" @key="_rodada"></i>
    </div>
}
<Nav Ativo="relatorio" />
<Ocupado Texto="@Trabalhando" />

@if (_confirmarVarias)
{
    <div class="veu" @onclick="() => _confirmarVarias = false"></div>
    <div class="dialogo" role="dialog" aria-label="Tirar fotos do relatório">
        <h3>Tirar @Formato.Plural(_marcadas.Count, "foto", "fotos") do relatório?</h3>
        <p class="texto2" style="margin:0">As fotos da galeria do celular não são apagadas. Dá para desfazer logo depois.</p>
        <div class="linha-btns"><button class="btn linha" @onclick="() => _confirmarVarias = false">Manter</button><button class="btn primario" @onclick="RemoverMarcadas">Tirar @_marcadas.Count</button></div>
    </div>
}

<Folha Aberta="_ordenar" Titulo="Ordenar fotos" AoFechar="() => _ordenar = false">
    <button class="opcao" @onclick="() => Ordenar(true)">Por data da foto</button>
    <button class="opcao" @onclick="() => Ordenar(false)">Por nome do arquivo</button>
</Folha>

@if (_aberta is int a && a < Fotos.Count)
{
    var f = Fotos[a];
    <Folha Aberta="true" Titulo="@($"Foto {a + 1} de {Fotos.Count}")" AoFechar="() => _aberta = null">
        <img class="previa-foto" src="@App.Rascunho.Miniatura(f)" alt="Foto @(a + 1)" hidden="@(App.Rascunho.Miniatura(f).Length == 0)" />
        <CampoTexto @key="f.Arquivo" Rotulo="Legenda (opcional)" Valor="@f.Legenda" Dica="Ex.: execução do piso da sala 3" AoMudar="v => App.Rascunho.Legendar(a, v)" />
        <div class="linha-btns" style="margin-bottom:8px">
            <button class="btn linha pequeno" @onclick="() => App.Rascunho.Girar(a)">Girar ↻</button>
            <button class="btn linha pequeno" disabled="@(a == 0)" @onclick="() => Mover(a, a - 1)">‹ Mover</button>
            <button class="btn linha pequeno" disabled="@(a == Fotos.Count - 1)" @onclick="() => Mover(a, a + 1)">Mover ›</button>
        </div>
        <div class="linha-btns" style="margin-bottom:8px">
            <button class="btn linha pequeno" disabled="@(a == 0)" @onclick="() => _aberta = a - 1">‹ Anterior</button>
            <button class="btn linha pequeno" disabled="@(a == Fotos.Count - 1)" @onclick="() => _aberta = a + 1">Próxima ›</button>
        </div>
        <button class="link" style="color:var(--vermelho);margin-bottom:6px" @onclick="() => Remover([a])">Tirar esta foto do relatório</button>
        <button class="btn primario" @onclick="() => _aberta = null">Pronto</button>
    </Folha>
}

@code {
    private ElementReference _grade;
    private IJSObjectReference? _arrastar;
    private DotNetObjectReference<RelatorioFotos>? _referencia;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _arrastar = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/arrastar.js");
        _referencia = DotNetObjectReference.Create(this);
        await _arrastar.InvokeVoidAsync("ligar", _grade, _referencia);
    }

    [JSInvokable]
    public void ReordenarFoto(int de, int para)
    {
        App.Rascunho.Mover(de, para);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        App.Rascunho.MiniaturaPronta -= AoFicarPronta;
        // Saiu da tela com o Desfazer aberto: a remocao vale.
        if (_removidas > 0)
        {
            _relogio?.Cancel();
            App.Rascunho.FinalizarRemocoes();
        }

        try
        {
            if (_arrastar is not null)
            {
                await _arrastar.InvokeVoidAsync("desligar", _grade);
                await _arrastar.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _referencia?.Dispose();
    }

    private bool _ordenar;

    private void Ordenar(bool porData)
    {
        App.Rascunho.OrdenarFotos(porData);
        _ordenar = false;
    }

    private bool _selecionando;
    private readonly HashSet<int> _marcadas = [];
    private string _legenda = "";
    private string? _avisoLegenda;

    private void IniciarSelecao()
    {
        _avisoLegenda = null;
        _selecionando = true;
    }

    private void TocarFoto(int indice)
    {
        if (!_selecionando) _aberta = indice;
        else if (!_marcadas.Add(indice)) _marcadas.Remove(indice);
    }

    private void MarcarTodas() => _marcadas.UnionWith(Enumerable.Range(0, Fotos.Count));

    private void DesmarcarTodas() => _marcadas.Clear();

    private void CancelarSelecao()
    {
        _selecionando = false;
        _marcadas.Clear();
        _legenda = "";
    }

    /// <summary>Aplica e continua selecionando: marca o proximo grupo e digita outra legenda.</summary>
    private void AplicarLegenda()
    {
        int total = App.Rascunho.LegendarVarias(_marcadas, _legenda);
        _avisoLegenda = $"Legenda aplicada a {Formato.Plural(total, "foto", "fotos")}.";
        _marcadas.Clear();
        _legenda = "";
    }

    // ---- Remover com Desfazer (5 s) ----
    private const int SegundosDesfazer = 5;
    private bool _confirmarVarias;
    private int _removidas, _rodada;
    private string? _ultimaRemovida;
    private CancellationTokenSource? _relogio;

    private void RemoverMarcadas()
    {
        _confirmarVarias = false;
        var indices = _marcadas.ToList();
        CancelarSelecao();
        Remover(indices);
    }

    private void Remover(IReadOnlyList<int> indices)
    {
        if (indices.Count == 0)
        {
            return;
        }

        var ultima = Fotos.ElementAtOrDefault(indices.Max());
        _ultimaRemovida = ultima is null ? null : App.Rascunho.Miniatura(ultima);
        _removidas = App.Rascunho.Remover(indices);
        _aberta = null;
        _rodada++; // a barra vermelha comeca cheia de novo
        _relogio?.Cancel();
        var esta = _relogio = new CancellationTokenSource();
        _ = Contar(esta.Token);
    }

    private async Task Contar(CancellationToken cancelar)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(SegundosDesfazer), cancelar);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            App.Rascunho.FinalizarRemocoes();
            _removidas = 0;
            StateHasChanged();
        });
    }

    private void Desfazer()
    {
        _relogio?.Cancel();
        App.Rascunho.Desfazer();
        _removidas = 0;
    }

    private int? _aberta;
    private IReadOnlyList<string> _recusadas = [];

    private List<FotoRascunho> Fotos => App.Rascunho.Dados.Fotos;

    private string Resumo
    {
        get
        {
            if (Fotos.Count == 0)
            {
                return "Nenhuma foto ainda";
            }

            int porPagina = Math.Max(1, App.Rascunho.Dados.FotosPorPagina);
            int paginas = (Fotos.Count + porPagina - 1) / porPagina;
            return $"{Formato.Plural(Fotos.Count, "foto", "fotos")} · cerca de {Formato.Plural(paginas, "página", "páginas")}";
        }
    }

    private Task DaGaleria() => Executar("Copiando as fotos…", async () =>
    {
        var escolhidas = await App.Plataforma.EscolherArquivosAsync("image/*", true, App.Rascunho.PastaDasFotos);
        _recusadas = await Task.Run(() => App.Rascunho.AdicionarCopiadas(escolhidas));
    });

    private static string Rotulo(int n, FotoRascunho f) => f.Legenda.Length > 0 ? $"Foto {n + 1}: {f.Legenda}" : $"Foto {n + 1}";

    private void Mover(int de, int para)
    {
        App.Rascunho.Mover(de, para);
        _aberta = para;
    }

    protected override void Iniciar() => App.Rascunho.MiniaturaPronta += AoFicarPronta;

    private void AoFicarPronta() => InvokeAsync(StateHasChanged);
}
