@page "/relatorio/camera"
@inherits Tela
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="camera">
    <div class="topo-cam">
        <a class="bt-cam" href="relatorio/fotos" aria-label="Fechar a câmera" style="text-decoration:none;display:grid;place-items:center">✕</a>
        <span style="font-size:13px;text-align:center;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Foto @(Total + 1)@(string.IsNullOrWhiteSpace(App.Rascunho.Dados.Unidade) ? "" : " · " + App.Rascunho.Dados.Unidade)</span>
        <button class="bt-cam flash-atual" @onclick="() => _opcoes = true" aria-label="Flash: @NomeFlash(App.Config.Flash). Abrir configurações da câmera">⚡ @NomeFlash(App.Config.Flash)</button>
        <button class="bt-cam engrenagem-cam" @onclick="() => _opcoes = true" aria-label="Configurações da câmera">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
        </button>
    </div>
    <div class="formatos" role="radiogroup" aria-label="Formato da foto">
        @foreach (var f in Enum.GetValues<FormatoFoto>())
        {
            <button class="bt-cam @(App.Config.FormatoFoto == f ? "on" : "")" role="radio" aria-checked="@(App.Config.FormatoFoto == f ? "true" : "false")" @onclick="() => Formato_(f)">@NomeFormato(f)</button>
        }
    </div>
    <div class="visor" @ref="_visor">
        <div class="moldura" style="@Moldura">
            <video @ref="_video" autoplay playsinline muted></video>
            <div class="flashou"></div>
            <div class="segure" @ref="_segure" hidden>Segure firme…</div>
        </div>
        @if (TextoEndereco is { } local)
        {
            <a class="selo-endereco @(App.Endereco.Lendo ? "lendo" : "")" href="relatorio" aria-label="Endereço das fotos: @local. Abrir os dados do relatório">📍 @local</a>
        }
        @if (_erroCamera is not null)
        {
            <div class="erro-cam" style="position:absolute;inset:0;display:grid;place-items:center"><div>@_erroCamera<br /><br /><button class="bt-cam" @onclick="Abrir">Tentar de novo</button></div></div>
        }
        else
        {
            <div class="dica">@Dica</div>
        }
    </div>
    <div class="rodape-cam">
        <a class="pronto-cam" href="relatorio/fotos" aria-label="Pronto, @Formato.Plural(Total, "foto", "fotos")">
            <img @ref="_miniatura" class="ultima" alt="" hidden="@(_inicial is null)" src="@_inicial" />
            <span class="pronto-n">Pronto (@Total)</span>
            <span class="salvando-cam" @ref="_contador" style="display:none" role="status" aria-live="polite"></span>
        </a>
        <button class="disparo" @ref="_disparo" aria-label="Tirar foto" disabled="@(_erroCamera is not null)"></button>
        <button class="btn linha pequeno" style="background:none;color:#fff;border-color:#666" aria-label="Virar câmera" @onclick="Virar">⟲</button>
    </div>
    @if (Erro is not null)
    {
        <div style="position:absolute;left:12px;right:12px;bottom:120px"><Aviso Tipo="erro">@Erro</Aviso></div>
    }
    else if (NaoSalvas > 0)
    {
        <div style="position:absolute;left:12px;right:12px;bottom:120px"><Aviso Tipo="erro">@(NaoSalvas == 1 ? "Uma foto não foi salva." : $"{NaoSalvas} fotos não foram salvas.") Toque em Pronto para tentar de novo na lista.</Aviso></div>
    }
</div>

<Folha Aberta="_opcoes" Titulo="Configurações da câmera" AoFechar="() => _opcoes = false">
    <b style="font-size:16px;display:block;margin-bottom:8px">Proporção da foto</b>
    @foreach (var f in Enum.GetValues<FormatoFoto>())
    {
        <button class="opcao @(App.Config.FormatoFoto == f ? "on" : "")" @onclick="() => Formato_(f)"><span>@NomeFormato(f)<small>@ExplicaFormato(f)</small></span><span class="marca"></span></button>
    }
    <b style="font-size:16px;display:block;margin-top:14px">Flash</b>
    <div style="margin-top:8px;display:grid;grid-template-columns:1fr 1fr;gap:8px">
        @foreach (var fl in Enum.GetValues<Flash>())
        {
            bool on = App.Config.Flash == fl;
            <button class="btn linha pequeno" style="width:100%;@(on ? "border-color:var(--preto);background:var(--preto);color:#fff" : "")" @onclick="() => DefinirFlash(fl)">@NomeFlash(fl)</button>
        }
    </div>
    @if (_semFlash)
    {
        <p class="mini" style="margin:8px 0 0">Este aparelho não deixa o app controlar o flash da foto; a lanterna @(_temLanterna ? "funciona" : "também não está disponível").</p>
    }
    <b style="font-size:16px;display:block;margin-top:14px">Galeria</b>
    <button class="opcao @(App.Config.FotosNaGaleria ? "on" : "")" style="margin-top:8px" @onclick="Galeria"><span>Guardar também na galeria<small>Além do rascunho do app</small></span><span class="marca"></span></button>
    <p class="mini" style="margin:10px 0 12px">Tudo fica guardado para as próximas fotos. O flash desligado tira a foto na hora; com flash, o celular pede para segurar firme um instante.</p>
    <button class="btn primario" @onclick="() => _opcoes = false">Voltar à câmera</button>
</Folha>

@code {
    private ElementReference _video, _visor, _disparo, _miniatura, _segure, _contador;
    private IJSObjectReference? _modulo;

    /// <summary>Fotos ja no rascunho mais as que ainda estao salvando.</summary>
    private int Total => App.Rascunho.Dados.Fotos.Count + App.Rascunho.Salvando.Count(s => s.Erro is null);

    private int NaoSalvas => App.Rascunho.Salvando.Count(s => s.Erro is not null);

    /// <summary>Selo do endereco (so com o carimbo usando o endereco).</summary>
    private string? TextoEndereco
    {
        get
        {
            if (!EnderecoCelular.Usa(App.Config.Carimbo)) return null;
            var d = App.Rascunho.Dados;
            return App.Endereco.Estado switch
            {
                EstadoEndereco.Lendo => App.Endereco.Precisao is { } p ? $"lendo endereço… precisão {p:0} m" : "lendo endereço…",
                _ when d.Endereco.Length > 0 => d.Endereco,
                EstadoEndereco.SemPermissao => "sem permissão de localização",
                EstadoEndereco.SemSinal => "sem sinal do GPS",
                EstadoEndereco.SemInternet => "sem internet: endereço depois",
                EstadoEndereco.SemServico => "digite o endereço nos dados",
                _ => null,
            };
        }
    }
    private string? _erroCamera;
    private bool _opcoes, _frente, _temLanterna, _semFlash;
    private double _proporcaoVisor = 3.0 / 4.0;

    private static string NomeFormato(FormatoFoto f) => f switch
    {
        FormatoFoto.Padrao43 => "4:3",
        FormatoFoto.Largo169 => "16:9",
        FormatoFoto.TelaCheia => "Tela cheia",
        _ => "1:1",
    };

    private static string ExplicaFormato(FormatoFoto f) => f switch
    {
        FormatoFoto.Padrao43 => "O padrão do celular. Mais área da foto",
        FormatoFoto.Largo169 => "Retangular, ocupa melhor o quadro deitado",
        FormatoFoto.TelaCheia => "Do tamanho da tela; a foto sai como você vê",
        _ => "Quadrada",
    };

    private static string NomeFlash(Flash f) => f switch
    {
        Flash.Auto => "Auto",
        Flash.Ligado => "Ligado",
        Flash.Desligado => "Desligado",
        _ => "Lanterna",
    };

    private static double Proporcao(FormatoFoto f) => f switch
    {
        FormatoFoto.Padrao43 => 4.0 / 3.0,
        FormatoFoto.Largo169 => 16.0 / 9.0,
        FormatoFoto.Quadrado => 1.0,
        _ => 0,
    };

    private string Dica => App.Config.FormatoFoto == FormatoFoto.TelaCheia
        ? "Tela cheia · a foto sai como você vê"
        : $"{NomeFormato(App.Config.FormatoFoto)} · deitado = foto horizontal";

    private string Moldura => App.Config.FormatoFoto == FormatoFoto.TelaCheia
        ? "width:100%;height:100%"
        : $"aspect-ratio:{_proporcaoVisor.ToString(System.Globalization.CultureInfo.InvariantCulture)};width:100%;max-height:100%";

    // A miniatura da ultima foto: a que ja existia ao abrir; depois quem troca e a propria camera (na hora do toque).
    private string? _inicial;

    protected override void Iniciar()
    {
        App.Rascunho.Mudou += Redesenhar;
        App.Endereco.Mudou += Redesenhar;
        if (App.Rascunho.Dados.Fotos.Count > 0 && App.Rascunho.Miniatura(App.Rascunho.Dados.Fotos[^1]) is { Length: > 0 } url)
        {
            _inicial = url;
        }
    }

    protected override async Task OnAfterRenderAsync(bool primeira)
    {
        if (primeira)
        {
            await Abrir();
        }
    }

    private async Task Abrir()
    {
        _erroCamera = null;
        if (!await App.Plataforma.PermitirCameraAsync())
        {
            _erroCamera = "Sem permissão para usar a câmera. Libere nas configurações do Android.";
            StateHasChanged();
            return;
        }

        if (_modulo is null)
        {
            _modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Spobras.Celular.Telas/camera.js");
            await _modulo.InvokeVoidAsync("ligarDisparo", _disparo, _miniatura, _visor, _segure, App.Camera.Referencia(JS), _contador, App.Camera.MaximoNaFila);
            _ = App.Endereco.AoAbrirCameraAsync(App.Config.Carimbo); // em segundo plano: a camera nao espera o GPS
        }

        var r = await _modulo.InvokeAsync<InicioCamera>("iniciar", _video, _frente);
        if (!r.Ok)
        {
            _erroCamera = r.Erro;
        }
        else
        {
            _temLanterna = r.Lanterna;
            _semFlash = !r.Flash;
            await Configurar();
        }

        StateHasChanged();
    }

    /// <summary>Passa formato e flash para a camera (o disparo acontece direto no navegador).</summary>
    private async Task Configurar()
    {
        if (_modulo is not null)
        {
            _proporcaoVisor = await _modulo.InvokeAsync<double>("configurar", Proporcao(App.Config.FormatoFoto), App.Config.Flash.ToString().ToLowerInvariant());
        }
    }

    private async Task Formato_(FormatoFoto f)
    {
        App.Configurar(p => p with { FormatoFoto = f });
        await Configurar();
    }

    private async Task DefinirFlash(Flash f)
    {
        App.Configurar(p => p with { Flash = f, FlashEscolhido = true });
        await Configurar();
    }

    private void Galeria() => App.Configurar(p => p with { FotosNaGaleria = !p.FotosNaGaleria });

    private async Task Virar()
    {
        _frente = !_frente;
        await Abrir();
    }

    // As fotos chegam ao rascunho por App.Camera (fica no app inteiro): aqui so redesenha o contador e o selo.
    private int _redesenho;

    private void Redesenhar()
    {
        if (Interlocked.Exchange(ref _redesenho, 1) == 1) return;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(100);
            Volatile.Write(ref _redesenho, 0);
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        App.Rascunho.Mudou -= Redesenhar;
        App.Endereco.Mudou -= Redesenhar;
        Dispose(); // o Blazor so chama o DisposeAsync quando os dois existem
        if (_modulo is not null)
        {
            try
            {
                await _modulo.InvokeVoidAsync("encerrar"); // espera as fotos ja pegas gravarem antes de desligar
                await _modulo.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

    }

    private sealed record InicioCamera(bool Ok, string? Erro, bool Lanterna, bool Flash);
}
