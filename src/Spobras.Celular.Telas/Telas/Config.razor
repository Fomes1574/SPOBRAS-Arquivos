@page "/config"
@inherits Tela

<Barra Titulo="Configurações" Voltar="" />
<div class="conteudo">
    @if (Erro is not null)
    {
        <Aviso Tipo="erro">@Erro</Aviso>
    }
    <div class="titulo-secao" style="margin-top:2px">Planilha base</div>
    <div class="painel">
        <div style="display:flex;justify-content:space-between;gap:8px"><b>Planilha mestra</b><span class="selo @Selo.Classe">@Selo.Texto</span></div>
        <p class="texto2" style="margin:4px 0 8px">@(App.Base.Planilha?.Nome ?? "Ainda não escolhida")@(App.Base.TemDados ? " · " + Formato.Plural(App.Base.TotalDeObras, "obra", "obras") : "")</p>
        <div class="linha-btns">
            <button class="btn linha pequeno" disabled="@(App.Base.Planilha is null)" @onclick="() => App.Base.AtualizarAsync(forcar: true)">Reler agora</button>
            <button class="btn linha pequeno" @onclick="() => App.Base.EscolherPlanilhaAsync()">@(App.Base.Planilha is null ? "Escolher" : "Trocar")</button>
        </div>
    </div>
    <SituacaoBase />

    <div class="titulo-secao">Arquivos gerados</div>
    <div class="painel">
        <div class="campo" style="margin:0">
            <label>Salvar relatórios e PDFs em</label>
            <button class="btn linha" style="justify-content:space-between;font-weight:400" @onclick="EscolherPasta"><span style="text-align:left;overflow-wrap:anywhere">@(App.Config.Pasta?.Nome ?? "Escolher a pasta")</span><span style="color:var(--azul);font-weight:600">@(App.Config.Pasta is null ? "Escolher" : "Trocar")</span></button>
        </div>
        <button class="opcao @(App.Config.PastaPorEscola ? "on" : "")" style="border-bottom:0" @onclick="() => App.Configurar(p => p with { PastaPorEscola = !p.PastaPorEscola })"><span>Uma pasta para cada escola<small>Nos relatórios fotográficos</small></span><span class="marca"></span></button>
    </div>

    <div class="titulo-secao">Logo dos documentos</div>
    <div class="painel" style="display:flex;align-items:center;gap:12px">
        @if (App.LogoUrl() is { } logo)
        {
            <span class="logo-caixa" style="border:1px solid var(--borda)"><img src="@logo" alt="Logo" /></span>
        }
        else
        {
            <span class="texto2">Nenhum logo escolhido. O relatório sai sem logo.</span>
        }
        <button class="btn linha pequeno" style="margin-left:auto;flex:none" @onclick="EscolherLogo">@(App.Config.Logo is null ? "Escolher" : "Trocar")</button>
    </div>
    <p class="mini" style="margin:4px 2px">Use o mesmo logo do computador (a imagem fica guardada só no celular). O app só lê a planilha mestra; nunca grava nela. Versão @(typeof(Config).Assembly.GetName().Version?.ToString(3)).</p>
    <button class="link" style="margin:8px 2px 0" @onclick="() => _diagnostico = true">Diagnóstico da câmera</button>
    <button class="link" style="margin:8px 2px 0" @onclick="() => _localizacao = true">Diagnóstico da localização</button>
</div>
<Nav Ativo="inicio" />

<Folha Aberta="_localizacao" Titulo="Diagnóstico da localização" AoFechar="() => _localizacao = false">
    @{ var leituras = App.Endereco.Leituras; }
    <p class="texto2" style="margin:0 0 10px">@(App.Config.EnderecoPeloGps ? "Últimas leituras da localização para o endereço das fotos: de onde veio, a precisão e quanto tempo levou." : "O endereço pelo GPS está desligado: o app não usa a localização. Ligue nos dados do relatório.")</p>
    @if (leituras.Count == 0)
    {
        <p class="texto2">Nenhuma leitura desde que o app abriu.</p>
    }
    else
    {
        <table class="tabela-diagnostico">
            <thead><tr><th>Quando e fonte</th><th>Precisão</th><th>Tempo</th></tr></thead>
            <tbody>
                @foreach (var l in leituras.AsEnumerable().Reverse())
                {
                    <tr><td>@l.Quando.ToLocalTime().ToString("HH:mm:ss", Formato.PtBr) · @l.Fonte<br /><small>@l.Resultado</small></td>
                        <td>@(l.Precisao is { } p ? p.ToString("0", Formato.PtBr) + " m" : "—")</td><td>@l.Segundos.ToString("0.0", Formato.PtBr) s</td></tr>
                }
            </tbody>
        </table>
    }
    <button class="btn primario" style="margin-top:12px" @onclick="() => _localizacao = false">Fechar</button>
</Folha>

<Folha Aberta="_diagnostico" Titulo="Diagnóstico da câmera" AoFechar="() => _diagnostico = false">
    @{ var tempos = App.Camera.Tempos; }
    <p class="texto2" style="margin:0 0 10px">Tempo de cada passo nas últimas @Formato.Plural(tempos.Count, "foto", "fotos") tiradas pelo app, em milissegundos. Serve para achar o passo lento neste celular.</p>
    @if (tempos.Count == 0)
    {
        <p class="texto2">Nenhuma foto tirada desde que o app abriu.</p>
    }
    else
    {
        <table class="tabela-diagnostico">
            <thead><tr><th>Passo</th><th>Média</th><th>Pior</th></tr></thead>
            <tbody>
                @foreach (var (nome, valor) in Passos)
                {
                    var valores = tempos.Select(valor).ToList();
                    <tr><td>@nome</td><td>@valores.Average().ToString("0", Formato.PtBr)</td><td>@valores.Max().ToString("0", Formato.PtBr)</td></tr>
                }
            </tbody>
        </table>
        <p class="mini" style="margin:8px 0 12px">Última foto: @tempos[^1].Largura × @tempos[^1].Altura px, @tempos[^1].Kb KB. Preparo de fotos: @Spobras.Documentos.Relatorio.PreparoDeFotos.Paralelo por vez.</p>
    }
    <button class="btn primario" @onclick="() => _diagnostico = false">Fechar</button>
</Folha>

@code {
    private (string Classe, string Texto) Selo => App.Base.Estado switch
    {
        EstadoBase.Atualizada when App.Base.UltimaLeitura is { } u => ("concluido", "LIDA " + u.ToLocalTime().ToString("HH:mm", Formato.PtBr)),
        EstadoBase.Lendo => ("andamento", "LENDO"),
        EstadoBase.SemPlanilha => ("atencao", "FALTA"),
        _ => ("atencao", "VER AVISO"),
    };

    private async Task EscolherPasta()
    {
        if (await App.Plataforma.EscolherPastaAsync() is { } pasta)
        {
            App.Configurar(p => p with { Pasta = pasta });
        }
    }

    private async Task EscolherLogo() => Erro = await App.EscolherLogoAsync();

    private bool _diagnostico, _localizacao;

    private static readonly (string Nome, Func<TempoDaFoto, int> Valor)[] Passos =
    [
        ("Pegar a imagem do visor", t => t.Quadro),
        ("Transformar em JPEG", t => t.Codificar),
        ("Passar para o app e gravar", t => t.Enviar),
        ("Gravar no rascunho", t => t.Gravar),
    ];
}
