@page "/base"
@inherits Tela

<Barra Titulo="Base de dados" Sub="@Subtitulo">
    <button class="acao" aria-label="Reler agora" @onclick="Reler">↻</button>
</Barra>
<div class="conteudo">
    @if (App.Base.Estado is EstadoBase.SemConexao or EstadoBase.Inacessivel or EstadoBase.Invalida or EstadoBase.SemPlanilha or EstadoBase.Lendo)
    {
        <SituacaoBase />
    }
    <div class="busca">
        <Icone Nome="busca" Cor="#9A9A96" />
        <input type="search" placeholder="Escola, contrato, lote, processo…" aria-label="Buscar" value="@App.FiltroBase.Texto" @oninput="Digitou" />
    </div>
    <div class="chips">
        @foreach (var f in Filtros)
        {
            var valores = f.Valor(App.FiltroBase);
            <div class="grupo-chip @(valores.Count > 0 ? "on" : "")">
                <button class="chip" @onclick="() => Abrir(f.Id)">@ResumoFiltro(f, valores) ▾</button>
                @if (valores.Count > 0)
                {
                    <button class="chip limpar-chip" aria-label="@($"Limpar {f.Nome}")" @onclick="() => Limpar(f.Id)">✕</button>
                }
            </div>
        }
    </div>

    @if (_totais is { } t)
    {
        <div class="painel">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><h2 style="margin:0">@(App.FiltroBase.Lote.Count > 1 ? t.Lote : $"Totais do {SelosObra.Lote(t.Lote).ToLowerInvariant()}")</h2><span class="mini">@Formato.Plural(t.Escolas, "escola", "escolas")</span></div>
            <div class="totais" style="margin-top:10px">
                <div><span>Valor original</span><b>@Formato.Reais(t.Original)</b></div>
                <div><span>Aditado</span><b>+ @Formato.Reais(t.Aditado)</b></div>
                <div style="grid-column:1/-1"><span>Contratado com aditamento</span><b>@Formato.Reais(t.Contratado)</b></div>
                <div><span>Pago</span><b>@Formato.Reais(t.Pago)</b></div>
                <div><span>Saldo a pagar</span><b>@Formato.Reais(t.SaldoAPagar)</b></div>
                <div style="grid-column:1/-1"><span>Medições em trâmite (@t.MedicoesEmTramite)</span><b>@Formato.Reais(t.EmTramite)</b></div>
            </div>
            <p class="mini" style="margin:8px 0 0">Soma das obras dos lotes selecionados. Pago + saldo a pagar = contratado com aditamento.</p>
        </div>
    }

    @if (!App.Base.TemDados)
    {
        <div class="vazio-lista">Ainda não há dados. Escolha a planilha mestra para começar.</div>
    }
    else
    {
        <div class="mini" style="margin:0 2px 8px;display:flex;justify-content:space-between"><span>@Formato.Plural(_total, "obra", "obras")</span><span>Saldo a pagar</span></div>
        @foreach (var o in _obras)
        {
            var (classe, texto) = SelosObra.Selo(o);
            <a class="obra" href="obra/@o.Id">
                <div class="l1"><span class="nome">@o.Empreendimento</span><span class="selo @classe">@texto</span></div>
                <div class="l2">@string.Join(" · ", new[] { o.Contrato, SelosObra.Lote(o.Lote), o.Portaria }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                <div class="l3"><span>@(o.DataOs is null ? "Sem Data da OS" : "OS " + Formato.Data(o.DataOs))</span><b>@Formato.Reais(o.SaldoAPagar)</b></div>
            </a>
        }
        @if (_obras.Count == 0)
        {
            <div class="vazio-lista">Nenhuma obra com esses filtros.</div>
        }
        else if (_obras.Count < _total)
        {
            <button class="btn linha" @onclick="Mais">Mostrar mais (@(_total - _obras.Count) restantes)</button>
        }
    }
</div>
<Nav Ativo="base" />

<Folha Aberta="_aberto is not null" Titulo="@_aberto?.Nome" AoFechar="FecharFiltro">
    @if (_aberto is { } filtro)
    {
        <div class="busca"><input type="search" aria-label="Pesquisar opções" placeholder="Pesquisar opções" value="@_pesquisa" @oninput="Pesquisar" /></div>
        <div class="opcoes-filtro">
            @foreach (var op in OpcoesVisiveis())
            {
                bool marcado = filtro.Valor(App.FiltroBase).Contains(op, StringComparer.OrdinalIgnoreCase);
                <label class="opcao opcao-filtro">
                    <span>@(filtro.Id == "lote" ? SelosObra.Lote(op) : op)</span>
                    <input type="checkbox" checked="@marcado" @onchange="() => Escolher(filtro, op)" />
                </label>
            }
        </div>
        <button class="btn primario" @onclick="FecharFiltro">Pronto</button>
    }
</Folha>

@code {
    private sealed record FiltroChip(string Id, string Nome, string Plural, Func<FiltroObras, IReadOnlyList<string>> Valor, Func<OpcoesFiltro, IReadOnlyList<string>> Opcoes, Func<FiltroObras, IReadOnlyList<string>, FiltroObras> Definir);

    private static readonly FiltroChip[] Filtros =
    [
        new("lote", "Lote", "lotes", f => f.Lote, o => o.Lotes, (f, v) => f with { Lote = v }),
        new("portaria", "Portaria", "portarias", f => f.Portaria, o => o.Portarias, (f, v) => f with { Portaria = v }),
        new("empresa", "Empresa", "empresas", f => f.Empresa, o => o.Empresas, (f, v) => f with { Empresa = v }),
        new("status", "Status", "status", f => f.Status, o => o.Status, (f, v) => f with { Status = v }),
        new("contrato", "Contrato", "contratos", f => f.Contrato, o => o.Contratos, (f, v) => f with { Contrato = v }),
        new("escola", "Escola", "escolas", f => f.Escola, o => o.Escolas, (f, v) => f with { Escola = v }),
        new("receita", "Contrato de receita", "contratos de receita", f => f.ContratoReceita, o => o.ContratosReceita, (f, v) => f with { ContratoReceita = v }),
        new("dotacao", "Dotação", "dotações", f => f.Dotacao, o => o.Dotacoes, (f, v) => f with { Dotacao = v }),
    ];

    private const int Pagina = 40;
    private int _limite = Pagina;
    private IReadOnlyList<ObraLida> _obras = [];
    private int _total;
    private TotaisLote? _totais;
    private FiltroChip? _aberto;
    private string _pesquisa = "";
    private readonly Dictionary<string, string> _pesquisas = [];
    private IReadOnlyList<string> _opcoes = [];
    private CancellationTokenSource? _digitando;

    private string Subtitulo => App.Base.UltimaLeitura is { } u
        ? $"{Formato.Plural(App.Base.TotalDeObras, "obra", "obras")} · atualizada {Formato.Quando(u, App.Agora())}"
        : "Base ainda não lida";

    protected override void Iniciar() => Carregar();

    protected override void BaseMudou() => Carregar();

    private void Carregar()
    {
        if (!App.Base.TemDados)
        {
            (_obras, _total, _totais) = ([], 0, null);
            return;
        }

        (_obras, _total) = App.Base.Buscar(App.FiltroBase, _limite);
        _totais = App.FiltroBase.Lote.Count == 0 ? null : App.Base.Totais(App.FiltroBase);
    }

    private async Task Digitou(ChangeEventArgs e)
    {
        string texto = e.Value?.ToString() ?? "";
        _digitando?.Cancel();
        var cancelar = _digitando = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, cancelar.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        App.FiltroBase = App.FiltroBase with { Texto = string.IsNullOrWhiteSpace(texto) ? null : texto.Trim() };
        _limite = Pagina;
        Carregar();
    }

    private static string ResumoFiltro(FiltroChip filtro, IReadOnlyList<string> valores) => valores.Count switch
    {
        0 => filtro.Nome,
        1 => filtro.Id == "lote" ? SelosObra.Lote(valores[0]) : valores[0],
        _ => $"{valores.Count} {filtro.Plural}",
    };

    private void Abrir(string id)
    {
        _aberto = Filtros.First(x => x.Id == id);
        _pesquisa = _pesquisas.GetValueOrDefault(id, "");
        RecarregarOpcoes(_aberto);
    }

    private void FecharFiltro()
    {
        if (_aberto is { } filtro) _pesquisas[filtro.Id] = _pesquisa;
        _aberto = null;
    }

    private void RecarregarOpcoes(FiltroChip filtro) =>
        _opcoes = filtro.Opcoes(App.Base.Opcoes(App.FiltroBase))
            .Union(filtro.Valor(App.FiltroBase), StringComparer.OrdinalIgnoreCase).ToList();

    private void Pesquisar(ChangeEventArgs e) => _pesquisa = e.Value?.ToString() ?? "";

    private IEnumerable<string> OpcoesVisiveis() =>
        _opcoes.Where(o => Normalizacao.Busca(o).Contains(Normalizacao.Busca(_pesquisa), StringComparison.Ordinal));

    private void Escolher(FiltroChip filtro, string valor)
    {
        var atuais = filtro.Valor(App.FiltroBase);
        var outros = atuais.Where(v => !string.Equals(v, valor, StringComparison.OrdinalIgnoreCase)).ToList();
        if (outros.Count == atuais.Count) outros.Add(valor);
        App.FiltroBase = filtro.Definir(App.FiltroBase, outros);
        _limite = Pagina;
        Carregar();
        RecarregarOpcoes(filtro);
    }

    private void Limpar(string id)
    {
        _pesquisas.Remove(id);
        App.FiltroBase = Filtros.First(x => x.Id == id).Definir(App.FiltroBase, []);
        _limite = Pagina;
        Carregar();
    }

    private void Mais()
    {
        _limite += Pagina;
        Carregar();
    }

    private Task Reler() => App.Base.AtualizarAsync(forcar: true);
}
