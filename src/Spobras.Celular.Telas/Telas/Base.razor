@page "/base"
@inherits Tela

<Barra Titulo="Base de dados" Sub="@Subtitulo">
    <button class="acao" aria-label="Reler agora" @onclick="Reler">↻</button>
    <a class="acao engrenagem" href="base/configuracoes" aria-label="Configurações da base" style="text-decoration:none"><Icone Nome="config" /></a>
</Barra>
<div class="conteudo base-contratos">
    @if (App.Base.Estado is EstadoBase.SemConexao or EstadoBase.Inacessivel or EstadoBase.Invalida or EstadoBase.SemPlanilha or EstadoBase.Lendo)
    {
        <SituacaoBase />
    }
    <div class="busca">
        <Icone Nome="busca" Cor="#9A9A96" />
        <input type="search" placeholder="Escola, contrato, lote, processo…" aria-label="Buscar" value="@App.FiltroBase.Texto" @oninput="Digitou" />
    </div>
    <div class="chips">
        @foreach (var f in Filtros)
        {
            var valores = f.Valor(App.FiltroBase);
            <div class="grupo-chip @(valores.Count > 0 ? "on" : "")">
                <button class="chip resumo-acao" @onclick="() => Abrir(f.Id)">@ResumoFiltro(f, valores) ▾</button>
                @if (valores.Count > 0)
                {
                    <button class="chip limpar-chip resumo-acao" aria-label="@($"Limpar {f.Nome}")" @onclick="() => Limpar(f.Id)">✕</button>
                }
            </div>
        }
    </div>

    @if (Erro is not null) { <Aviso Tipo="erro">@Erro</Aviso> }
    @foreach (var resumo in _resumos)
    {
        <CartaoResumoContrato @key="resumo.Identificacao.Contrato" Resumo="resumo" Hoje="Hoje"
                              Exportar="@(_resumos.Count == 1 ? EventCallback.Factory.Create(this, ExportarPdf) : default)"
                              Ocupado="@(Trabalhando is not null)" />
    }
    @if (_resumos.Count > 1)
    {
        <button class="btn primario resumo-acao" disabled="@(Trabalhando is not null)" @onclick="ExportarPdf">Exportar PDF dos @_resumos.Count contratos</button>
    }

    @if (!App.Base.TemDados)
    {
        <div class="vazio-lista">Ainda não há dados. Escolha a planilha mestra para começar.</div>
    }
    else if (_resumos.Count == 0)
    {
        <div class="mini" style="margin:0 2px 8px;display:flex;justify-content:space-between"><span>@Formato.Plural(_total, "obra", "obras")</span><span>Saldo a pagar</span></div>
        @foreach (var o in _obras)
        {
            var (classe, texto) = SelosObra.Selo(o);
            <a class="obra" href="obra/@o.Id">
                <div class="l1"><span class="nome">@o.Empreendimento</span><span class="selo @classe">@texto</span></div>
                <div class="l2">@string.Join(" · ", new[] { o.Contrato, SelosObra.Lote(o.Lote), o.Portaria }.Where(x => !string.IsNullOrWhiteSpace(x)))</div>
                <div class="l3"><span>@(o.DataOs is null ? "Sem Data da OS" : "OS " + Formato.Data(o.DataOs))</span><b>@Formato.Reais(o.SaldoAPagar)</b></div>
            </a>
        }
        @if (_obras.Count == 0)
        {
            <div class="vazio-lista">Nenhuma obra com esses filtros.</div>
        }
        else if (_obras.Count < _total)
        {
            <button class="btn linha" @onclick="Mais">Mostrar mais (@(_total - _obras.Count) restantes)</button>
        }
    }
</div>
<Nav Ativo="base" />

<Folha Aberta="_aberto is not null" Titulo="@_aberto?.Nome" AoFechar="FecharFiltro">
    @if (_aberto is { } filtro)
    {
        <div class="folha-resumo">
        <div class="busca"><input type="search" aria-label="Pesquisar opções" placeholder="Pesquisar opções" value="@_pesquisa" @oninput="Pesquisar" /></div>
        <div class="opcoes-filtro">
            @{ var visiveis = OpcoesVisiveis(); }
            @foreach (var op in visiveis.Take(MaximoDeOpcoes))
            {
                bool marcado = filtro.Valor(App.FiltroBase).Contains(op, StringComparer.OrdinalIgnoreCase);
                <label class="opcao opcao-filtro">
                    <span>
                        @if (_detalhes.TryGetValue(op, out var detalhe))
                        {
                            <b>@detalhe.Titulo</b><small>@detalhe.Detalhe</small>
                        }
                        else { @op }
                    </span>
                    <input type="checkbox" checked="@marcado" @onchange="() => Escolher(filtro, op)" />
                </label>
            }
        </div>
        @if (visiveis.Count > MaximoDeOpcoes)
        {
            <p class="mini" style="margin:-4px 2px 10px">Mostrando @MaximoDeOpcoes de @visiveis.Count.ToString("N0", Formato.PtBr). Pesquise para achar as outras.</p>
        }
        else if (visiveis.Count == 0)
        {
            <p class="mini" style="margin:-4px 2px 10px">Nenhuma opção com esse texto.</p>
        }
        <button class="btn primario resumo-acao" @onclick="FecharFiltro">Pronto</button>
        </div>
    }
</Folha>

@code {
    private sealed record FiltroChip(string Id, string Nome, Func<FiltroObras, IReadOnlyList<string>> Valor, Func<OpcoesFiltro, IReadOnlyList<string>> Opcoes, Func<FiltroObras, IReadOnlyList<string>, FiltroObras> Definir);

    private static readonly FiltroChip[] Filtros =
    [
        new("contrato", "Contrato", f => f.Contrato, o => o.Contratos, (f, v) => f with { Contrato = v }),
        new("portaria", "Portaria", f => f.Portaria, o => o.Portarias, (f, v) => f with { Portaria = v }),
        new("empresa", "Empresa", f => f.Empresa, o => o.Empresas, (f, v) => f with { Empresa = v }),
        new("status", "Status", f => f.Status, o => o.Status, (f, v) => f with { Status = v }),
    ];

    private const int Pagina = 40;
    private int _limite = Pagina;
    private IReadOnlyList<ObraLida> _obras = [];
    private int _total;
    private IReadOnlyList<ResumoContrato> _resumos = [];
    private Dictionary<string, OpcaoContratoResumo> _detalhes = new(StringComparer.OrdinalIgnoreCase);
    private readonly CancellationTokenSource _exportacao = new();
    private DateOnly Hoje => DateOnly.FromDateTime(Spobras.Core.HoraDeBrasilia.De(App.Agora()).DateTime);

    private Task ExportarPdf()
    {
        var token = _exportacao.Token;
        return Executar("Gerando PDF…", async () =>
        {
            var salvo = await App.ResumoPdf.SalvarAsync(_resumos, cancelar: token);
            if (salvo is null) return;
            if (token.IsCancellationRequested) { salvo.Limpar(); return; }
            App.UltimoResumoPdf = salvo;
            Ir("base/resumo-pdf");
        });
    }

    public override void Dispose()
    {
        _exportacao.Cancel();
        _exportacao.Dispose();
        _digitando?.Cancel();
        base.Dispose();
    }
    private FiltroChip? _aberto;
    private string _pesquisa = "";
    private readonly Dictionary<string, string> _pesquisas = [];
    private IReadOnlyList<(string Valor, string Chave)> _opcoes = [];
    private const int MaximoDeOpcoes = 100;
    private CancellationTokenSource? _digitando;

    private string Subtitulo => App.Base.UltimaLeitura is { } u
        ? $"{Formato.Plural(App.Base.TotalDeObras, "obra", "obras")} · atualizada {Formato.Quando(u, App.Agora())}"
        : "Base ainda não lida";

    protected override void Iniciar() => Carregar();

    protected override void BaseMudou() => Carregar();

    private void Carregar()
    {
        if (!App.Base.TemDados)
        {
            (_obras, _total, _resumos) = ([], 0, []);
            return;
        }

        (_obras, _total) = App.Base.Buscar(App.FiltroBase, _limite);
        _resumos = App.Base.ResumosDosContratos(App.FiltroBase.Contrato);
    }

    private async Task Digitou(ChangeEventArgs e)
    {
        string texto = e.Value?.ToString() ?? "";
        _digitando?.Cancel();
        var cancelar = _digitando = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, cancelar.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        App.FiltroBase = App.FiltroBase with { Texto = string.IsNullOrWhiteSpace(texto) ? null : texto.Trim() };
        _limite = Pagina;
        Carregar();
    }

    private static string ResumoFiltro(FiltroChip filtro, IReadOnlyList<string> valores) => valores.Count switch
    {
        0 => filtro.Nome,
        1 => valores[0],
        _ => $"{valores[0]} + {valores.Count - 1}",
    };

    private void Abrir(string id)
    {
        _aberto = Filtros.First(x => x.Id == id);
        _pesquisa = _pesquisas.GetValueOrDefault(id, "");
        RecarregarOpcoes(_aberto);
    }

    private void FecharFiltro()
    {
        if (_aberto is { } filtro) _pesquisas[filtro.Id] = _pesquisa;
        _aberto = null;
    }

    // As marcadas ficam no topo (sempre visiveis); o texto para pesquisar e preparado uma vez so.
    private void RecarregarOpcoes(FiltroChip filtro)
    {
        var opcoes = App.Base.Opcoes(App.FiltroBase);
        _detalhes = filtro.Id == "contrato"
            ? opcoes.ContratosDetalhados.Concat(App.Base.Repositorio.OpcoesGerais().ContratosDetalhados
                .Where(o => filtro.Valor(App.FiltroBase).Contains(o.Contrato, StringComparer.OrdinalIgnoreCase)))
                .DistinctBy(o => o.Contrato, StringComparer.OrdinalIgnoreCase).ToDictionary(o => o.Contrato, StringComparer.OrdinalIgnoreCase)
            : new(StringComparer.OrdinalIgnoreCase);
        _opcoes = filtro.Opcoes(opcoes).Union(filtro.Valor(App.FiltroBase), StringComparer.OrdinalIgnoreCase)
            .Select(o => (o, Normalizacao.Busca(_detalhes.TryGetValue(o, out var d) ? d.Titulo + " " + d.Detalhe : o))).ToList();
    }

    private void Pesquisar(ChangeEventArgs e) => _pesquisa = e.Value?.ToString() ?? "";

    private List<string> OpcoesVisiveis()
    {
        string busca = Normalizacao.Busca(_pesquisa);
        return busca.Length == 0 ? [.. _opcoes.Select(o => o.Valor)] : [.. _opcoes.Where(o => o.Chave.Contains(busca, StringComparison.Ordinal)).Select(o => o.Valor)];
    }

    private void Escolher(FiltroChip filtro, string valor)
    {
        var atuais = filtro.Valor(App.FiltroBase);
        var outros = atuais.Where(v => !string.Equals(v, valor, StringComparison.OrdinalIgnoreCase)).ToList();
        if (outros.Count == atuais.Count) outros.Add(valor);
        App.FiltroBase = filtro.Definir(App.FiltroBase, outros);
        _limite = Pagina;
        Carregar();
        // As opcoes deste filtro nao dependem dele mesmo: a lista fica parada (nada pula de lugar ao marcar).
    }

    private void Limpar(string id)
    {
        _pesquisas.Remove(id);
        App.FiltroBase = Filtros.First(x => x.Id == id).Definir(App.FiltroBase, []);
        _limite = Pagina;
        Carregar();
    }

    private void Mais()
    {
        _limite += Pagina;
        Carregar();
    }

    private Task Reler() => App.Base.AtualizarAsync(forcar: true);
}
