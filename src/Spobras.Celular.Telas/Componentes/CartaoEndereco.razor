@using Spobras.Core.Relatorio
@implements IDisposable
@inject AppCelular App
@* Endereco das fotos (carimbo). O GPS e opcional e comeca desligado: so ao ligar o app pede a permissao. *@
<div class="painel cartao-endereco" aria-live="polite">
    <h2>Endereço nas fotos</h2>
    @if (Chave is null)
    {
        <p class="texto2">Escolha a unidade educacional acima: o endereço fica guardado para cada escola.</p>
    }
    else
    {
        <button class="opcao gps-opcao @(App.Endereco.UsarGps ? "on" : "")" @onclick="AlternarGps" aria-pressed="@(App.Endereco.UsarGps ? "true" : "false")">
            <span>Usar o endereço pelo GPS<small>@(App.Endereco.UsarGps ? "A localização é usada uma vez por relatório" : "Desligado: o app não usa a localização. Dá para digitar o endereço")</small></span><span class="marca"></span>
        </button>

        @if (_editando)
        {
            <CampoTexto Rotulo="Endereço" Valor="@D.Endereco" Dica="Ex.: Rua Exemplo, 123 – Vila Exemplo" Maximo="120" AoMudar="Salvar" />
            <div class="linha-btns"><button class="btn linha pequeno" @onclick="() => _editando = false">Pronto</button></div>
        }
        else
        {
            @if (App.Endereco.Distancia is { } longe)
            {
                <Aviso Tipo="atencao"><span>Você está a @EnderecoDasFotos.TextoDistancia(longe) do endereço guardado desta escola. Atualizar?</span></Aviso>
                <div class="linha-btns" style="margin-bottom:10px">
                    <button class="btn primario pequeno" @onclick="() => App.Endereco.AtualizarPeloAvisoAsync()">Atualizar</button>
                    <button class="btn linha pequeno" @onclick="App.Endereco.ManterEndereco">Manter</button>
                </div>
            }
            @if (App.Endereco.Lendo)
            {
                <p class="lendo-endereco"><span class="girando-escuro" aria-hidden="true"></span>@(App.Endereco.Precisao is { } p ? $"Procurando a posição… precisão {p:0} m" : "Procurando a posição…")</p>
            }
            else if (D.Endereco.Length > 0)
            {
                <p class="endereco-atual">@D.Endereco</p>
                <p class="mini" style="margin:0 0 10px">@Origem</p>
                @if (App.Endereco.Conferir)
                {
                    <p class="mini aviso-precisao">A posição veio com margem de @(D.Ponto!.Precisao.ToString("0")) m: o endereço pode estar errado. Confira e, se precisar, toque em Editar.</p>
                }
            }
            else if (App.Endereco.UsarGps && MesmoNome is { } outro)
            {
                <p class="texto2">Já existe um endereço guardado para uma unidade com este nome@(outro.Contrato.Length > 0 ? $" (contrato {outro.Contrato})" : ""): <b>@outro.Endereco</b>. É o mesmo local?</p>
                <div class="linha-btns" style="margin-bottom:8px">
                    <button class="btn primario pequeno" @onclick="() => App.Endereco.UsarMesmoNome(outro)">Usar este</button>
                    <button class="btn linha pequeno" @onclick="() => App.Endereco.LerAsync(atualizar: true)">Ler pelo GPS</button>
                </div>
            }
            else if (App.Endereco.UsarGps)
            {
                <p class="texto2">@Situacao</p>
            }
            @if (App.Endereco.UsarGps && !App.Endereco.Lendo)
            {
                @if (App.Endereco.Aproximada)
                {
                    <p class="mini aviso-precisao">O celular liberou só a localização aproximada: o endereço pode sair errado. Toque em “Permitir localização precisa” e escolha “Precisa”.</p>
                }
                @if (App.Endereco.SemRede && D.Endereco.Length == 0)
                {
                    <p class="mini aviso-precisao">A localização por Wi-Fi está desligada no celular: dentro de prédios fica difícil achar a posição. Ligue “Precisão da localização” nas configurações de localização.</p>
                }
            }
            <div class="linha-btns">
                @if (App.Endereco.UsarGps && !App.Endereco.Lendo)
                {
                    @switch (App.Endereco.Estado)
                    {
                        case EstadoEndereco.LocalizacaoDesligada:
                            <button class="btn primario pequeno" @onclick="LigarLocalizacao">Ligar a localização</button>
                            <button class="btn linha pequeno" @onclick="() => App.Endereco.LerAsync(atualizar: true)">Tentar de novo</button>
                            break;
                        case EstadoEndereco.SemPermissao:
                            <button class="btn primario pequeno" @onclick="() => App.Endereco.LerAsync(atualizar: true)">Permitir e ler</button>
                            break;
                        default:
                            <button class="btn linha pequeno" @onclick="Ler">@TextoLer</button>
                            break;
                    }
                    @if (App.Endereco.Aproximada)
                    {
                        <button class="btn linha pequeno" @onclick="() => App.Endereco.LerAsync(atualizar: true)">Permitir localização precisa</button>
                    }
                }
                @if (!App.Endereco.Lendo)
                {
                    <button class="btn linha pequeno" @onclick="() => _editando = true">@(D.Endereco.Length > 0 ? "Editar" : "Digitar")</button>
                }
            </div>
        }
    }
</div>

<Folha Aberta="_perguntar" Titulo="Usar o endereço pelo GPS?" AoFechar="() => _perguntar = false">
    <p class="texto2" style="margin:0 0 12px">Para pôr o endereço da escola nas fotos, o app usa a localização do celular só quando você pedir ou ao abrir a câmera, uma vez por relatório. Nada fica rodando depois. O Android vai pedir a permissão em seguida.</p>
    <button class="btn primario" style="margin-bottom:8px" @onclick="Ligar">Continuar</button>
    <button class="btn linha" @onclick="() => _perguntar = false">Agora não</button>
</Folha>

@code {
    /// <summary>Chave da escola atual (nome + contrato): mudou, o endereco e conferido de novo.</summary>
    [Parameter] public string? Chave { get; set; }

    private bool _editando, _perguntar;

    private DadosRascunho D => App.Rascunho.Dados;

    private EnderecoGuardado? MesmoNome => App.Endereco.MesmoNome.FirstOrDefault();

    protected override void OnInitialized() => App.Endereco.Mudou += Redesenhar;

    protected override void OnParametersSet() => App.Endereco.Sincronizar();

    public void Dispose() => App.Endereco.Mudou -= Redesenhar;

    private void Redesenhar() => _ = InvokeAsync(StateHasChanged);

    private void Salvar(string texto) => App.Endereco.Editar(texto);

    private void AlternarGps()
    {
        if (App.Endereco.UsarGps)
        {
            App.DesligarEnderecoPeloGps();
            StateHasChanged();
        }
        else
        {
            _perguntar = true; // explica antes de o Android pedir a permissao
        }
    }

    private async Task Ligar()
    {
        _perguntar = false;
        await App.LigarEnderecoPeloGpsAsync();
    }

    private async Task LigarLocalizacao()
    {
        await App.Endereco.LigarLocalizacaoAsync();
    }

    private Task Ler() =>
        App.Endereco.Estado == EstadoEndereco.SemInternet && D.Ponto is not null ? App.Endereco.TentarDeNovoAsync() : App.Endereco.LerAsync(atualizar: true);

    private string TextoLer => App.Endereco.Estado switch
    {
        EstadoEndereco.SemSinal or EstadoEndereco.SemInternet => "Tentar de novo",
        _ => D.Endereco.Length > 0 ? "Ler de novo" : "Ler agora",
    };

    private string Situacao => App.Endereco.Estado switch
    {
        EstadoEndereco.SemPermissao => "Sem permissão de localização. Toque em “Permitir e ler”, ou digite o endereço.",
        EstadoEndereco.LocalizacaoDesligada => "A localização do celular está desligada. Ligue e depois toque em “Ler agora”.",
        EstadoEndereco.SemSinal => "Nenhuma posição encontrada. Confira se a localização do celular está ligada, tente perto de uma janela ou na entrada da escola, ou digite.",
        EstadoEndereco.SemInternet => "Sem internet: a posição foi guardada e o endereço é buscado quando houver sinal.",
        EstadoEndereco.SemServico => "O celular não transformou a posição em endereço. Tente de novo ou digite.",
        _ => "O endereço é lido ao abrir a câmera. Também dá para ler agora ou digitar.",
    };

    private string Origem
    {
        get
        {
            var guardado = App.Enderecos.Buscar(Chave);
            if (guardado is { Digitado: true } && guardado.Endereco == D.Endereco) return "Digitado · guardado para esta escola";
            if (D.Ponto is { } p)
            {
                string quando = p.LidoEm.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                return $"Lido pela localização em {quando} · precisão {p.Precisao:0} m";
            }

            return "Guardado para esta escola";
        }
    }
}
