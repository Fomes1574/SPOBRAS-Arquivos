@using Spobras.Core.Relatorio
@using System.Globalization
@* Foto com o carimbo por cima, na conta da gravacao. No editor, o carimbo pode ser arrastado (carimbo.js). *@
<svg class="previa-carimbo @(Arrastavel ? "arrastavel" : "")" @ref="Elemento" viewBox="0 0 @Largura @Altura" data-largura="@Largura" data-altura="@Altura"
     role="img" aria-label="@Descricao" style="aspect-ratio:@N(Largura / (double)Math.Max(1, Altura))">
    <rect x="0" y="0" width="@Largura" height="@Altura" fill="#2b2b2e" />
    @if (Url is { Length: > 0 })
    {
        <image href="@Url" x="0" y="0" width="@Largura" height="@Altura" preserveAspectRatio="none" />
    }
    @if (Geometria is { } g)
    {
        <g class="carimbo" @key="Versao" data-x="@N(g.X)" data-y="@N(g.Y)" data-w="@N(g.Largura)" data-h="@N(g.Altura)">
            @((MarkupString)SvgCarimbo.Markup(g))
            @if (Arrastavel)
            {
                <rect x="@N(g.X)" y="@N(g.Y)" width="@N(g.Largura)" height="@N(g.Altura)" rx="@N(g.Raio)" fill="none" stroke="#fff" stroke-width="@N(Math.Max(2, Largura / 300.0))" stroke-dasharray="@N(Largura / 80.0) @N(Largura / 120.0)" />
            }
        </g>
    }
</svg>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public int Largura { get; set; } = 4;
    [Parameter] public int Altura { get; set; } = 3;
    [Parameter] public CarimboFoto? Carimbo { get; set; }
    [Parameter] public bool Arrastavel { get; set; }

    /// <summary>Muda a cada ajuste: o grupo do carimbo e refeito sem o deslocamento do gesto anterior.</summary>
    [Parameter] public int Versao { get; set; }

    public ElementReference Elemento { get; private set; }

    private GeometriaCarimbo? Geometria => GeometriaCarimbo.Calcular(Largura, Altura, Carimbo);

    private string Descricao => Carimbo is null ? "Foto sem carimbo"
        : "Foto com carimbo: " + string.Join(", ", new[] { Carimbo.Escola, Carimbo.Endereco, Carimbo.DataHora }.Where(t => t.Length > 0));

    private static string N(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);
}
