@* Campo do formulario que grava no rascunho a cada mudanca. *@
<div class="campo" style="@Estilo">
    <label for="@_id">@Rotulo</label>
    <div class="entrada-campo @(PermiteApagar ? "com-borracha" : "")">
        @if (Linhas > 1)
        {
            <textarea id="@_id" rows="@Linhas" placeholder="@Dica" value="@Valor" @onchange="Mudou"></textarea>
        }
        else
        {
            <input id="@_id" type="text" inputmode="@(Data ? "numeric" : "text")" placeholder="@Dica" value="@Valor" class="@(Invalido ? "erro" : "")"
                   autocomplete="off" @onchange="Mudou" @oninput="Digitando" @onblur="AoPerderFoco" />
        }
        @if (PermiteApagar && Valor.Length > 0)
        {
            <button type="button" class="apagar-campo" aria-label="@($"Apagar {Rotulo}")" @onpointerdown:preventDefault @onclick="Apagar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 14l8-9a2 2 0 0 1 3-.2l6 5a2 2 0 0 1 .2 3L14 20H8l-5-4a1.5 1.5 0 0 1 0-2zM7 10l9 8M14 20h8"/>
                </svg>
            </button>
        }
    </div>
    @if (Invalido)
    {
        <div class="ajuda erro">Data inválida. Use dd/mm/aaaa.</div>
    }
</div>

@code {
    private readonly string _id = "c" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired] public string Rotulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string? Dica { get; set; }
    [Parameter] public int Linhas { get; set; } = 1;
    [Parameter] public bool Data { get; set; }
    [Parameter] public string? Estilo { get; set; }
    [Parameter] public EventCallback<string> AoMudar { get; set; }
    [Parameter] public EventCallback<string> AoDigitar { get; set; }

    [Parameter] public EventCallback AoPerderFoco { get; set; }

    [Parameter] public bool PermiteApagar { get; set; }
    [Parameter] public EventCallback AoApagar { get; set; }

    private async Task Apagar()
    {
        Valor = "";
        if (AoApagar.HasDelegate) await AoApagar.InvokeAsync();
        else await AoMudar.InvokeAsync("");
    }

    private bool Invalido => Data && Formato.LerData(Valor).Invalida;

    private async Task Mudou(ChangeEventArgs e)
    {
        string v = e.Value?.ToString() ?? "";
        if (Data && v.Trim().Length > 0)
        {
            v = Spobras.Core.MascaraData.Formatar(v);
        }

        Valor = v;
        await AoMudar.InvokeAsync(v);
    }

    private Task Digitando(ChangeEventArgs e) => AoDigitar.InvokeAsync(e.Value?.ToString() ?? "");
}
