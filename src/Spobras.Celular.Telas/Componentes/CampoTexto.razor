@* Campo do formulario que grava no rascunho a cada mudanca. Sair da tela no meio da digitacao (voltar, menu)
   tambem grava: nada do que foi digitado se perde. *@
@implements IDisposable
<div class="campo" style="@Estilo">
    @if (Maximo > 0)
    {
        <div class="rotulo-campo"><label for="@_id">@Rotulo</label><span class="contador @(_tamanho >= Maximo * 9 / 10 ? "perto" : "")" aria-live="polite">@_tamanho de @Maximo</span></div>
    }
    else
    {
        <label for="@_id">@Rotulo</label>
    }
    @if (Ajuda is not null)
    {
        <div class="ajuda-campo">@Ajuda</div>
    }
    <div class="entrada-campo @(PermiteApagar ? "com-borracha" : "")">
        @if (Linhas > 1)
        {
            <textarea id="@_id" rows="@Linhas" placeholder="@Dica" value="@Valor" maxlength="@(Maximo > 0 ? Maximo : null)" @onchange="Mudou" @oninput="Digitando"></textarea>
        }
        else
        {
            <input id="@_id" type="text" inputmode="@(Data ? "numeric" : "text")" placeholder="@Dica" value="@Valor" class="@(Invalido ? "erro" : "")"
                   autocomplete="off" maxlength="@(Maximo > 0 ? Maximo : null)" @onchange="Mudou" @oninput="Digitando" @onblur="AoPerderFoco" />
        }
        @if (PermiteApagar && Valor.Length > 0)
        {
            <button type="button" class="apagar-campo" aria-label="@($"Apagar {Rotulo}")" @onpointerdown:preventDefault @onclick="Apagar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 14l8-9a2 2 0 0 1 3-.2l6 5a2 2 0 0 1 .2 3L14 20H8l-5-4a1.5 1.5 0 0 1 0-2zM7 10l9 8M14 20h8"/>
                </svg>
            </button>
        }
    </div>
    @if (Invalido)
    {
        <div class="ajuda erro">Data inválida. Use dd/mm/aaaa.</div>
    }
</div>

@code {
    private readonly string _id = "c" + Guid.NewGuid().ToString("N")[..8];

    [Parameter, EditorRequired] public string Rotulo { get; set; } = "";
    [Parameter] public string Valor { get; set; } = "";
    [Parameter] public string? Dica { get; set; }

    /// <summary>Explicacao curta embaixo do nome do campo (ex.: onde o texto sai no relatorio).</summary>
    [Parameter] public string? Ajuda { get; set; }
    [Parameter] public int Linhas { get; set; } = 1;
    [Parameter] public bool Data { get; set; }
    [Parameter] public string? Estilo { get; set; }
    [Parameter] public EventCallback<string> AoMudar { get; set; }
    [Parameter] public EventCallback<string> AoDigitar { get; set; }

    [Parameter] public EventCallback AoPerderFoco { get; set; }

    [Parameter] public bool PermiteApagar { get; set; }

    /// <summary>Limite de caracteres (0 = sem limite). Mostra o contador enquanto digita.</summary>
    [Parameter] public int Maximo { get; set; }

    private int _tamanho;

    private string? _ultimoValor;

    // So muda o contador quando o valor guardado muda (outro redesenho da tela nao apaga o que esta sendo digitado).
    protected override void OnParametersSet()
    {
        if (Valor != _ultimoValor)
        {
            _ultimoValor = Valor;
            _tamanho = Valor.Length;
        }
    }
    [Parameter] public EventCallback AoApagar { get; set; }

    private async Task Apagar()
    {
        Valor = "";
        if (AoApagar.HasDelegate) await AoApagar.InvokeAsync();
        else await AoMudar.InvokeAsync("");
    }

    private bool Invalido => Data && Formato.LerData(Valor).Invalida;

    private async Task Mudou(ChangeEventArgs e)
    {
        string v = e.Value?.ToString() ?? "";
        if (Data && v.Trim().Length > 0)
        {
            v = Spobras.Core.MascaraData.Formatar(v);
        }

        if (Maximo > 0 && v.Length > Maximo)
        {
            v = v[..Maximo]; // colado maior que o limite
        }

        _pendente = null;
        _relogio?.Cancel();
        Valor = v;
        _tamanho = v.Length;
        await AoMudar.InvokeAsync(v);
    }

    /// <summary>Grava tambem enquanto digita (meio segundo depois da ultima tecla). So para campos sem efeito colateral.</summary>
    [Parameter] public bool GravarAoDigitar { get; set; }

    private string? _pendente;
    private CancellationTokenSource? _relogio;

    private void Esperar(string v)
    {
        _pendente = v == Valor ? null : v;
        _relogio?.Cancel();
        if (_pendente is null || !GravarAoDigitar) return;
        var este = _relogio = new CancellationTokenSource();
        _ = Task.Delay(500, este.Token).ContinueWith(t =>
        {
            if (!t.IsCanceled && _pendente is { } texto) _ = InvokeAsync(() => Mudou(new ChangeEventArgs { Value = texto }));
        }, TaskScheduler.Default);
    }

    public void Dispose()
    {
        _relogio?.Cancel();
        if (_pendente is { } texto)
        {
            _pendente = null;
            _ = Mudou(new ChangeEventArgs { Value = texto }); // saiu sem confirmar o campo: grava o que foi digitado
        }
    }

    private Task Digitando(ChangeEventArgs e)
    {
        string v = e.Value?.ToString() ?? "";
        _tamanho = v.Length;
        Esperar(v);
        return AoDigitar.InvokeAsync(v);
    }
}
