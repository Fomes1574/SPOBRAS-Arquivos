@using Spobras.Core.Relatorio
@using System.Globalization
@* Miniatura fiel da pagina: as mesmas pecas (DesenhoRelatorio) que o PDF desenha, em SVG na escala da tela. *@
<div class="previa-pagina">
    <svg viewBox="0 0 @Num(GradeRelatorio.LarguraDaFolha) @Num(GradeRelatorio.AlturaDaFolha)" role="img" aria-label="@($"Página {Pagina.Numero} de {Plano.Paginas.Count}")">
        @foreach (var elemento in DesenhoRelatorio.Pagina(Plano, Pagina, Logo is not null))
        {
            switch (elemento)
            {
                case RetanguloDesenho r:
                    <rect x="@Num(r.Area.X)" y="@Num(r.Area.Y)" width="@Num(r.Area.Largura)" height="@Num(r.Area.Altura)"
                          fill="@(r.Fundo is null ? "none" : "#" + r.Fundo)" stroke="@(r.Borda is null ? "none" : "#" + r.Borda)" stroke-width="@Num(r.Espessura)" />
                    break;
                case LinhaDesenho l:
                    <line x1="@Num(l.X1)" y1="@Num(l.Y1)" x2="@Num(l.X2)" y2="@Num(l.Y2)" stroke="#@l.Cor" stroke-width="@Num(l.Espessura)" />
                    break;
                case ImagemDesenho { Foto: { } foto } im:
                    <image href="@Foto(foto)" x="@Num(im.Area.X)" y="@Num(im.Area.Y)" width="@Num(im.Area.Largura)" height="@Num(im.Area.Altura)" preserveAspectRatio="xMidYMid meet" />
                    @if (foto.Carimbo is not null)
                    {
                        @((MarkupString)SvgCarimbo.NaArea(foto, im.Area))
                    }
                    break;
                case ImagemDesenho im when Logo is not null:
                    <image href="@Logo" x="@Num(im.Area.X)" y="@Num(im.Area.Y)" width="@Num(im.Area.Largura)" height="@Num(im.Area.Altura)" preserveAspectRatio="xMidYMid meet" />
                    break;
                case TextoDesenho t:
                    double topo = t.CentroNaAltura ? t.Area.Y + (t.Area.Altura - t.Linhas.Count * t.AlturaDaLinha) / 2 : t.Area.Y;
                    double baseDaLetra = (t.AlturaDaLinha - t.Tamanho) / 2 + t.Tamanho * 0.8;
                    for (int i = 0; i < t.Linhas.Count; i++)
                    {
                        bool justificar = t.Alinhamento == Alinhamento.Justificado && i < t.Linhas.Count - 1 && t.Linhas[i].Contains(' ');
                        double x = t.Alinhamento == Alinhamento.Centro ? t.Area.X + t.Area.Largura / 2 : t.Area.X;
                        @((MarkupString)Linha(t, i, x, topo + i * t.AlturaDaLinha + baseDaLetra, justificar))
                    }
                    break;
            }
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public PlanoRelatorio Plano { get; set; } = default!;
    [Parameter, EditorRequired] public PaginaRelatorio Pagina { get; set; } = default!;
    [Parameter, EditorRequired] public Func<FotoRelatorio, string> Foto { get; set; } = default!;
    [Parameter] public string? Logo { get; set; }

    private static string Num(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    // O Razor reserva a etiqueta "text": a linha do SVG e montada como texto (sempre escapado).
    private static string Linha(TextoDesenho t, int i, double x, double y, bool justificar) =>
        $"<text x=\"{Num(x)}\" y=\"{Num(y)}\" font-size=\"{Num(t.Tamanho)}\" font-weight=\"{(t.Negrito ? 700 : 400)}\" fill=\"#{t.Cor}\" " +
        $"text-anchor=\"{(t.Alinhamento == Alinhamento.Centro ? "middle" : "start")}\"" +
        (justificar ? $" textLength=\"{Num(t.Area.Largura)}\" lengthAdjust=\"spacing\"" : "") +
        $">{System.Net.WebUtility.HtmlEncode(t.Linhas[i])}</text>";
}
