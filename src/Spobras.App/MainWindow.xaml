<Window x:Class="Spobras.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Spobras.App.ViewModels"
        xmlns:t="clr-namespace:Spobras.App.Telas"
        Title="Arquivos SPOBRAS" Width="1360" Height="900" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Preto}"
        FontFamily="{StaticResource Fonte}" FontSize="15" UseLayoutRounding="True"
        SizeChanged="AoMudarTamanho">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:InicioVm}"><t:InicioTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrganizarVm}"><t:OrganizarTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RenomearVm}"><t:RenomearTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompactarVm}"><t:CompactarTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RelatorioVm}"><t:RelatorioTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PdfVm}"><t:PdfTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BaseVm}"><t:BaseTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FontesVm}"><t:FontesTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoricoVm}"><t:HistoricoTela /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfiguracoesVm}"><t:ConfiguracoesTela /></DataTemplate>

        <!-- Item do menu lateral: vermelho quando e a pagina atual -->
        <Style x:Key="ItemMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MenuTexto}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="Transparent" CornerRadius="8" Padding="12,0" Margin="12,2">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource MenuRealce}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource Vermelho}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border x:Name="Menu" Background="{StaticResource Preto}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,24,24,16">
                    <Image x:Name="Logo" MaxHeight="48" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed" />
                    <TextBlock Text="Arquivos SPOBRAS" Foreground="White" FontSize="18" FontWeight="Bold" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                    <Button Click="AoClicarNovidades" Cursor="Hand" Margin="12,0,12,10" FocusVisualStyle="{StaticResource FocoVisivel}"
                            AutomationProperties.Name="Estado do modo automático">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource MenuRealce}" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TextoAutomatico}" Foreground="White" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetalheAutomatico}" Foreground="{StaticResource MenuSecundario}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ItemHistorico" Style="{StaticResource ItemMenu}" Content="Histórico e tarefas"
                            Command="{Binding NavegarCommand}" CommandParameter="historico" Click="AoNavegar" />
                    <Button x:Name="ItemConfiguracoes" Style="{StaticResource ItemMenu}" Content="Configurações"
                            Command="{Binding NavegarCommand}" CommandParameter="configuracoes" Click="AoNavegar" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="ItemInicio" Style="{StaticResource ItemMenu}" Content="Início"
                                Command="{Binding NavegarCommand}" CommandParameter="inicio" Click="AoNavegar" />
                        <ItemsControl x:Name="ItensModulos" ItemsSource="{Binding Modulos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Item" Style="{StaticResource ItemMenu}" Content="{Binding Titulo}"
                                            Command="{Binding DataContext.NavegarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" Click="AoNavegar" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource Iguais}">
                                                    <Binding Path="Id" />
                                                    <Binding Path="DataContext.IdAtual" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Item" Property="Tag" Value="ativo" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conteudo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="BotaoMenu" Grid.Row="0" Style="{StaticResource BotaoSecundario}" Content="☰  Menu" HorizontalAlignment="Left"
                    Margin="16,12,0,0" Visibility="Collapsed" Click="AoClicarMenu" />

            <ContentControl Grid.Row="1" Content="{Binding PaginaAtual}" Focusable="False" />

            <!-- Tarefa em andamento -->
            <Border Grid.Row="2" Background="{StaticResource Preto}" Padding="20,10"
                    Visibility="{Binding TemTarefaAtiva, Converter={StaticResource Visivel}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Cancelar" MinHeight="36"
                            Command="{Binding CancelarTarefaAtivaCommand}" />
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="140" Height="6" Margin="16,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="Em andamento:" FontWeight="SemiBold" /> <Run Text="{Binding TarefaAtiva, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
