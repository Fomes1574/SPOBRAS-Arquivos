<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores da especificacao 7.1 -->
    <SolidColorBrush x:Key="Preto" Color="#231F20" />
    <SolidColorBrush x:Key="Fundo" Color="#F3F3F1" />
    <SolidColorBrush x:Key="Branco" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Borda" Color="#D6D6D2" />
    <SolidColorBrush x:Key="BordaClara" Color="#E6E6E3" />
    <SolidColorBrush x:Key="BordaCampo" Color="#A9A9A4" />
    <SolidColorBrush x:Key="Vermelho" Color="#C8102E" />
    <SolidColorBrush x:Key="VermelhoEscuro" Color="#A50D26" />
    <SolidColorBrush x:Key="Azul" Color="#1F5FA8" />
    <SolidColorBrush x:Key="AzulClaro" Color="#E8F0FA" />
    <SolidColorBrush x:Key="Laranja" Color="#8A4300" />
    <SolidColorBrush x:Key="LaranjaClaro" Color="#FBF0E4" />
    <SolidColorBrush x:Key="VermelhoClaro" Color="#FBE9EC" />
    <SolidColorBrush x:Key="Secundario" Color="#5A5A5F" />
    <SolidColorBrush x:Key="MenuTexto" Color="#E9E9E7" />
    <SolidColorBrush x:Key="MenuSecundario" Color="#B5B5B1" />
    <SolidColorBrush x:Key="MenuRealce" Color="#3A3536" />

    <FontFamily x:Key="Fonte">Inter, Segoe UI</FontFamily>

    <BooleanToVisibilityConverter x:Key="Visivel" />

    <!-- Textos -->
    <Style x:Key="TituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
    </Style>
    <Style x:Key="TituloPainel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
    </Style>
    <Style x:Key="Texto2" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Secundario}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Forte" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Painel branco com borda -->
    <Style x:Key="Painel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Branco}" />
        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Foco de teclado bem visivel -->
    <Style x:Key="FocoVisivel">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="10" RadiusY="10" Stroke="{StaticResource Azul}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botoes: 44 de altura, cantos 8 -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Vermelho}" />
        <Setter Property="BorderBrush" Value="{StaticResource Vermelho}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="24,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource VermelhoEscuro}" />
                <Setter Property="BorderBrush" Value="{StaticResource VermelhoEscuro}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Branco}" />
        <Setter Property="BorderBrush" Value="{StaticResource Preto}" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Fundo}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoEscuro" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource Preto}" />
        <Setter Property="BorderBrush" Value="{StaticResource Preto}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Acao pequena dentro de uma linha (remover, subir, descer) -->
    <Style x:Key="BotaoLinha" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{StaticResource Branco}" />
        <Setter Property="BorderBrush" Value="{StaticResource Borda}" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Preto}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Link em texto -->
    <Style x:Key="BotaoLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Azul}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos de texto -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Branco}" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Setter Property="BorderBrush" Value="{StaticResource BordaCampo}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borda" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Azul}" />
                            <Setter TargetName="Borda" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borda" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Lista sem realce de selecao: cada linha e so conteudo com uma divisoria -->
    <Style x:Key="LinhaSimples" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,10">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ListaSimples" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LinhaSimples}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

    <!-- Lista com selecao (historico) -->
    <Style x:Key="LinhaSelecionavel" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="10" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Fundo}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource AzulClaro}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opcao em forma de cartao (escolha da ferramenta, etapas) -->
    <Style x:Key="CartaoOpcao" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Preto}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" Background="{StaticResource Branco}" BorderBrush="{StaticResource Borda}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <DockPanel>
                            <Ellipse x:Name="Marca" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top"
                                     Stroke="{StaticResource Secundario}" StrokeThickness="2" Fill="Transparent" />
                            <ContentPresenter RecognizesAccessKey="False" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Preto}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Vermelho}" />
                            <Setter TargetName="B" Property="BorderThickness" Value="2" />
                            <Setter TargetName="B" Property="Padding" Value="15,11" />
                            <Setter TargetName="Marca" Property="Fill" Value="{StaticResource Vermelho}" />
                            <Setter TargetName="Marca" Property="Stroke" Value="{StaticResource Vermelho}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mensagens: texto + rotulo, nunca so cor -->
    <DataTemplate x:Key="AvisoModelo">
        <Border x:Name="Caixa" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Background="{StaticResource AzulClaro}">
            <TextBlock TextWrapping="Wrap">
                <Run x:Name="Rot" Text="{Binding Rotulo, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Azul}" /><Run Text=":  " FontWeight="Bold" /><Run Text="{Binding Texto, Mode=OneWay}" />
            </TextBlock>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Conferir}" Value="True">
                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource LaranjaClaro}" />
                <Setter TargetName="Rot" Property="Foreground" Value="{StaticResource Laranja}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Impede}" Value="True">
                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource VermelhoClaro}" />
                <Setter TargetName="Rot" Property="Foreground" Value="{StaticResource Vermelho}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
