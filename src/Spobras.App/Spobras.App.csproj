<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ArquivosSPOBRAS</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Recursos/app.ico</ApplicationIcon>
    <RootNamespace>Spobras.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../Spobras.Core/Spobras.Core.csproj" />
    <ProjectReference Include="../Spobras.Dados/Spobras.Dados.csproj" />
    <ProjectReference Include="../Spobras.Documentos/Spobras.Documentos.csproj" />
    <ProjectReference Include="../Spobras.Excel/Spobras.Excel.csproj" />
  </ItemGroup>
</Project>
