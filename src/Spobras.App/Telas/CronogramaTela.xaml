<UserControl x:Class="Spobras.App.Telas.CronogramaTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Spobras.App.Telas">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
            <RowDefinition Height="*" MinHeight="146" MaxHeight="270" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cronograma padrão" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Você informa as obras; o app calcula a remuneração, os meses, o total de cada ano e a tabela por dotação, e gera a planilha pronta."
                       Style="{StaticResource Texto2}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Obras -->
        <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0,16,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Limpar tudo" Margin="8,0,0,0" MinHeight="44" Command="{Binding LimparCommand}"
                            Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSe}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Importar planilha" Margin="8,0,0,0" MinHeight="44" Command="{Binding ImportarPlanilhaCommand}"
                            ToolTip="Lê as obras de uma planilha sua, achando as colunas pelos títulos" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Colar do Excel" Margin="8,0,0,0" Command="{Binding ColarDoExcelCommand}"
                            ToolTip="Copie no Excel as colunas Portaria, Lote, Dotação, Nome da Obra, Breve escopo, Valor, Início e Fim, e clique aqui" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar contrato" Margin="8,0,0,0" Command="{Binding AlternarBuscaContratoCommand}"
                            ToolTip="Traz todas as escolas de um contrato, ou de um lote em licitação ou a licitar" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar obra" Margin="8,0,0,0" Command="{Binding NovaLinhaCommand}" />
                    <TextBlock Text="Obras do cronograma" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Busca "Adicionar contrato": contratos em andamento e grupos sem contrato (base + lote + modalidade) -->
                <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" Background="{StaticResource AzulClaro}"
                        Visibility="{Binding BuscandoContrato, Converter={StaticResource Visivel}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Fechar" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding AlternarBuscaContratoCommand}" />
                            <TextBlock Text="Digite o contrato ou o lote (ex.: 044/EX/2026, 035 ou lote 64)" Style="{StaticResource Rotulo}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox x:Name="CampoBuscaContrato" Text="{Binding PesquisaContrato, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,4,0,0"
                                 AutomationProperties.Name="Pesquisar contrato ou lote" />
                        <TextBlock Text="{Binding AvisoBusca}" Style="{StaticResource Texto2}" FontSize="13" Margin="2,6,0,0"
                                   Visibility="{Binding AvisoBusca, Converter={StaticResource VisivelSe}}" />
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Focusable="False"
                                      Visibility="{Binding TemItensBusca, Converter={StaticResource Visivel}}">
                            <ItemsControl ItemsSource="{Binding ItensBusca}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotaoLink}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,2" Padding="0"
                                                Command="{Binding DataContext.AdicionarItemBuscaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Titulo}" ToolTip="Clique para trazer todas as escolas">
                                            <Border Background="{StaticResource Branco}" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BordaClara}" BorderThickness="1">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="96">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AzulClaro}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EhLicitacao}" Value="True"><Setter Property="Background" Value="{StaticResource LaranjaClaro}" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding EhALicitar}" Value="True"><Setter Property="Background" Value="{StaticResource Fundo}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Selo}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Preto}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Titulo}" FontWeight="Bold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource Secundario}" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <Grid MinHeight="80">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSeNao}}">
                                <TextBlock Text="Nenhuma obra ainda" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Texto2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="560"
                                           Text="Adicione uma obra, traga as escolas de um contrato com “Adicionar contrato”, cole as linhas do Excel ou use “Usar no cronograma” na Base de dados." />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Linhas}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Cada obra num cartao: o nome inteiro em cima, os dados embaixo -->
                                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BordaClara}" Padding="12,10" Margin="0,0,0,8" Background="{StaticResource Branco}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Tirar" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            AutomationProperties.Name="Tirar esta obra do cronograma"
                                                            Command="{Binding DataContext.RemoverLinhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Numero}" Style="{StaticResource Texto2}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="18" />
                                                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Visibility="{Binding Selo, Converter={StaticResource VisivelSe}}" ToolTip="Obra ainda sem contrato">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource Fundo}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EhLicitacao}" Value="True"><Setter Property="Background" Value="{StaticResource LaranjaClaro}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Selo}" FontSize="12" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Escola ou obra" FontSize="15" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <Grid Margin="28,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="1.2*" MinWidth="90" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="1.5*" MinWidth="110" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="128" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="Portaria" Style="{StaticResource Texto2}" FontSize="12" />
                                                        <TextBox Text="{Binding Portaria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Portaria" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                        <TextBlock Text="Lote" Style="{StaticResource Texto2}" FontSize="12" />
                                                        <TextBox Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                                        <TextBlock Text="Dotação" Style="{StaticResource Texto2}" FontSize="12" ToolTip="A resumida (3360) ou a completa. A completa e a da remuneração vêm da base de dotações." />
                                                        <TextBox Text="{Binding Dotacao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dotação" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="0,0,6,0">
                                                        <TextBlock Text="Breve escopo" Style="{StaticResource Texto2}" FontSize="12" />
                                                        <TextBox Text="{Binding Escopo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escopo" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" Margin="0,0,6,0">
                                                        <TextBlock Text="Valor da obra (R$)" Style="{StaticResource Texto2}" FontSize="12" ToolTip="Sem os 10%: o cronograma soma a remuneração" />
                                                        <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor da obra em reais" TextAlignment="Right" t:Mascaras.Dinheiro="True" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="5" Margin="0,0,6,0">
                                                        <TextBlock Text="Início" Style="{StaticResource Texto2}" FontSize="12" ToolTip="Mês e ano, como nov/26 ou 11/2026" />
                                                        <TextBox Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mês de início" ToolTip="Mês e ano, como nov/26 ou 11/2026" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6" Margin="0,0,6,0">
                                                        <TextBlock Text="Fim" Style="{StaticResource Texto2}" FontSize="12" ToolTip="Mês e ano, como mai/27 ou 05/2027" />
                                                        <TextBox Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mês de fim" ToolTip="Mês e ano, como mai/27 ou 05/2027" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="7">
                                                        <TextBlock Text="Distribuição" Style="{StaticResource Texto2}" FontSize="12" ToolTip="Linear: partes iguais. Curva S: começa baixo, sobe até o meio do prazo e desce." />
                                                        <ComboBox SelectedIndex="{Binding IndiceDistribuicao}" AutomationProperties.Name="Distribuição desta obra"
                                                                  ItemsSource="{Binding DataContext.DistribuicoesDaObra, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Contratos da base com esse nome: escolher preenche portaria, lote e dotacao -->
                                                <Border Margin="28,8,0,0" Padding="10,6" CornerRadius="8"
                                                        Background="{StaticResource AzulClaro}" Visibility="{Binding TemSugestoes, Converter={StaticResource Visivel}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Na Base de dados (escolha o contrato certo):" Style="{StaticResource Texto2}" FontSize="13" />
                                                        <ItemsControl ItemsSource="{Binding Sugestoes}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource BotaoLink}" Content="{Binding Texto}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                            Command="{Binding DataContext.EscolherSugestaoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                                            AutomationProperties.Name="Usar este contrato" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <DockPanel Margin="28,6,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Usar esta distribuição em todas" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.UsarDistribuicaoEmTodasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding DataContext.TemVariasObras, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visivel}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Calculo}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap"
                                                                   Visibility="{Binding Calculo, Converter={StaticResource VisivelSe}}" />
                                                        <TextBlock Text="{Binding Avisos}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding Avisos, Converter={StaticResource VisivelSe}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto2}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Impedida}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource Vermelho}" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding TemSugestoesDoContrato, Converter={StaticResource Visivel}}">
                            <TextBlock Text="Escolas do mesmo contrato que ainda não estão no cronograma" Style="{StaticResource Texto2}" FontSize="13" />
                            <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding SugestoesDoContrato}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BotaoLink}" Margin="0,2,18,0" ToolTip="{Binding Texto}" AutomationProperties.Name="Incluir esta escola no cronograma"
                                                    Command="{Binding DataContext.AdicionarDoContratoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock><Run Text="+ " /><Run Text="{Binding Obra.Empreendimento, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Obra.Contrato, Mode=OneWay}" /></TextBlock>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,0" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Ajustes por mes e como fica -->
        <Grid Grid.Row="2" Margin="0,12,0,0" MaxHeight="270">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="18,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Adicionar ajuste" MinHeight="36" Command="{Binding NovoAjusteCommand}" />
                        <TextBlock Text="Ajustes por mês" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="Fixe um percentual ou um valor num mês, para todas as obras ou uma só. Os outros meses dividem o restante pela distribuição de cada obra." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Ajustes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Margin="0,0,4,0" SelectedItem="{Binding Mes}" AutomationProperties.Name="Mês do ajuste"
                                                      ItemsSource="{Binding DataContext.MesesDoCronograma, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                            <ComboBox Grid.Column="1" Margin="0,0,4,0" SelectedIndex="{Binding Tipo}" AutomationProperties.Name="Tipo do ajuste"
                                                      ItemsSource="{Binding DataContext.TiposDeAjuste, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                            <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Quantia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Percentual ou valor do ajuste"
                                                     t:Mascaras.Dinheiro="{Binding EmReais}" />
                                            <ComboBox Grid.Column="3" SelectedIndex="{Binding Para}" AutomationProperties.Name="Obra do ajuste"
                                                      ItemsSource="{Binding DataContext.OpcoesDeObra, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                            <Button Grid.Column="4" Style="{StaticResource BotaoLink}" Content="Tirar" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Tirar este ajuste"
                                                    Command="{Binding DataContext.RemoverAjusteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Aviso}" Foreground="{StaticResource Vermelho}" FontSize="13" FontWeight="SemiBold" Margin="2,2,0,0"
                                                   Visibility="{Binding Aviso, Converter={StaticResource VisivelSe}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="18,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Como fica" Style="{StaticResource TituloPainel}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Totais}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"
                               Visibility="{Binding Totais, Converter={StaticResource VisivelSe}}" />
                    <TextBlock DockPanel.Dock="Top" Text="Os meses, os anos e a tabela por dotação aparecem aqui quando as obras estiverem completas."
                               Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding TemCalculo, Converter={StaticResource VisivelSeNao}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding TemCalculo, Converter={StaticResource Visivel}}">
                        <StackPanel>
                            <!-- Miniatura da planilha: uma linha por obra e o valor de cada mês -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Background="{StaticResource Azul}">
                                        <TextBlock Text="Obra" Width="170" Foreground="{StaticResource Branco}" FontWeight="SemiBold" FontSize="12" Padding="6,4" />
                                        <ItemsControl ItemsSource="{Binding MesesMiniatura}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <TextBlock Text="{Binding}" Width="92" TextAlignment="Right" Foreground="{StaticResource Branco}" FontWeight="SemiBold" FontSize="12" Padding="6,4" />
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Total" Width="120" TextAlignment="Right" Foreground="{StaticResource Branco}" FontWeight="SemiBold" FontSize="12" Padding="6,4" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Miniatura}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Linha" BorderBrush="{StaticResource BordaClara}" BorderThickness="0,0,0,1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="Nome" Text="{Binding Nome}" Width="170" FontSize="12" Padding="6,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                                                        <ItemsControl ItemsSource="{Binding Valores}" Focusable="False">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                                <TextBlock Text="{Binding}" Width="92" TextAlignment="Right" FontSize="12" Padding="6,3" />
                                                            </DataTemplate></ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding Total}" Width="120" TextAlignment="Right" FontSize="12" FontWeight="SemiBold" Padding="6,3" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Destaque}" Value="True">
                                                        <Setter TargetName="Linha" Property="Background" Value="{StaticResource Fundo}" />
                                                        <Setter TargetName="Nome" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Anos}" Focusable="False" Margin="0,2,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,20,0" FontSize="13">
                                            <Run Text="{Binding Rotulo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Valor, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Dotacoes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Valor}" FontSize="13" Margin="12,0,0,0" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" Width="96" />
                                            <TextBlock Text="{Binding Rotulo}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rotulo}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Rodape -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="Remuneração" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Remuneracao, UpdateSourceTrigger=PropertyChanged}" Width="64" TextAlignment="Right" AutomationProperties.Name="Percentual de remuneração"
                         ToolTip="Percentual sobre o valor para obras. O padrão é 10%." />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,28,0" />
                <CheckBox IsChecked="{Binding GerarPdf}" Content="Gerar também o PDF" IsEnabled="{Binding PdfDisponivel}" Margin="0,0,28,0" VerticalAlignment="Center" />
                <TextBlock Text="Nome do arquivo" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding NomeCronograma, UpdateSourceTrigger=PropertyChanged}" Width="280" AutomationProperties.Name="Nome do arquivo do cronograma"
                         ToolTip="Em branco, o app usa “Cronograma - Portaria … - Lote …”" />
            </WrapPanel>
            <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                        Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Desfazer" Margin="12,0,0,0" Command="{Binding DesfazerInclusaoCommand}"
                        Visibility="{Binding PodeDesfazerInclusao, Converter={StaticResource Visivel}}" ToolTip="Tira do cronograma as escolas que acabaram de entrar" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultadoModelo}" VerticalAlignment="Center" Focusable="False" />
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotao}" Margin="8,0,0,0" Command="{Binding GerarCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Forte}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Texto2}" FontSize="13" TextTrimming="CharacterEllipsis">
                        <Run Text="Salvar em: " /><Run Text="{Binding PastaDestino, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
