<UserControl x:Class="Spobras.App.Telas.CronogramaTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cronograma padrão" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Você informa as obras; o app preenche uma cópia do seu modelo. As fórmulas e o modelo original não são alterados."
                       Style="{StaticResource Texto2}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Modelo em uso -->
        <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Margin="12,0,0,0" VerticalAlignment="Center" Command="{Binding EscolherModeloCommand}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Escolher o modelo" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemModelo}" Value="True"><Setter Property="Text" Value="Trocar o modelo" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding TemModelo, Converter={StaticResource Visivel}}">
                    <TextBlock Text="Aba" Style="{StaticResource Texto2}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Abas}" SelectedItem="{Binding Aba}" Width="220" ItemTemplate="{StaticResource OpcaoTexto}"
                              AutomationProperties.Name="Aba do modelo a preencher" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding EstadoDoModelo}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TextoDotacoes}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding TextoDotacoes, Converter={StaticResource VisivelSe}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Obras -->
        <Border Grid.Row="2" Style="{StaticResource Painel}" Margin="0,16,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Limpar tudo" Margin="8,0,0,0" MinHeight="44" Command="{Binding LimparCommand}"
                            Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSe}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Colar do Excel" Margin="8,0,0,0" Command="{Binding ColarDoExcelCommand}"
                            ToolTip="Copie as linhas no Excel, na ordem das colunas abaixo, e clique aqui" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar obra" Margin="8,0,0,0" Command="{Binding NovaLinhaCommand}" />
                    <TextBlock Text="Obras do cronograma" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSe}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Portaria" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="2" Text="Lote" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="3" Text="Dotação" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="4" Text="Escola / obra" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="5" Text="Escopo" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="6" Text="Valor (R$)" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="7" Text="Início" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="8" Text="Fim" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                </Grid>

                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSeNao}}">
                        <TextBlock Text="Nenhuma obra ainda" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Texto2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="520"
                                   Text="Adicione uma obra, cole as linhas copiadas do Excel ou use “Usar no cronograma” na Base de dados." />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Linhas}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="102" />
                                            <ColumnDefinition Width="102" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Numero}" Style="{StaticResource Texto2}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Margin="2,0" Text="{Binding Portaria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Portaria" />
                                        <TextBox Grid.Column="2" Margin="2,0" Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" />
                                        <TextBox Grid.Column="3" Margin="2,0" Text="{Binding Dotacao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dotação" />
                                        <TextBox Grid.Column="4" Margin="2,0" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escola ou obra" />
                                        <TextBox Grid.Column="5" Margin="2,0" Text="{Binding Escopo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escopo" />
                                        <TextBox Grid.Column="6" Margin="2,0" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor em reais" TextAlignment="Right" />
                                        <TextBox Grid.Column="7" Margin="2,0" Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Início" ToolTip="Dia/mês/ano ou mês/ano" />
                                        <TextBox Grid.Column="8" Margin="2,0" Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fim" ToolTip="Dia/mês/ano ou mês/ano" />
                                        <Button Grid.Column="9" Style="{StaticResource BotaoLink}" Content="Tirar" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                AutomationProperties.Name="Tirar esta obra do cronograma"
                                                Command="{Binding DataContext.RemoverLinhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" Text="{Binding Avisos}" FontSize="13" TextWrapping="Wrap" Margin="4,4,4,0"
                                                   Visibility="{Binding Avisos, Converter={StaticResource VisivelSe}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto2}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Impedida}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Vermelho}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Rodape -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding AjustarInicio}" Margin="0,0,28,0"
                          Content="Começar a contar no dia 1º do mês de início"
                          ToolTip="O modelo só distribui valor no mês de início quando a data é o dia 1º. A data que vai para a planilha aparece em cada linha." />
                <CheckBox IsChecked="{Binding GerarPdf}" Content="Gerar também o PDF" IsEnabled="{Binding ExcelDisponivel}" />
            </WrapPanel>
            <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                        Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                <TextBlock Text="{Binding Resultado}" Style="{StaticResource Forte}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotao}" Margin="8,0,0,0" Command="{Binding GerarCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Forte}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Texto2}" FontSize="13" TextTrimming="CharacterEllipsis">
                        <Run Text="Salvar em: " /><Run Text="{Binding PastaDestino, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
