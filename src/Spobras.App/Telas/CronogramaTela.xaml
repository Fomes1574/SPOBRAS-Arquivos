<UserControl x:Class="Spobras.App.Telas.CronogramaTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Cronograma padrão" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Você informa as obras; o app calcula a remuneração, os meses, o total de cada ano e a tabela por dotação, e gera a planilha pronta."
                       Style="{StaticResource Texto2}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Obras -->
        <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0,16,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Limpar tudo" Margin="8,0,0,0" MinHeight="44" Command="{Binding LimparCommand}"
                            Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSe}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Importar de uma planilha" Margin="8,0,0,0" MinHeight="44" Command="{Binding ImportarPlanilhaCommand}"
                            ToolTip="Lê as obras de uma planilha sua, achando as colunas pelos títulos" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Colar do Excel" Margin="8,0,0,0" Command="{Binding ColarDoExcelCommand}"
                            ToolTip="Copie no Excel as colunas Portaria, Lote, Dotação, Nome da Obra, Breve escopo, Valor, Início e Fim, e clique aqui" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar obra" Margin="8,0,0,0" Command="{Binding NovaLinhaCommand}" />
                    <TextBlock Text="Obras do cronograma" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSe}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="102" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Portaria" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="2" Text="Lote" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="3" Text="Dotação" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" ToolTip="A resumida (3360) ou a completa. A completa e a da remuneração vêm da base de dotações." />
                    <TextBlock Grid.Column="4" Text="Escola / obra" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="5" Text="Escopo" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="6" Text="Valor obra (R$)" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="7" Text="Início (mês)" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                    <TextBlock Grid.Column="8" Text="Fim (mês)" Style="{StaticResource Texto2}" FontSize="13" Margin="4,0" />
                </Grid>

                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Linhas.Count, Converter={StaticResource VisivelSeNao}}">
                        <TextBlock Text="Nenhuma obra ainda" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Texto2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="520"
                                   Text="Adicione uma obra, cole as linhas copiadas do Excel ou use “Usar no cronograma” na Base de dados." />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Linhas}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="102" />
                                            <ColumnDefinition Width="102" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Numero}" Style="{StaticResource Texto2}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Margin="2,0" Text="{Binding Portaria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Portaria" />
                                        <TextBox Grid.Column="2" Margin="2,0" Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" />
                                        <TextBox Grid.Column="3" Margin="2,0" Text="{Binding Dotacao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dotação" />
                                        <TextBox Grid.Column="4" Margin="2,0" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escola ou obra" />
                                        <TextBox Grid.Column="5" Margin="2,0" Text="{Binding Escopo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Escopo" />
                                        <TextBox Grid.Column="6" Margin="2,0" Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor em reais" TextAlignment="Right" />
                                        <TextBox Grid.Column="7" Margin="2,0" Text="{Binding Inicio, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mês de início" ToolTip="Mês e ano, como nov/26 ou 11/2026" />
                                        <TextBox Grid.Column="8" Margin="2,0" Text="{Binding Fim, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mês de fim" ToolTip="Mês e ano, como ago/27 ou 08/2027" />
                                        <Button Grid.Column="9" Style="{StaticResource BotaoLink}" Content="Tirar" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                AutomationProperties.Name="Tirar esta obra do cronograma"
                                                Command="{Binding DataContext.RemoverLinhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" Text="{Binding Avisos}" FontSize="13" TextWrapping="Wrap" Margin="4,4,4,0"
                                                   Visibility="{Binding Avisos, Converter={StaticResource VisivelSe}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Texto2}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Impedida}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Vermelho}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="8" Text="{Binding Calculo}" Style="{StaticResource Texto2}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" Margin="4,2,4,0" ToolTip="{Binding Calculo}"
                                                   Visibility="{Binding Calculo, Converter={StaticResource VisivelSe}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Ajustes por mes e como fica -->
        <Grid Grid.Row="2" Margin="0,12,0,0" MaxHeight="270">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="18,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Adicionar ajuste" MinHeight="36" Command="{Binding NovoAjusteCommand}" />
                        <TextBlock Text="Ajustes por mês" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"
                               Text="Fixe um percentual ou um valor num mês, para todas as obras ou uma só. Os outros meses dividem o restante em partes iguais." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Ajustes}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Margin="0,0,4,0" Text="{Binding Mes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mês do ajuste" ToolTip="Mês e ano, como nov/26" />
                                            <ComboBox Grid.Column="1" Margin="0,0,4,0" SelectedIndex="{Binding Tipo}" AutomationProperties.Name="Tipo do ajuste"
                                                      ItemsSource="{Binding DataContext.TiposDeAjuste, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                            <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Quantia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" AutomationProperties.Name="Percentual ou valor do ajuste" />
                                            <ComboBox Grid.Column="3" SelectedIndex="{Binding Para}" AutomationProperties.Name="Obra do ajuste"
                                                      ItemsSource="{Binding DataContext.OpcoesDeObra, RelativeSource={RelativeSource AncestorType=UserControl}}" ItemTemplate="{StaticResource OpcaoTexto}" />
                                            <Button Grid.Column="4" Style="{StaticResource BotaoLink}" Content="Tirar" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    AutomationProperties.Name="Tirar este ajuste"
                                                    Command="{Binding DataContext.RemoverAjusteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Aviso}" Foreground="{StaticResource Vermelho}" FontSize="13" FontWeight="SemiBold" Margin="2,2,0,0"
                                                   Visibility="{Binding Aviso, Converter={StaticResource VisivelSe}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="18,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Como fica" Style="{StaticResource TituloPainel}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Totais}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,8"
                               Visibility="{Binding Totais, Converter={StaticResource VisivelSe}}" />
                    <TextBlock DockPanel.Dock="Top" Text="Os meses, os anos e a tabela por dotação aparecem aqui quando as obras estiverem completas."
                               Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding TemCalculo, Converter={StaticResource VisivelSeNao}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding TemCalculo, Converter={StaticResource Visivel}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Meses}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Caixa" BorderBrush="{StaticResource BordaClara}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6" MinWidth="104"
                                                ToolTip="{Binding Detalhe}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource Texto2}" FontSize="12" />
                                                <TextBlock Text="{Binding Valor}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Destaque}" Value="True">
                                                <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Vermelho}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Anos}" Focusable="False" Margin="0,2,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,0,20,0" FontSize="13">
                                            <Run Text="{Binding Rotulo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Valor, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Dotacoes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Valor}" FontSize="13" Margin="12,0,0,0" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" Width="96" />
                                            <TextBlock Text="{Binding Rotulo}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rotulo}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Rodape -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <WrapPanel Margin="0,0,0,10">
                <TextBlock Text="Remuneração" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Remuneracao, UpdateSourceTrigger=PropertyChanged}" Width="64" TextAlignment="Right" AutomationProperties.Name="Percentual de remuneração"
                         ToolTip="Percentual sobre o valor para obras. O padrão é 10%." />
                <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,28,0" />
                <CheckBox IsChecked="{Binding GerarPdf}" Content="Gerar também o PDF" IsEnabled="{Binding PdfDisponivel}" Margin="0,0,28,0" VerticalAlignment="Center" />
                <TextBlock Text="Nome do arquivo" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding NomeCronograma, UpdateSourceTrigger=PropertyChanged}" Width="280" AutomationProperties.Name="Nome do arquivo do cronograma"
                         ToolTip="Em branco, o app usa “Cronograma - Portaria … - Lote …”" />
            </WrapPanel>
            <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                        Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultadoModelo}" VerticalAlignment="Center" Focusable="False" />
            </DockPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotao}" Margin="8,0,0,0" Command="{Binding GerarCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Forte}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Texto2}" FontSize="13" TextTrimming="CharacterEllipsis">
                        <Run Text="Salvar em: " /><Run Text="{Binding PastaDestino, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
