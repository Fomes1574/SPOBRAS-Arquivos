<UserControl x:Class="Spobras.App.Telas.PrevistasPainel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Spobras.App.Telas">
    <!-- Base Em licitacao ou A licitar: lista, filtros e ficha proprios (nunca misturados com as obras em andamento) -->
    <UserControl.Resources>
        <Style x:Key="Selo" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource AzulClaro}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.EhLicitacao, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource LaranjaClaro}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Limpar filtros" Margin="12,0,0,0" Command="{Binding LimparFiltrosCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="Procurar" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Procurar por escola, lote, modalidade, empresa ou processo"
                             ToolTip="Escola, lote, modalidade, empresa, processo SEI ou contrato de receita" />
                </DockPanel>
                <UniformGrid Rows="1" Margin="-6,12,-6,0">
                    <StackPanel Margin="6,0">
                        <t:FiltroMultiplo Rotulo="Portaria" Plural="portarias" Itens="{Binding Portarias}" Selecionados="{Binding Portaria}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <t:FiltroMultiplo Rotulo="{Binding RotuloLote}" Plural="lotes" Itens="{Binding Lotes}" Selecionados="{Binding Lote}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <t:FiltroMultiplo Rotulo="Modalidade" Plural="modalidades" Itens="{Binding Modalidades}" Selecionados="{Binding Modalidade}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <t:FiltroMultiplo Rotulo="Dotação" Plural="dotações" Itens="{Binding Dotacoes}" Selecionados="{Binding Dotacao}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <t:FiltroMultiplo Rotulo="Situação" Plural="situações" Itens="{Binding Situacoes}" Selecionados="{Binding Status}" />
                    </StackPanel>
                    <StackPanel Margin="6,0" Visibility="{Binding EhLicitacao, Converter={StaticResource Visivel}}">
                        <t:FiltroMultiplo Rotulo="Empresa" Plural="empresas" Itens="{Binding Empresas}" Selecionados="{Binding Empresa}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,4,26,6">
                        <TextBlock DockPanel.Dock="Right" Text="Valor da obra" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Obra" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource Texto2}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="20"
                                   Visibility="{Binding Obras.Count, Converter={StaticResource VisivelSeNao}}" />
                        <ListBox ItemsSource="{Binding Obras}" SelectedItem="{Binding Selecionada}" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource LinhaSelecionavel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Obras encontradas">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Valor}" Margin="12,0,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="0">
                <Grid>
                    <TextBlock Text="Clique numa obra para ver todos os dados dela." Style="{StaticResource Texto2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="20" Visibility="{Binding Selecionada, Converter={StaticResource VisivelSeNao}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding Selecionada, Converter={StaticResource VisivelSe}}">
                        <StackPanel Margin="20,16,20,12">
                            <Border Style="{StaticResource Selo}">
                                <TextBlock Text="{Binding Selecionada.Selo}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding Selecionada.Nome}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Selecionada.Detalhe}" Foreground="{StaticResource Azul}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource BotaoSecundario}" Content="Usar no cronograma" HorizontalAlignment="Left" Command="{Binding UsarNoCronogramaCommand}"
                                    Visibility="{Binding PodeUsarNoCronograma, Converter={StaticResource Visivel}}"
                                    ToolTip="Acrescenta esta obra ao cronograma para pedir recurso antes do contrato; informe o início e o fim" />
                            <Border CornerRadius="8" Padding="12,8" Margin="0,12,0,0" Background="{StaticResource AzulClaro}"
                                    Visibility="{Binding TemTambemEm, Converter={StaticResource Visivel}}">
                                <StackPanel>
                                    <TextBlock Text="Esta escola também está em:" FontSize="13" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding TambemEm}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BotaoLink}" Content="{Binding Texto}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        Command="{Binding DataContext.AbrirOutraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        ToolTip="Abre a escola na outra base; os dados não se juntam" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,10,0,4" Margin="0,12,0,0">
                                <ItemsControl ItemsSource="{Binding Selecionada.Campos}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,16,10">
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Exportar para Excel" Margin="12,0,0,0" Command="{Binding ExportarCommand}"
                        IsEnabled="{Binding TemObras}" ToolTip="Planilha nova com as obras deste filtro, nas colunas desta base, e uma aba com os filtros e a data" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Resumo}" Style="{StaticResource Forte}" Visibility="{Binding Obras.Count, Converter={StaticResource VisivelSe}}" />
                    <TextBlock Text="{Binding Totais}" Style="{StaticResource Texto2}" FontSize="13" Visibility="{Binding Totais, Converter={StaticResource VisivelSe}}" />
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Mostrar na pasta" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding AbrirExportacaoCommand}" Visibility="{Binding PodeAbrirExportacao, Converter={StaticResource Visivel}}" />
                <TextBlock Text="{Binding Resultado}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
