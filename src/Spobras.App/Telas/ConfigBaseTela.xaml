<UserControl x:Class="Spobras.App.Telas.ConfigBaseTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Spobras.App.ViewModels">
    <!-- Configuracoes da base (engrenagem da Base de dados): colunas e tabelas da mestra, status e diagnostico. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,24,40,32" MaxWidth="1200" HorizontalAlignment="Left">
            <Button Style="{StaticResource BotaoLink}" Content="‹ Base de dados" HorizontalAlignment="Left" Command="{Binding VoltarCommand}" MinHeight="36" />
            <TextBlock Text="Configurações da base" Style="{StaticResource TituloPagina}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Texto2}" Margin="0,4,0,0" Text="Vale só neste computador. A planilha mestra nunca é alterada." />

            <Border Style="{StaticResource Painel}" Margin="0,14,0,0" Padding="16,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <TextBlock Text="{Binding Resultado}" Style="{StaticResource Forte}" TextWrapping="Wrap" />
            </Border>

            <TabControl SelectedIndex="{Binding Aba}" Margin="0,16,0,0" Background="Transparent" BorderThickness="0">
                <TabItem Header="Planilha e colunas" Padding="14,8" FontSize="14">
                    <StackPanel Margin="0,14,0,0">
                        <Border Background="#FFF8E1" BorderBrush="#F0DC9A" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Antes de mexer aqui" FontWeight="Bold" Foreground="#4A3A00" />
                                <TextBlock TextWrapping="Wrap" Foreground="#4A3A00" Margin="0,4,0,0"
                                           Text="Estes ajustes mudam a forma como o app lê a planilha. Use só quando a planilha mudar, por exemplo uma coluna com nome novo ou um status que o app ainda não conhece. Uma escolha errada pode deixar a Base incompleta neste computador. Se isso acontecer, clique em “Voltar ao padrão”." />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E7F3EA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FaltaAlgo}" Value="True"><Setter Property="Background" Value="{StaticResource LaranjaClaro}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SituacaoDasColunas}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="520" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Painel}">
                                    <StackPanel>
                                        <TextBlock Text="Arquivo" Style="{StaticResource TituloPainel}" />
                                        <TextBlock Text="{Binding Arquivo}" Style="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Painel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Tabelas" Style="{StaticResource TituloPainel}" />
                                        <ItemsControl ItemsSource="{Binding Tabelas}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,10,0,0">
                                                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Situacao, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Nome, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Linhas, Mode=OneWay}" /></TextBlock>
                                                        <ComboBox ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Escolhida}" MinHeight="34" Margin="0,4,0,0"
                                                                  AutomationProperties.Name="{Binding Nome}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Painel}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Button Style="{StaticResource BotaoSecundario}" Content="Testar leitura" Command="{Binding TestarCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource BotaoPrimario}" Content="Salvar" Command="{Binding SalvarCommand}" Margin="0,0,8,8" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="Voltar ao padrão" Command="{Binding VoltarAoPadraoCommand}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ResultadoTeste}" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="{Binding ResultadoTeste, Converter={StaticResource VisivelSe}}" />
                                        <ItemsControl ItemsSource="{Binding Amostra}" Focusable="False" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Painel}">
                                <StackPanel>
                                    <TextBlock Text="Colunas usadas pelo app" Style="{StaticResource TituloPainel}" />
                                    <ItemsControl ItemsSource="{Binding Campos}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="210" />
                                                        <ColumnDefinition Width="*" MinWidth="200" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="Sinal" Text="{Binding Situacao}" FontWeight="Bold" Foreground="{StaticResource Verde}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Rotulo}">
                                                        <Run Text="{Binding Rotulo, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Tabela, Mode=OneWay}" Foreground="{StaticResource Secundario}" FontSize="12" />
                                                    </TextBlock>
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Opcoes}" SelectedItem="{Binding Coluna}" MinHeight="32" Margin="6,0"
                                                              AutomationProperties.Name="{Binding Rotulo}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Exemplo}" Style="{StaticResource Texto2}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Exemplo}" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Falta}" Value="True"><Setter TargetName="Sinal" Property="Foreground" Value="{StaticResource Laranja}" /></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Regras de status" Padding="14,8" FontSize="14">
                    <Border Style="{StaticResource Painel}" Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Texto2}" TextWrapping="Wrap" Text="Status do contrato encontrados na planilha. Define o que conta como em andamento (mostra medições em trâmite), concluído e o que não aparece no app." />
                            <ItemsControl ItemsSource="{Binding Status}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                                <Border Background="{StaticResource LaranjaClaro}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding Novo, Converter={StaticResource Visivel}}">
                                                    <TextBlock Text="NOVO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Laranja}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Obras}" Style="{StaticResource Texto2}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:StatusConfigVm.Nomes}" SelectedIndex="{Binding Situacao}" MinHeight="32"
                                                      AutomationProperties.Name="{Binding Status}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>
                <TabItem Header="Diagnóstico" Padding="14,8" FontSize="14">
                    <Border Style="{StaticResource Painel}" Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="{Binding Diagnostico}" TextWrapping="Wrap" />
                            <TextBlock Text="Últimas leituras" Style="{StaticResource TituloPainel}" Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding Leituras}" Focusable="False">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Texto2}" Margin="0,2" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
