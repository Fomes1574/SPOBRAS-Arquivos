<UserControl x:Class="Spobras.App.Telas.RelatorioTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Spobras.App.Telas"
             AllowDrop="True" Drop="AoSoltar" DragOver="AoArrastar" Background="Transparent">
    <UserControl.Resources>
        <!-- Botao de etapa: marcado quando e a etapa atual -->
        <Style x:Key="Etapa" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Secundario}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource Branco}" BorderBrush="{StaticResource Borda}" BorderThickness="1,1,1,4" CornerRadius="8" Padding="16,10" Margin="0,0,8,0">
                            <ContentPresenter RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Preto}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="atual">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Vermelho}" />
                                <Setter Property="Foreground" Value="{StaticResource Preto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Novo relatório" VerticalAlignment="Center" Command="{Binding NovoRelatorioCommand}"
                    ToolTip="Começa do zero, sem levar os dados deste relatório" />
            <StackPanel>
                <TextBlock Text="Relatório fotográfico" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="Três etapas, na ordem que você quiser. O que você preenche é salvo sozinho e continua aqui quando voltar."
                           Style="{StaticResource Texto2}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Etapas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="1  Dados" Command="{Binding IrParaCommand}" CommandParameter="0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaDados}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="2  Fotos e legendas" Command="{Binding IrParaCommand}" CommandParameter="1">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaFotos}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="3  Conferência e geração" Command="{Binding IrParaCommand}" CommandParameter="2">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaConferencia}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="{Binding TextoFotos}" Style="{StaticResource Texto2}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- ============ Etapa 1: Dados ============ -->
        <Border Grid.Row="2" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="0" Visibility="{Binding EtapaDados, Converter={StaticResource Visivel}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Atualizar dados" MinHeight="40" Command="{Binding AtualizarDadosCommand}"
                                ToolTip="Busca de novo na Base de dados, pelo contrato e pela escola, e traz os dados atualizados. Data, fiscal, descrição e fotos não mudam." />
                        <TextBlock Text="Dados do cabeçalho" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Todos os campos são opcionais. Campo em branco não aparece no relatório, nem o nome dele." Style="{StaticResource Texto2}" Margin="0,4,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="Unidade educacional" Style="{StaticResource Rotulo}" />
                    <TextBox Text="{Binding Unidade, UpdateSourceTrigger=PropertyChanged, Delay=500}" AutomationProperties.Name="Unidade educacional" />
                    <ItemsControl ItemsSource="{Binding ContratosDaEscola}" Focusable="False" Margin="0,6,0,0"
                                  Visibility="{Binding TemContratosParaEscolher, Converter={StaticResource Visivel}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BotaoLink}" Content="{Binding Texto}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        Command="{Binding DataContext.EscolherObraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Obra}"
                                        AutomationProperties.Name="Escolher este contrato" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Contratada" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Contratada, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contratada" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data do relatório" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding DataTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data do relatório" t:Mascaras.Data="True" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Contrato" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding Contrato, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Contrato"
                                     ToolTip="Digite o número do contrato como está na Base de dados, por exemplo 123/SIURB/2024" />
                            <ItemsControl ItemsSource="{Binding EscolasDoContrato}" Focusable="False" Margin="0,6,0,0"
                                          Visibility="{Binding TemEscolasParaEscolher, Converter={StaticResource Visivel}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotaoLink}" Content="{Binding Empreendimento}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                Command="{Binding DataContext.EscolherObraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Escolher esta escola" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lote" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Portaria" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Portaria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Portaria" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Processo SEI" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding ProcessoSei, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Processo SEI" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data da OS" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding DataOsTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data da OS" t:Mascaras.Data="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Fiscal" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding Responsavel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fiscal" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Objeto" Style="{StaticResource Rotulo}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding Objeto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Objeto ou serviço" />

                    <TextBlock Text="Descrição geral" Style="{StaticResource Rotulo}" Margin="0,12,0,6" />
                    <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição geral"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />

                    <ItemsControl ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,16,0,0" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Etapa 2: Fotos e legendas ============ -->
        <Border Grid.Row="2" Style="{StaticResource Painel}" Margin="0,16,0,0" Visibility="{Binding EtapaFotos, Converter={StaticResource Visivel}}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button Style="{StaticResource BotaoSecundario}" Content="Adicionar fotos" Margin="0,0,8,8" Command="{Binding AdicionarFotosCommand}" />
                    <Button Style="{StaticResource BotaoSecundario}" Content="Adicionar uma pasta" Margin="0,0,24,8" Command="{Binding AdicionarPastaCommand}" />
                    <Button Style="{StaticResource BotaoLinha}" Content="Ordenar pelo nome" MinHeight="44" Margin="0,0,8,8" Command="{Binding OrdenarPorNomeCommand}"
                            Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}" />
                    <Button Style="{StaticResource BotaoLinha}" Content="Ordenar pela data da foto" MinHeight="44" Margin="0,0,8,8" Command="{Binding OrdenarPorDataCommand}"
                            ToolTip="Usa a data em que a foto foi tirada; fotos sem essa data vão para o fim"
                            Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}" />
                </WrapPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Marcar / desmarcar todas" MinHeight="44" Margin="8,0,0,0" Command="{Binding SelecionarTodasCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Aplicar às marcadas (ou às sem legenda)" MinHeight="44" Margin="8,0,0,0" Command="{Binding AplicarLegendaEmLoteCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="Mesma legenda para várias:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <TextBox Text="{Binding LegendaEmLote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Legenda para várias fotos" />
                </DockPanel>

                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Problemas}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding TemFotos, Converter={StaticResource VisivelSeNao}}">
                        <TextBlock Text="Arraste as fotos ou uma pasta para cá" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="ou use os botões acima. Aceita JPG, PNG, BMP, WEBP e GIF." Style="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Fotos}" Style="{StaticResource ListaSimples}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Center" AutomationProperties.Name="Marcar esta foto" />
                                    <Border Grid.Column="1" Width="120" Height="90" Background="{StaticResource Fundo}" BorderBrush="{StaticResource Borda}" BorderThickness="1" HorizontalAlignment="Left">
                                        <Image Source="{Binding Miniatura, Converter={StaticResource Imagem}, ConverterParameter=240}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Rotulo}" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caminho}" />
                                        <TextBlock x:Name="Detalhe" Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" />
                                        <Button Style="{StaticResource BotaoLinha}" Content="Localizar…" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                Command="{Binding DataContext.LocalizarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding Faltando, Converter={StaticResource Visivel}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBox Text="{Binding Legenda, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Legenda da foto" ToolTip="Legenda (aparece depois do número da foto)" />
                                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Descrição do serviço" Margin="0,6,0,0"
                                                 ToolTip="Descrição do serviço (aparece quando o relatório é do tipo com descrição)"
                                                 Visibility="{Binding DataContext.ModoDescricao, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visivel}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BotaoLinha}" Content="⟲" ToolTip="Girar para a esquerda" AutomationProperties.Name="Girar para a esquerda" Margin="0,0,4,0"
                                                Command="{Binding DataContext.GirarEsquerdaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BotaoLinha}" Content="⟳" ToolTip="Girar para a direita" AutomationProperties.Name="Girar para a direita" Margin="0,0,4,0"
                                                Command="{Binding DataContext.GirarDireitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BotaoLinha}" Content="↑" ToolTip="Subir na ordem" AutomationProperties.Name="Subir na ordem" Margin="0,0,4,0"
                                                Command="{Binding DataContext.SubirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BotaoLinha}" Content="↓" ToolTip="Descer na ordem" AutomationProperties.Name="Descer na ordem" Margin="0,0,4,0"
                                                Command="{Binding DataContext.DescerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BotaoLinha}" Content="✕" ToolTip="Tirar do relatório (a foto não é apagada)" AutomationProperties.Name="Tirar do relatório"
                                                Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Faltando}" Value="True">
                                        <Setter TargetName="Detalhe" Property="Foreground" Value="{StaticResource Vermelho}" />
                                        <Setter TargetName="Detalhe" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ Etapa 3: Conferencia e geracao ============ -->
        <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20">
                        <TextBlock Text="Como fica a página" Style="{StaticResource TituloPainel}" Margin="0,0,0,10" />

                        <TextBlock Text="Fotos por página" Style="{StaticResource Rotulo}" />
                        <ComboBox ItemsSource="{Binding Capacidades}" SelectedItem="{Binding FotosPorPagina}" Width="120" HorizontalAlignment="Left"
                                  AutomationProperties.Name="Fotos por página" />

                        <TextBlock Text="Texto de cada foto" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                        <RadioButton GroupName="ModoLegenda" Content="Só a legenda curta"
                                     IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=LegendaCurta}" />
                        <RadioButton GroupName="ModoLegenda" Content="Legenda e descrição do serviço"
                                     IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=DescricaoServico}" />

                        <CheckBox Content="Espaço para assinaturas no fim" IsChecked="{Binding Assinaturas}" Margin="0,14,0,0" />
                        <StackPanel Visibility="{Binding Assinaturas, Converter={StaticResource Visivel}}" Margin="0,6,0,0">
                            <TextBlock Text="Nome sob “Fiscalização SPOBRAS” (opcional)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding AssinaturaFiscal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do fiscal" />
                            <TextBlock Text="Nome sob “Contratada” (opcional)" Style="{StaticResource Rotulo}" Margin="0,8,0,6" />
                            <TextBox Text="{Binding AssinaturaContratada, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do representante da contratada" />
                        </StackPanel>

                        <TextBlock Text="Peso das fotos no arquivo" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                        <RadioButton GroupName="QualidadeRel" Content="Alta (arquivo maior, melhor impressão)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Alta}" />
                        <RadioButton GroupName="QualidadeRel" Content="Média (recomendado)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Media}" />
                        <RadioButton GroupName="QualidadeRel" Content="Leve (bom para enviar por e-mail)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Leve}" />
                        <TextBlock Text="As fotos originais nunca são alteradas: o relatório usa cópias." Style="{StaticResource Texto2}" FontSize="13" Margin="0,4,0,0" />

                        <CheckBox Content="Gerar também em PDF (feito pelo Excel)" IsChecked="{Binding GerarPdf}" Margin="0,14,0,0" />
                        <TextBlock Text="Sem logo cadastrado: o relatório sai sem logo. Para incluir, escolha a imagem em Configurações."
                                   Style="{StaticResource Texto2}" FontSize="13" Margin="0,10,0,0" Visibility="{Binding TemLogo, Converter={StaticResource VisivelSeNao}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Resumo}" Style="{StaticResource Forte}" VerticalAlignment="Center" />
                        <TextBlock Text="Prévia das páginas" Style="{StaticResource TituloPainel}" />
                    </DockPanel>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Fundo}" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Paginas}" Margin="8" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource Texto2}" FontSize="13" Margin="0,0,0,4" />
                                        <Border Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="1" Padding="14">
                                            <Viewbox Width="330" Stretch="Uniform">
                                                <ItemsControl ItemsSource="{Binding Elementos}" Width="{Binding Largura}" Height="{Binding Altura}" Focusable="False"
                                                              FontFamily="Calibri, Carlito, Segoe UI" Foreground="Black">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                            <Setter Property="Width" Value="{Binding Largura}" />
                                                            <Setter Property="Height" Value="{Binding Altura}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Caixa" BorderBrush="Black" BorderThickness="0" Background="Transparent">
                                                                <Grid>
                                                                    <Image Source="{Binding Imagem, Converter={StaticResource Imagem}, ConverterParameter=360}" Stretch="Uniform" />
                                                                    <TextBlock x:Name="Txt" Text="{Binding Texto}" FontSize="{Binding Fonte}" TextWrapping="Wrap" Padding="6,0"
                                                                               VerticalAlignment="Top" TextAlignment="Left" />
                                                                    <TextBlock x:Name="Falta" Text="Foto não encontrada" Foreground="{StaticResource Vermelho}" FontWeight="Bold" FontSize="16"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Borda}" Value="True">
                                                                    <Setter TargetName="Caixa" Property="BorderThickness" Value="1" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LinhaEmCima}" Value="True">
                                                                    <Setter TargetName="Caixa" Property="BorderThickness" Value="0,1,0,0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Fundo}" Value="True">
                                                                    <Setter TargetName="Caixa" Property="Background" Value="#D9D9D9" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Negrito}" Value="True">
                                                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Centro}" Value="True">
                                                                    <Setter TargetName="Txt" Property="TextAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Meio}" Value="True">
                                                                    <Setter TargetName="Txt" Property="VerticalAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Faltando}" Value="True">
                                                                    <Setter TargetName="Falta" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Viewbox>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Rodape: salvar em + acao da etapa -->
        <Border Grid.Row="3" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                            Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultadoModelo}" VerticalAlignment="Center" Focusable="False" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource BotaoSecundario}" Content="Voltar" Margin="0,0,12,0" Command="{Binding VoltarCommand}"
                            Visibility="{Binding EtapaDados, Converter={StaticResource VisivelSeNao}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="Gerar relatório" Margin="12,0,0,0" Command="{Binding GerarCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotaoAvancar}" Margin="12,0,0,0" Command="{Binding AvancarCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource VisivelSeNao}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding EtapaConferencia, Converter={StaticResource VisivelSeNao}}">
                            <TextBlock Text="Rascunho salvo automaticamente." Style="{StaticResource Texto2}" />
                        </StackPanel>
                        <Grid Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Salvar em" Style="{StaticResource Texto2}" FontSize="13" />
                                <TextBlock Text="{Binding PastaDestino}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PastaDestino}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{Binding NomeArquivo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do arquivo do relatório"
                                     ToolTip="Nome do arquivo (sem a extensão)" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
