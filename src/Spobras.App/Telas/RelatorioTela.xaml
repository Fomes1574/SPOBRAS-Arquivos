<UserControl x:Class="Spobras.App.Telas.RelatorioTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Spobras.App.Telas"
             AllowDrop="True" Drop="AoSoltar" DragOver="AoArrastar" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="BorrachaRelatorio" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,3,0" />
            <Setter Property="ToolTip" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="#444444" StrokeThickness="1.6"
                              Data="M3,14 L11,5 Q12,4 14,5 L20,10 Q21,11 20,13 L14,20 H8 L3,16 Q2,15 3,14 M7,10 L16,18 M14,20 H22" />
                    </Border>
                </ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Botao de etapa: marcado quando e a etapa atual -->
        <Style x:Key="Etapa" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Secundario}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource Branco}" BorderBrush="{StaticResource Borda}" BorderThickness="1,1,1,4" CornerRadius="8" Padding="16,10" Margin="0,0,8,0">
                            <ContentPresenter RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Preto}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="atual">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Vermelho}" />
                                <Setter Property="Foreground" Value="{StaticResource Preto}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Novo relatório" VerticalAlignment="Center" Command="{Binding NovoRelatorioCommand}"
                    ToolTip="Começa do zero, sem levar os dados deste relatório" />
            <StackPanel>
                <TextBlock Text="Relatório fotográfico" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="Três etapas, na ordem que você quiser. O que você preenche é salvo sozinho e continua aqui quando voltar."
                           Style="{StaticResource Texto2}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Etapas -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="1  Dados" Command="{Binding IrParaCommand}" CommandParameter="0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaDados}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="2  Fotos e textos" Command="{Binding IrParaCommand}" CommandParameter="1">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaFotos}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="3  Conferência e geração" Command="{Binding IrParaCommand}" CommandParameter="2">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Etapa}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EtapaConferencia}" Value="True"><Setter Property="Tag" Value="atual" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="{Binding TextoFotos}" Style="{StaticResource Texto2}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- ============ Etapa 1: Dados ============ -->
        <Border Grid.Row="2" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="0" Visibility="{Binding EtapaDados, Converter={StaticResource Visivel}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Atualizar dados" MinHeight="40" Command="{Binding AtualizarDadosCommand}"
                                ToolTip="Busca de novo na Base de dados, pelo contrato e pela escola, e traz os dados atualizados. Data, fiscal, descrição e fotos não mudam." />
                        <TextBlock Text="Dados do cabeçalho" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Todos os campos são opcionais. Campo em branco não aparece no relatório, nem o nome dele." Style="{StaticResource Texto2}" Margin="0,4,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="Unidade educacional" Style="{StaticResource Rotulo}" />
                    <Grid>
                        <Grid>
                            <TextBox Padding="8,6,34,6" x:Name="SugestaoUnidade" Text="{Binding Unidade, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Unidade educacional"
                                 TextChanged="AoDigitarSugestao" PreviewKeyDown="TeclasSugestao" />
                            <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=SugestaoUnidade}" AutomationProperties.Name="Apagar Unidade educacional" Click="ApagarCampo" />
                        </Grid>
                        <Popup x:Name="PopupUnidade" PlacementTarget="{Binding ElementName=SugestaoUnidade}" StaysOpen="False" Placement="Bottom">
                            <Border Width="290" Background="White" BorderBrush="#999999" BorderThickness="1" Padding="5">
                                <ListBox x:Name="ListaUnidade" MaxHeight="320" PreviewMouseLeftButtonUp="ClicarSugestao">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
                                        <TextBlock Text="{Binding Valor}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" FontSize="12" Foreground="#555555" TextWrapping="Wrap" />
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ContratosDaEscola}" Focusable="False" Margin="0,6,0,0"
                                  Visibility="{Binding TemContratosParaEscolher, Converter={StaticResource Visivel}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BotaoLink}" Content="{Binding Texto}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                        Command="{Binding DataContext.EscolherObraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Obra}"
                                        AutomationProperties.Name="Escolher este contrato" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Contratada" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoContratada" Text="{Binding Contratada, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Contratada" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoContratada}" AutomationProperties.Name="Apagar Contratada" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data do relatório" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoDataTexto" Text="{Binding DataTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data do relatório" t:Mascaras.Data="True" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoDataTexto}" AutomationProperties.Name="Apagar Data do relatório" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Contrato" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" />
                            <Grid>
                        <Grid>
                            <TextBox Padding="8,6,34,6" x:Name="SugestaoContrato" Text="{Binding Contrato, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Contrato"
                                 TextChanged="AoDigitarSugestao" PreviewKeyDown="TeclasSugestao" />
                            <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=SugestaoContrato}" AutomationProperties.Name="Apagar Contrato" Click="ApagarCampo" />
                        </Grid>
                        <Popup x:Name="PopupContrato" PlacementTarget="{Binding ElementName=SugestaoContrato}" StaysOpen="False" Placement="Bottom">
                            <Border Width="290" Background="White" BorderBrush="#999999" BorderThickness="1" Padding="5">
                                <ListBox x:Name="ListaContrato" MaxHeight="320" PreviewMouseLeftButtonUp="ClicarSugestao">
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4">
                                        <TextBlock Text="{Binding Valor}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalhe}" FontSize="12" Foreground="#555555" TextWrapping="Wrap" />
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                            <ItemsControl ItemsSource="{Binding EscolasDoContrato}" Focusable="False" Margin="0,6,0,0"
                                          Visibility="{Binding TemEscolasParaEscolher, Converter={StaticResource Visivel}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotaoLink}" Content="{Binding Empreendimento}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                Command="{Binding DataContext.EscolherObraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="Escolher esta escola" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lote" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoLote" Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Lote" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoLote}" AutomationProperties.Name="Apagar Lote" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Portaria" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoPortaria" Text="{Binding Portaria, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Portaria" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoPortaria}" AutomationProperties.Name="Apagar Portaria" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Processo SEI" Style="{StaticResource Rotulo}" TextTrimming="CharacterEllipsis" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoProcessoSei" Text="{Binding ProcessoSei, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Processo SEI" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoProcessoSei}" AutomationProperties.Name="Apagar Processo SEI" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Data da OS" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoDataOsTexto" Text="{Binding DataOsTexto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data da OS" t:Mascaras.Data="True" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoDataOsTexto}" AutomationProperties.Name="Apagar Data da OS" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Fiscal" Style="{StaticResource Rotulo}" />
                            <Grid>
                                <TextBox Padding="8,6,34,6" x:Name="CampoResponsavel" Text="{Binding Responsavel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fiscal" />
                                <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoResponsavel}" AutomationProperties.Name="Apagar Fiscal" Click="ApagarCampo" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Objeto" Style="{StaticResource Rotulo}" Margin="0,12,0,6" />
                    <Grid>
                        <TextBox Padding="8,6,34,6" x:Name="CampoObjeto" Text="{Binding Objeto, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Objeto ou serviço" />
                        <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoObjeto}" AutomationProperties.Name="Apagar Objeto" Click="ApagarCampo" />
                    </Grid>

                    <TextBlock Text="Descrição geral" Style="{StaticResource Rotulo}" Margin="0,12,0,6" />
                    <Grid>
                        <TextBox Padding="8,6,34,6" x:Name="CampoDescricao" Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" SpellCheck.IsEnabled="True" Language="pt-BR" AutomationProperties.Name="Descrição geral"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />
                        <Button Style="{StaticResource BorrachaRelatorio}" Tag="{Binding ElementName=CampoDescricao}" AutomationProperties.Name="Apagar Descrição geral" Click="ApagarCampo" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,16,0,0" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============ Etapa 2: Fotos e textos ============ -->
        <ScrollViewer x:Name="RolagemFotos" Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      Visibility="{Binding EtapaFotos, Converter={StaticResource Visivel}}">
        <StackPanel>
            <!-- O que vai embaixo de cada foto: escolhido antes de escrever -->
            <Border x:Name="TopoModo" Style="{StaticResource Painel}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="O que vai escrito embaixo de cada foto" Style="{StaticResource TituloPainel}" />
                    <TextBlock Text="Escolha antes de escrever: muda os campos de cada foto e quantas fotos cabem por página. Pode trocar depois sem perder nada do que escreveu."
                               Style="{StaticResource Texto2}" TextWrapping="Wrap" Margin="0,2,0,10" />
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="ModoLegenda" Style="{StaticResource CartaoOpcao}" Margin="0,0,6,0" GroupName="ModoTexto"
                                     AutomationProperties.Name="Só legenda, até 6 fotos por página"
                                     IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=LegendaCurta}">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="34" Height="44" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Canvas Width="34" Height="44">
                                        <Rectangle Width="34" Height="44" Fill="White" Stroke="#8F8F8A" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="4" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="6" Canvas.Top="11.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="4" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="20" Canvas.Top="11.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="16.5" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="6" Canvas.Top="24" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="16.5" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="20" Canvas.Top="24" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="29" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="6" Canvas.Top="36.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="29" Width="12" Height="6.5" Fill="#9FB3C2" /><Rectangle Canvas.Left="20" Canvas.Top="36.5" Width="8" Height="1.6" Fill="#231F20" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="Só legenda" FontWeight="Bold" />
                                    <Border Background="#EDEDEA" CornerRadius="5" Padding="8,2" Margin="0,4" HorizontalAlignment="Left">
                                        <TextBlock Text="até 6 fotos por página" FontSize="13" FontWeight="SemiBold" Foreground="#3D3D42" />
                                    </Border>
                                    <TextBlock Text="Uma frase curta em negrito embaixo da foto. Ex.: “Concretagem do bloco B1”." Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModoDescricao" Style="{StaticResource CartaoOpcao}" Margin="6,0,0,0" GroupName="ModoTexto"
                                     AutomationProperties.Name="Legenda e descrição do serviço, até 4 fotos por página"
                                     IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=DescricaoServico}">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="34" Height="44" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Canvas Width="34" Height="44">
                                        <Rectangle Width="34" Height="44" Fill="White" Stroke="#8F8F8A" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="4" Width="12" Height="8" Fill="#9FB3C2" /><Rectangle Canvas.Left="6" Canvas.Top="13.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="16.5" Width="12" Height="1" Fill="#8F8F8A" /><Rectangle Canvas.Left="4" Canvas.Top="18.6" Width="12" Height="1" Fill="#8F8F8A" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="4" Width="12" Height="8" Fill="#9FB3C2" /><Rectangle Canvas.Left="20" Canvas.Top="13.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="16.5" Width="12" Height="1" Fill="#8F8F8A" /><Rectangle Canvas.Left="18" Canvas.Top="18.6" Width="12" Height="1" Fill="#8F8F8A" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="23" Width="12" Height="8" Fill="#9FB3C2" /><Rectangle Canvas.Left="6" Canvas.Top="32.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="4" Canvas.Top="35.5" Width="12" Height="1" Fill="#8F8F8A" /><Rectangle Canvas.Left="4" Canvas.Top="37.6" Width="12" Height="1" Fill="#8F8F8A" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="23" Width="12" Height="8" Fill="#9FB3C2" /><Rectangle Canvas.Left="20" Canvas.Top="32.5" Width="8" Height="1.6" Fill="#231F20" />
                                        <Rectangle Canvas.Left="18" Canvas.Top="35.5" Width="12" Height="1" Fill="#8F8F8A" /><Rectangle Canvas.Left="18" Canvas.Top="37.6" Width="12" Height="1" Fill="#8F8F8A" />
                                    </Canvas>
                                </Viewbox>
                                <StackPanel>
                                    <TextBlock Text="Legenda e descrição do serviço" FontWeight="Bold" />
                                    <Border Background="#231F20" CornerRadius="5" Padding="8,2" Margin="0,4" HorizontalAlignment="Left">
                                        <TextBlock Text="até 4 fotos por página" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="A legenda em negrito e, embaixo, um texto mais detalhado do serviço feito. Precisa de mais espaço, por isso cabem menos fotos."
                                               Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border Background="{StaticResource LaranjaClaro}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding AvisoDescricoesGuardadas, Converter={StaticResource VisivelSe}}">
                        <TextBlock Text="{Binding AvisoDescricoesGuardadas}" TextWrapping="Wrap" Foreground="#5E2E00" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Painel}">
                <DockPanel>
                    <StackPanel x:Name="TopoLista" DockPanel.Dock="Top">
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{StaticResource BotaoSecundario}" Content="Adicionar fotos" Margin="0,0,8,8" Command="{Binding AdicionarFotosCommand}" />
                        <Button Style="{StaticResource BotaoSecundario}" Content="Adicionar uma pasta" Margin="0,0,24,8" Command="{Binding AdicionarPastaCommand}" />
                        <Button Style="{StaticResource BotaoLinha}" Content="Ordenar pelo nome" MinHeight="44" Margin="0,0,8,8" Command="{Binding OrdenarPorNomeCommand}"
                                Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}" />
                        <Button Style="{StaticResource BotaoLinha}" Content="Ordenar pela data da foto" MinHeight="44" Margin="0,0,8,8" Command="{Binding OrdenarPorDataCommand}"
                                ToolTip="Usa a data em que a foto foi tirada; fotos sem essa data vão para o fim"
                                Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}" />
                    </WrapPanel>

                    <!-- Marcadas e mesmo texto para varias fotos -->
                    <Border Background="{StaticResource Fundo}" CornerRadius="10" Padding="14,12" Margin="0,0,0,10"
                            Visibility="{Binding TemFotos, Converter={StaticResource Visivel}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button x:Name="TirarMarcadas" DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" MinHeight="40" Padding="14,0"
                                        Content="{Binding TextoTirarMarcadas}" Command="{Binding TirarMarcadasCommand}" BorderBrush="{StaticResource VermelhoEscuro}"
                                        Foreground="{StaticResource VermelhoEscuro}" Visibility="{Binding TemMarcadas, Converter={StaticResource Visivel}}"
                                        ToolTip="As fotos não são apagadas do computador; dá para desfazer logo depois" />
                                <Border x:Name="SeloMarcadas" CornerRadius="6" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#E2E2DF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemMarcadas}" Value="True"><Setter Property="Background" Value="{StaticResource Azul}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TextoMarcadas}" FontWeight="Bold" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#3D3D42" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemMarcadas}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <Button Style="{StaticResource BotaoLinha}" Content="Marcar todas" MinHeight="40" Margin="0,0,8,0" Command="{Binding SelecionarTodasCommand}" />
                                <Button Style="{StaticResource BotaoLinha}" Content="Desmarcar todas" MinHeight="40" Margin="0,0,8,0" Command="{Binding DesmarcarTodasCommand}"
                                        Visibility="{Binding TemMarcadas, Converter={StaticResource Visivel}}" />
                                <TextBlock Text="Marque na caixinha de cada foto para escolher quais recebem o texto." Style="{StaticResource Texto2}" FontSize="13"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding TemMarcadas, Converter={StaticResource VisivelSeNao}}" />
                            </DockPanel>
                            <TextBlock Text="Mesmo texto para várias fotos" FontWeight="Bold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Width="420" Margin="0,0,10,0" Visibility="{Binding ModoDescricao, Converter={StaticResource Visivel}}">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Texto2}" FontSize="13"
                                                       Text="{Binding Text.Length, ElementName=DescricaoLote, StringFormat={}{0} de 300}" />
                                            <TextBlock Text="Descrição do serviço" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBox x:Name="DescricaoLote" Text="{Binding DescricaoEmLote, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" TextWrapping="Wrap"
                                                 MaxHeight="64" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Language="pt-BR"
                                                 AutomationProperties.Name="Descrição do serviço para várias fotos" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Texto2}" FontSize="13"
                                                       Text="{Binding Text.Length, ElementName=LegendaLote, StringFormat={}{0} de 100}" />
                                            <TextBlock Text="Legenda" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBox x:Name="LegendaLote" Text="{Binding LegendaEmLote, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                                 SpellCheck.IsEnabled="True" Language="pt-BR" AutomationProperties.Name="Legenda para várias fotos" />
                                    </StackPanel>
                                </DockPanel>
                                <Button Grid.Column="1" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Top" Margin="0,22,0,0" MinHeight="40"
                                        Content="{Binding TextoBotaoLote}" Command="{Binding AplicarTextoEmLoteCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding NotaDoLote}" Style="{StaticResource Texto2}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Problemas}" ItemTemplate="{StaticResource AvisoModelo}" Focusable="False" />
                    </StackPanel>

                    <!-- A lista ocupa o que sobra da janela (no minimo 340); em janela baixa a pagina rola -->
                    <Grid>
                        <Grid.Height>
                            <MultiBinding Converter="{StaticResource AlturaQueSobra}" ConverterParameter="340">
                                <Binding ElementName="RolagemFotos" Path="ViewportHeight" />
                                <Binding ElementName="TopoModo" Path="ActualHeight" />
                                <Binding ElementName="TopoLista" Path="ActualHeight" />
                                <Binding Source="56" />
                            </MultiBinding>
                        </Grid.Height>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding TemFotos, Converter={StaticResource VisivelSeNao}}">
                            <TextBlock Text="Arraste as fotos ou uma pasta para cá" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="ou use os botões acima. Aceita JPG, PNG, BMP, WEBP e GIF." Style="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <ListBox x:Name="ListaFotos" ItemsSource="{Binding Fotos}" Style="{StaticResource ListaSimples}"
                                 PreviewMouseLeftButtonDown="IniciarArrasteFoto" PreviewMouseMove="ArrastarFoto"
                                 DragOver="MarcarDestinoFoto" Drop="SoltarFoto" DragLeave="SairArrasteFoto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,2,0,2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selecionada}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AzulClaro}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selecionada}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="Marcar esta foto" />
                                        <Border Grid.Column="1" Width="150" Height="112" Background="{StaticResource Fundo}" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Image Source="{Binding Miniatura, Converter={StaticResource Imagem}, ConverterParameter=300}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Rotulo}" FontWeight="Bold" FontSize="15" />
                                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caminho}" Style="{StaticResource Texto2}" FontSize="13" />
                                            <TextBlock x:Name="Detalhe" Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="Localizar…" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                    Command="{Binding DataContext.LocalizarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding Faltando, Converter={StaticResource Visivel}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="0,0,12,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock x:Name="ContaLegenda" DockPanel.Dock="Right" Text="{Binding ContadorLegenda}" Style="{StaticResource Texto2}" FontSize="13" />
                                                <TextBlock><Run Text="Legenda" FontWeight="SemiBold" /><Run Text="  em negrito, embaixo da foto" Foreground="{StaticResource Secundario}" FontSize="13" /></TextBlock>
                                            </DockPanel>
                                            <TextBox Text="{Binding Legenda, UpdateSourceTrigger=PropertyChanged, Delay=400}" MaxLength="100" SpellCheck.IsEnabled="True" Language="pt-BR"
                                                     AutomationProperties.Name="Legenda da foto" />
                                            <StackPanel Visibility="{Binding DataContext.ModoDescricao, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visivel}}">
                                                <DockPanel Margin="0,10,0,4">
                                                    <TextBlock x:Name="ContaDescricao" DockPanel.Dock="Right" Text="{Binding ContadorDescricao}" Style="{StaticResource Texto2}" FontSize="13" />
                                                    <TextBlock><Run Text="Descrição do serviço" FontWeight="SemiBold" /><Run Text="  texto detalhado, embaixo da legenda" Foreground="{StaticResource Secundario}" FontSize="13" /></TextBlock>
                                                </DockPanel>
                                                <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged, Delay=400}" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="True"
                                                         MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="True" Language="pt-BR"
                                                         AutomationProperties.Name="Descrição do serviço da foto" />
                                            </StackPanel>
                                        </StackPanel>
                                        <UniformGrid Grid.Column="4" Columns="3" VerticalAlignment="Top">
                                            <Button Style="{StaticResource BotaoLinha}" Content="⟲" ToolTip="Girar para a esquerda" AutomationProperties.Name="Girar para a esquerda" Margin="0,0,4,4" MinHeight="38" MinWidth="38"
                                                    Command="{Binding DataContext.GirarEsquerdaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="⟳" ToolTip="Girar para a direita" AutomationProperties.Name="Girar para a direita" Margin="0,0,4,4" MinHeight="38" MinWidth="38"
                                                    Command="{Binding DataContext.GirarDireitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="✕" ToolTip="Tirar do relatório (a foto não é apagada; dá para desfazer)" AutomationProperties.Name="Tirar do relatório" Margin="0,0,0,4" MinHeight="38" MinWidth="38"
                                                    Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="↑" ToolTip="Subir na ordem" AutomationProperties.Name="Subir na ordem" Margin="0,0,4,0" MinHeight="38" MinWidth="38"
                                                    Command="{Binding DataContext.SubirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="↓" ToolTip="Descer na ordem" AutomationProperties.Name="Descer na ordem" Margin="0,0,4,0" MinHeight="38" MinWidth="38"
                                                    Command="{Binding DataContext.DescerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </UniformGrid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Faltando}" Value="True">
                                            <Setter TargetName="Detalhe" Property="Foreground" Value="{StaticResource Vermelho}" />
                                            <Setter TargetName="Detalhe" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LegendaPertoDoLimite}" Value="True">
                                            <Setter TargetName="ContaLegenda" Property="Foreground" Value="{StaticResource Laranja}" />
                                            <Setter TargetName="ContaLegenda" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DescricaoPertoDoLimite}" Value="True">
                                            <Setter TargetName="ContaDescricao" Property="Foreground" Value="{StaticResource Laranja}" />
                                            <Setter TargetName="ContaDescricao" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Desfazer: 5 segundos, com a faixa vermelha do tempo -->
                        <Border x:Name="BarraDesfazer" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" MinWidth="460" Background="#231F20"
                                CornerRadius="10" Padding="18,0,8,0" Height="52" Visibility="{Binding TemDesfazer, Converter={StaticResource Visivel}}">
                            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" /></Border.Effect>
                            <Grid>
                                <DockPanel VerticalAlignment="Center">
                                    <Button DockPanel.Dock="Right" Content="Desfazer" Command="{Binding DesfazerCommand}" Style="{StaticResource BotaoLinha}" MinHeight="38"
                                            Background="Transparent" Foreground="White" BorderBrush="White" FontWeight="Bold" Padding="14,0" Margin="18,0,0,0" />
                                    <TextBlock Text="{Binding TextoDesfazer}" Foreground="White" FontSize="15" VerticalAlignment="Center" />
                                </DockPanel>
                                <Rectangle x:Name="TempoDesfazer" Height="4" VerticalAlignment="Bottom" Margin="-18,0,-8,0" Fill="{StaticResource Vermelho}" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleX="1" /></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- ============ Etapa 3: Conferencia e geracao ============ -->
        <Grid Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20">
                        <TextBlock Text="Como fica a página" Style="{StaticResource TituloPainel}" Margin="0,0,0,10" />

                        <TextBlock Text="Fotos por página" Style="{StaticResource Rotulo}" />
                        <ItemsControl ItemsSource="{Binding OpcoesDeCapacidade}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Opcao" Content="{Binding Texto}" MinWidth="44" MinHeight="40" Margin="0,0,8,8" ToolTip="{Binding Dica}"
                                            AutomationProperties.Name="{Binding Dica}" IsEnabled="{Binding Habilitada}" Style="{StaticResource BotaoLinha}" FontWeight="SemiBold"
                                            Command="{Binding DataContext.EscolherCapacidadeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Marcada}" Value="True">
                                            <Setter TargetName="Opcao" Property="Background" Value="{StaticResource Preto}" />
                                            <Setter TargetName="Opcao" Property="Foreground" Value="White" />
                                            <Setter TargetName="Opcao" Property="BorderBrush" Value="{StaticResource Preto}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource Fundo}" CornerRadius="8" Padding="12,8" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TextoDoModoNaConferencia}" TextWrapping="Wrap" FontSize="13.5" />
                                <Button Style="{StaticResource BotaoLink}" Content="Mudar no passo 2" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding IrParaFotosCommand}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Assinaturas" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                        <CheckBox Content="Espaço para assinaturas no fim" IsChecked="{Binding Assinaturas}" />
                        <TextBlock Text="A assinatura fica sempre na mesma página da última foto, nunca sozinha numa página." Style="{StaticResource Texto2}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Assinaturas, Converter={StaticResource Visivel}}" />
                        <StackPanel Visibility="{Binding Assinaturas, Converter={StaticResource Visivel}}" Margin="0,6,0,0">
                            <TextBlock Text="Nome sob “Fiscalização SPOBRAS” (opcional)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding AssinaturaFiscal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do fiscal" />
                            <TextBlock Text="Nome sob “Contratada” (opcional)" Style="{StaticResource Rotulo}" Margin="0,8,0,6" />
                            <TextBox Text="{Binding AssinaturaContratada, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do representante da contratada" />
                        </StackPanel>

                        <TextBlock Text="Peso das fotos no arquivo" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                        <RadioButton GroupName="QualidadeRel" Content="Alta (arquivo maior, melhor impressão)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Alta}" />
                        <RadioButton GroupName="QualidadeRel" Content="Média (recomendado)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Media}" />
                        <RadioButton GroupName="QualidadeRel" Content="Leve (bom para enviar por e-mail)"
                                     IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Leve}" />
                        <TextBlock Text="As fotos originais nunca são alteradas: o relatório usa cópias." Style="{StaticResource Texto2}" FontSize="13" Margin="0,4,0,0" />

                        <TextBlock Text="Gerar" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                        <RadioButton GroupName="FormatoRel" Content="Excel e PDF" IsChecked="{Binding FormatoDeSaida, Converter={StaticResource EnumIgual}, ConverterParameter=ExcelEPdf}" />
                        <RadioButton GroupName="FormatoRel" Content="Só PDF" IsChecked="{Binding FormatoDeSaida, Converter={StaticResource EnumIgual}, ConverterParameter=SoPdf}" />
                        <RadioButton GroupName="FormatoRel" Content="Só Excel" IsChecked="{Binding FormatoDeSaida, Converter={StaticResource EnumIgual}, ConverterParameter=SoExcel}" />
                        <TextBlock Text="O PDF é montado pelo próprio app, sempre em A4, sem precisar do Excel." Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="Sem logo cadastrado: o relatório sai sem logo. Para incluir, escolha a imagem em Configurações."
                                   Style="{StaticResource Texto2}" FontSize="13" Margin="0,10,0,0" Visibility="{Binding TemLogo, Converter={StaticResource VisivelSeNao}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Resumo}" Style="{StaticResource Forte}" VerticalAlignment="Center" />
                        <TextBlock Text="Prévia das páginas" Style="{StaticResource TituloPainel}" />
                    </DockPanel>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Fundo}" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Paginas}" Margin="8" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding Titulo}" Style="{StaticResource Texto2}" FontSize="13" Margin="0,0,0,4" />
                                        <Border Background="White" BorderBrush="{StaticResource Borda}" BorderThickness="1">
                                            <Viewbox Width="340" Stretch="Uniform">
                                                <ItemsControl ItemsSource="{Binding Elementos}" Width="{Binding Largura}" Height="{Binding Altura}" Focusable="False"
                                                              FontFamily="Calibri, Carlito, Segoe UI" Foreground="Black" ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                            <Setter Property="Width" Value="{Binding Largura}" />
                                                            <Setter Property="Height" Value="{Binding Altura}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Fundo, TargetNullValue=Transparent}" BorderBrush="{Binding Borda, TargetNullValue=Transparent}" BorderThickness="{Binding Espessura}">
                                                                <Grid>
                                                                    <Image x:Name="Img" Source="{Binding Imagem, Converter={StaticResource Imagem}, ConverterParameter=360}" Stretch="Uniform" Visibility="Collapsed" />
                                                                    <TextBlock x:Name="Txt" Text="{Binding Texto}" FontSize="{Binding Fonte}" Foreground="{Binding Cor}" TextWrapping="NoWrap"
                                                                               LineHeight="{Binding AlturaDaLinha}" LineStackingStrategy="BlockLineHeight"
                                                                               VerticalAlignment="Top" TextAlignment="Left" />
                                                                    <TextBlock x:Name="Falta" Text="Foto não encontrada" Foreground="{StaticResource Vermelho}" FontWeight="Bold" FontSize="10"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding TemImagem}" Value="True">
                                                                    <Setter TargetName="Img" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Txt" Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Negrito}" Value="True">
                                                                    <Setter TargetName="Txt" Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Centro}" Value="True">
                                                                    <Setter TargetName="Txt" Property="TextAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Meio}" Value="True">
                                                                    <Setter TargetName="Txt" Property="VerticalAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Faltando}" Value="True">
                                                                    <Setter TargetName="Falta" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Viewbox>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Rodape: salvar em + acao da etapa -->
        <Border Grid.Row="3" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                            Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultadoModelo}" VerticalAlignment="Center" Focusable="False" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource BotaoSecundario}" Content="Voltar" Margin="0,0,12,0" Command="{Binding VoltarCommand}"
                            Visibility="{Binding EtapaDados, Converter={StaticResource VisivelSeNao}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="Gerar relatório" Margin="12,0,0,0" Command="{Binding GerarCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotaoAvancar}" Margin="12,0,0,0" Command="{Binding AvancarCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource VisivelSeNao}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}"
                            Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding EtapaConferencia, Converter={StaticResource VisivelSeNao}}">
                            <TextBlock Text="Rascunho salvo automaticamente." Style="{StaticResource Texto2}" />
                        </StackPanel>
                        <Grid Visibility="{Binding EtapaConferencia, Converter={StaticResource Visivel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Salvar em" Style="{StaticResource Texto2}" FontSize="13" />
                                <TextBlock Text="{Binding PastaDestino}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PastaDestino}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{Binding NomeArquivo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do arquivo do relatório"
                                     ToolTip="Nome do arquivo (sem a extensão)" />
                        </Grid>
                    </Grid>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
