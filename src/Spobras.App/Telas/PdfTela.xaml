<UserControl x:Class="Spobras.App.Telas.PdfTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="AoSoltar" DragOver="AoArrastar" Background="Transparent">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PDF" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Escolha o que você quer fazer. O resultado é sempre um arquivo novo: o original não é alterado."
                       Style="{StaticResource Texto2}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Ferramenta primeiro -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="-6,16,-6,-12">
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=Juntar}">
                <StackPanel>
                    <TextBlock Text="Juntar PDFs" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Vários PDFs viram um só, na ordem que você escolher." Style="{StaticResource Texto2}" FontSize="13" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=Separar}">
                <StackPanel>
                    <TextBlock Text="Separar PDF" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Tira páginas ou trechos de um PDF para arquivos próprios." Style="{StaticResource Texto2}" FontSize="13" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=FotosEmPdf}">
                <StackPanel>
                    <TextBlock Text="Fotos em PDF" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Cada foto vira uma página, inteira e na posição certa." Style="{StaticResource Texto2}" FontSize="13" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=Reduzir}">
                <StackPanel>
                    <TextBlock Text="Reduzir tamanho" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Deixa o PDF mais leve para enviar, numa cópia." Style="{StaticResource Texto2}" FontSize="13" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=LogoENumeracao}">
                <StackPanel>
                    <TextBlock Text="Logo e numeração" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Número de página e logo numa cópia de um PDF pronto." Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource CartaoOpcao}" GroupName="FerramentaPdf" Margin="6,0,6,12"
                         IsChecked="{Binding Ferramenta, Converter={StaticResource EnumIgual}, ConverterParameter=ParaExcel}">
                <StackPanel>
                    <TextBlock Text="PDF para Excel" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="Texto e tabelas de PDF ou foto de documento numa planilha, inclusive escaneados." Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Opcoes da ferramenta escolhida -->
            <Border Style="{StaticResource Painel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20">
                        <TextBlock Text="Opções" Style="{StaticResource TituloPainel}" Margin="0,0,0,10" />

                        <StackPanel Visibility="{Binding PedeNome, Converter={StaticResource Visivel}}">
                            <TextBlock Text="Nome do PDF novo" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding NomeSaida, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do PDF novo" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EhJuntar, Converter={StaticResource Visivel}}" Margin="0,12,0,0">
                            <TextBlock Text="Use as setas da lista ao lado para acertar a ordem." Style="{StaticResource Texto2}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EhSeparar, Converter={StaticResource Visivel}}">
                            <RadioButton GroupName="ModoSeparar" Content="Um arquivo para cada página" IsChecked="{Binding SepararCadaPagina}" />
                            <RadioButton GroupName="ModoSeparar" Content="Só as páginas que eu indicar" IsChecked="{Binding PorIntervalos, Mode=OneWay}" x:Name="OpcaoIntervalos" Checked="AoEscolherIntervalos" />
                            <StackPanel Visibility="{Binding PorIntervalos, Converter={StaticResource Visivel}}" Margin="0,8,0,0">
                                <TextBlock Text="Páginas" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding Intervalos, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Páginas a separar" />
                                <TextBlock Text="Exemplo: 1-3, 5, 8-  (cada trecho vira um arquivo; “8-” vai até o fim)." Style="{StaticResource Texto2}" FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding EhCarimbo, Converter={StaticResource Visivel}}">
                            <CheckBox Content="Numerar as páginas" IsChecked="{Binding Numerar}" />
                            <StackPanel Visibility="{Binding Numerar, Converter={StaticResource Visivel}}" Margin="0,6,0,0">
                                <TextBlock Text="Onde vai o número" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Posicoes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding PosicaoNumero}"
                                          AutomationProperties.Name="Posição do número da página" />
                                <TextBlock Text="Fica assim: “Página 2 de 10”." Style="{StaticResource Texto2}" FontSize="13" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox Content="Colocar o logo" IsChecked="{Binding ComLogo}" IsEnabled="{Binding TemLogo}" Margin="0,12,0,0" />
                            <TextBlock Text="Cadastre o logo em Configurações para usar esta opção." Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap"
                                       Visibility="{Binding TemLogo, Converter={StaticResource VisivelSeNao}}" />
                            <StackPanel Visibility="{Binding ComLogo, Converter={StaticResource Visivel}}" Margin="0,6,0,0">
                                <TextBlock Text="Onde vai o logo" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding Posicoes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding PosicaoLogo}"
                                          AutomationProperties.Name="Posição do logo" />
                            </StackPanel>
                            <TextBlock Text="A partir da página" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding APartirDa, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="A partir da página" />
                            <TextBlock Text="Use 2 para deixar a capa sem marca." Style="{StaticResource Texto2}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding EhParaExcel, Converter={StaticResource Visivel}}">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Texto2}"
                                       Text="Cada arquivo vira uma planilha com o mesmo nome. Valores em reais e datas viram número e data do Excel; NE, SEI e dotações ficam como texto. Páginas escaneadas e fotos são lidas pelo OCR do Windows, no próprio computador. Confira antes de usar." />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EhFotos}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding EhReduzir}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Qualidade das fotos" Style="{StaticResource Rotulo}" />
                            <RadioButton GroupName="QualidadePdf" IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Alta}"
                                         Content="Alta (arquivo maior, bom para imprimir)" />
                            <RadioButton GroupName="QualidadePdf" IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Media}"
                                         Content="Média (equilíbrio)" />
                            <RadioButton GroupName="QualidadePdf" IsChecked="{Binding Qualidade, Converter={StaticResource EnumIgual}, ConverterParameter=Leve}"
                                         Content="Leve (arquivo menor, bom para enviar)" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Entradas -->
            <Border Grid.Column="2" Style="{StaticResource Painel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Limpar lista" Margin="8,0,0,0" MinHeight="44" Command="{Binding LimparCommand}"
                                Visibility="{Binding TemEntradas, Converter={StaticResource Visivel}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="{Binding TextoAdicionar}" Margin="8,0,0,0" Command="{Binding AdicionarArquivosCommand}" />
                        <TextBlock Text="{Binding TituloEntradas}" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding TemEntradas, Converter={StaticResource VisivelSeNao}}">
                            <TextBlock Text="{Binding TextoVazio}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="ou use o botão acima." Style="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Entradas}" Style="{StaticResource ListaSimples}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource BotaoLinha}" Content="↑" ToolTip="Subir na ordem" AutomationProperties.Name="Subir na ordem" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.SubirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.PodeOrdenar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visivel}}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="↓" ToolTip="Descer na ordem" AutomationProperties.Name="Descer na ordem" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DescerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.PodeOrdenar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visivel}}" />
                                            <Button Style="{StaticResource BotaoLinha}" Content="✕" ToolTip="Tirar da lista (o arquivo não é apagado)" AutomationProperties.Name="Tirar da lista"
                                                    Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caminho}" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                            Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ResultadoModelo}" VerticalAlignment="Center" Focusable="False" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotao}" Margin="8,0,0,0" Command="{Binding ExecutarCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Salvar em" Style="{StaticResource Texto2}" FontSize="13" />
                        <TextBlock Text="{Binding PastaDestino}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PastaDestino}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
