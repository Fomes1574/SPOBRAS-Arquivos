<UserControl x:Class="Spobras.App.Telas.CompactarTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="AoSoltar" DragOver="AoArrastar" Background="Transparent">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Compactar" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Cria vários arquivos .zip de uma vez e também descompacta vários. Os arquivos originais não são alterados."
                       Style="{StaticResource Texto2}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Painel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="20">
                        <TextBlock Text="Como compactar" Style="{StaticResource TituloPainel}" Margin="0,0,0,10" />

                        <RadioButton GroupName="ModoCompactar" IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=UmPorPasta}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Um zip para cada pasta" FontWeight="SemiBold" />
                                <TextBlock Text="Cada pasta vira um .zip com o mesmo nome." Style="{StaticResource Texto2}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ModoCompactar" IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=Unico}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Tudo num zip só" FontWeight="SemiBold" />
                                <TextBlock Text="Junta os arquivos e pastas escolhidos num único .zip." Style="{StaticResource Texto2}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="ModoCompactar" IsChecked="{Binding Modo, Converter={StaticResource EnumIgual}, ConverterParameter=PorLimite}">
                            <StackPanel>
                                <TextBlock Text="Dividir em partes" FontWeight="SemiBold" />
                                <TextBlock Text="Vários .zip independentes, cada um dentro do limite do e-mail ou do WhatsApp. Cada parte abre sozinha." Style="{StaticResource Texto2}" FontSize="13" />
                            </StackPanel>
                        </RadioButton>

                        <StackPanel Visibility="{Binding PedeNome, Converter={StaticResource Visivel}}" Margin="0,16,0,0">
                            <TextBlock Text="Nome do .zip" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding NomeZip, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do zip" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModoPorLimite, Converter={StaticResource Visivel}}" Margin="0,12,0,0">
                            <TextBlock Text="Tamanho máximo de cada parte (em MB)" Style="{StaticResource Rotulo}" />
                            <TextBox Text="{Binding LimiteMb, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Tamanho máximo de cada parte em megabytes" />
                            <TextBlock Text="Você escolhe o limite conforme o serviço por onde vai enviar." Style="{StaticResource Texto2}" FontSize="13" Margin="0,6,0,0" />
                        </StackPanel>

                        <CheckBox Content="Reduzir as fotos (cópias)" IsChecked="{Binding ReduzirFotos}" Margin="0,16,0,0"
                                  ToolTip="As fotos JPG entram no zip como cópias menores. As fotos originais não mudam." />
                        <StackPanel Visibility="{Binding ReduzirFotos, Converter={StaticResource Visivel}}" Margin="22,6,0,0">
                            <RadioButton GroupName="QualidadeZip" Content="Alta (para imprimir)" IsChecked="{Binding QualidadeFotos, Converter={StaticResource EnumIgual}, ConverterParameter=Alta}" />
                            <RadioButton GroupName="QualidadeZip" Content="Média" IsChecked="{Binding QualidadeFotos, Converter={StaticResource EnumIgual}, ConverterParameter=Media}" />
                            <RadioButton GroupName="QualidadeZip" Content="Leve (para enviar)" IsChecked="{Binding QualidadeFotos, Converter={StaticResource EnumIgual}, ConverterParameter=Leve}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Painel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Limpar lista" Margin="8,0,0,0" MinHeight="44" Command="{Binding LimparCommand}"
                                Visibility="{Binding TemEntradas, Converter={StaticResource Visivel}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar arquivos" Margin="8,0,0,0" Command="{Binding AdicionarArquivosCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Adicionar pastas" Margin="8,0,0,0" Command="{Binding AdicionarPastasCommand}" />
                        <TextBlock Text="O que vai ser compactado" Style="{StaticResource TituloPainel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding TemEntradas, Converter={StaticResource VisivelSeNao}}">
                            <TextBlock Text="Arraste pastas ou arquivos para cá" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="ou use os botões Adicionar pastas e Adicionar arquivos, acima." Style="{StaticResource Texto2}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Entradas}" Style="{StaticResource ListaSimples}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="✕" ToolTip="Tirar da lista (nada é apagado)" AutomationProperties.Name="Tirar da lista"
                                                Command="{Binding DataContext.RemoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Descricao}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caminho}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1" Text="Resultado previsto" Style="{StaticResource Forte}" Margin="0,12,0,4"
                                   Visibility="{Binding TemEntradas, Converter={StaticResource Visivel}}" />
                        <ListBox Grid.Row="2" ItemsSource="{Binding Previa}" Style="{StaticResource ListaSimples}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detalhe}" Style="{StaticResource Texto2}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Salvar em + acao -->
        <Border Grid.Row="2" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,10" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar na pasta" Margin="12,0,0,0" Command="{Binding AbrirResultadoCommand}"
                            Visibility="{Binding PodeAbrirResultado, Converter={StaticResource Visivel}}" />
                    <TextBlock Text="{Binding Resultado}" Style="{StaticResource Forte}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="{Binding TextoBotao}" Margin="8,0,0,0" Command="{Binding CriarCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Descompactar vários…" Margin="8,0,0,0" Command="{Binding DescompactarVariosCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Escolher outra pasta" Margin="12,0,0,0" Command="{Binding EscolherDestinoCommand}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Salvar em" Style="{StaticResource Texto2}" FontSize="13" />
                        <TextBlock Text="{Binding PastaDestino}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PastaDestino}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
