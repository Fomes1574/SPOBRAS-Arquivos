<UserControl x:Class="Spobras.App.Telas.FiltroMultiplo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz">
    <Grid>
        <Border BorderBrush="#B7B7B3" BorderThickness="1" CornerRadius="7" Background="White" Margin="0,7,0,0">
            <DockPanel>
                <Button x:Name="LimparSelecao" DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                        Content="✕" Width="28" MinHeight="36" Visibility="Collapsed"
                        AutomationProperties.Name="{Binding LimparNome, ElementName=Raiz}" Click="Limpar" />
                <ToggleButton x:Name="Abrir" MinHeight="36" Padding="8,0" Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Rotulo, ElementName=Raiz}">
                    <TextBlock x:Name="ResumoTexto" Text="{Binding Resumo, ElementName=Raiz}" TextTrimming="CharacterEllipsis" />
                </ToggleButton>
            </DockPanel>
        </Border>
        <TextBlock Text="{Binding Rotulo, ElementName=Raiz}" Foreground="#A50D26" Background="White"
                   FontWeight="SemiBold" FontSize="12" Padding="4,0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,0,0,0" />
        <Popup x:Name="FolhaOpcoes" PlacementTarget="{Binding ElementName=Abrir}" Placement="Bottom" StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=Abrir, Mode=TwoWay}" Opened="AoAbrir">
            <Border Background="White" BorderBrush="#999999" BorderThickness="1" CornerRadius="6" Padding="10" Width="290">
                <StackPanel>
                    <TextBox x:Name="Pesquisa" AutomationProperties.Name="Pesquisar opções"
                             TextChanged="AoPesquisar" />
                    <Button Style="{StaticResource BotaoLinha}" Content="Marcar todos os visíveis"
                            Margin="0,6,0,6" Click="MarcarVisiveis" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Opcoes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Marcada, Mode=OneWay}" Click="Alternar" Margin="0,4" ToolTip="{Binding Titulo}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detalhe}" FontSize="12" TextWrapping="Wrap"
                                                       Visibility="{Binding Detalhe, Converter={StaticResource VisivelSe}}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
