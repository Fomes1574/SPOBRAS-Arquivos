<UserControl x:Class="Spobras.App.Telas.BaseTela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Spobras.App.Telas"
             xmlns:b="clr-namespace:Spobras.Core.Base;assembly=Spobras.Core">
    <Grid Margin="40,32,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Fontes de dados" VerticalAlignment="Center" Margin="16,0,0,0"
                    Command="{Binding AbrirFontesCommand}" ToolTip="De onde vêm os dados, quando foram lidos e Reler agora" />
            <StackPanel>
                <TextBlock Text="Base de dados" Style="{StaticResource TituloPagina}" />
                <TextBlock Text="{Binding EstadoDaBase}" Style="{StaticResource Texto2}" Margin="0,4,0,0" />
                <Border CornerRadius="8" Padding="12,6" Margin="0,8,0,0" Background="{StaticResource LaranjaClaro}" HorizontalAlignment="Left"
                        Visibility="{Binding TemPendencias, Converter={StaticResource Visivel}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Ver obras sem Data da OS" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding VerObrasSemOsCommand}" />
                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="Pendências:  " FontWeight="Bold" Foreground="{StaticResource Laranja}" /><Run Text="{Binding Pendencias, Mode=OneWay}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Filtros recolhidos: uma linha so, com o que esta filtrado -->
        <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,10"
                Visibility="{Binding FiltrosRecolhidos, Converter={StaticResource Visivel}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar filtros" MinHeight="36" Command="{Binding AlternarFiltrosCommand}" />
                <TextBlock Text="Filtros:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding FiltrosAtivos}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FiltrosAtivos}" />
            </DockPanel>
        </Border>

        <!-- Filtros: cada escolha atualiza o resultado e as opcoes dos outros campos -->
        <Border Grid.Row="1" Style="{StaticResource Painel}" Margin="0,16,0,0" Padding="20,14"
                Visibility="{Binding FiltrosRecolhidos, Converter={StaticResource VisivelSeNao}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12" Visibility="{Binding PodeSalvarConsultas, Converter={StaticResource Visivel}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Tirar da lista" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding RemoverConsultaCommand}" Visibility="{Binding ConsultaAberta, Converter={StaticResource VisivelSe}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Salvar consulta" Margin="12,0,0,0" Command="{Binding SalvarConsultaCommand}"
                            ToolTip="Guarda estes filtros com um nome. Ao reabrir, a consulta usa os dados mais recentes." />
                    <TextBlock DockPanel.Dock="Left" Text="Consulta salva" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Consultas}" SelectedItem="{Binding ConsultaAberta}" DisplayMemberPath="Nome" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"
                              AutomationProperties.Name="Consulta salva" IsEnabled="{Binding TemConsultas}" ToolTip="Escolha uma consulta salva para aplicar os filtros dela" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Recolher" MinHeight="44" Margin="12,0,0,0" Command="{Binding AlternarFiltrosCommand}"
                            ToolTip="Recolhe os filtros numa linha para a lista e a ficha ficarem maiores" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Limpar filtros" Margin="12,0,0,0" Command="{Binding LimparFiltrosCommand}" />
                    <TextBlock DockPanel.Dock="Left" Text="Procurar" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Procurar por contrato, escola, contratada, lote ou processo"
                             ToolTip="Contrato, escola, contratada, lote, processo SEI ou escopo" />
                </DockPanel>

                <UniformGrid Rows="1" Margin="-6,12,-6,0">
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Portaria" Style="{StaticResource Rotulo}" />
                        <t:FiltroMultiplo Rotulo="Portaria" Plural="portarias" Itens="{Binding Portarias}" Selecionados="{Binding Portaria}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Contrato" Style="{StaticResource Rotulo}" />
                        <t:FiltroMultiplo Rotulo="Contrato" Plural="contratos" Itens="{Binding Contratos}" Selecionados="{Binding Contrato}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Escola" Style="{StaticResource Rotulo}" />
                        <t:FiltroMultiplo Rotulo="Escola" Plural="escolas" Itens="{Binding Escolas}" Selecionados="{Binding Escola}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Lote" Style="{StaticResource Rotulo}" />
                        <t:FiltroMultiplo Rotulo="Lote" Plural="lotes" Itens="{Binding Lotes}" Selecionados="{Binding Lote}" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Text="Empresa" Style="{StaticResource Rotulo}" />
                        <t:FiltroMultiplo Rotulo="Empresa" Plural="empresas" Itens="{Binding Empresas}" Selecionados="{Binding Empresa}" />
                    </StackPanel>
                </UniformGrid>

                <Expander Header="Mais filtros: contrato de receita, dotação, valores e Data da OS" Margin="0,12,0,0">
                    <StackPanel Margin="0,10,0,0">
                        <UniformGrid Rows="1" Margin="-6,0">
                            <StackPanel Margin="6,0">
                                <TextBlock Text="Contrato de receita" Style="{StaticResource Rotulo}" />
                                <t:FiltroMultiplo Rotulo="Contrato de receita" Plural="contratos de receita" Itens="{Binding ContratosReceita}" Selecionados="{Binding ContratoReceita}" />
                            </StackPanel>
                            <StackPanel Margin="6,0">
                                <TextBlock Text="Dotação (atividade)" Style="{StaticResource Rotulo}" />
                                <t:FiltroMultiplo Rotulo="Dotação" Plural="dotações" Itens="{Binding Dotacoes}" Selecionados="{Binding Dotacao}" />
                            </StackPanel>
                            <StackPanel Margin="6,0">
                                <TextBlock Text="Status da obra" Style="{StaticResource Rotulo}" />
                                <t:FiltroMultiplo Rotulo="Status da obra" Plural="status" Itens="{Binding Situacoes}" Selecionados="{Binding Status}" />
                            </StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,12,8" Width="250">
                                <TextBlock Text="Valor" Style="{StaticResource Rotulo}" />
                                <ComboBox ItemsSource="{Binding CamposDeValor}" DisplayMemberPath="Rotulo" SelectedItem="{Binding ValorFiltrado}" AutomationProperties.Name="Qual valor filtrar" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8" Width="140">
                                <TextBlock Text="A partir de (R$)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding ValorDe, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Valor mínimo em reais" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8" Width="140">
                                <TextBlock Text="Até (R$)" Style="{StaticResource Rotulo}" />
                                <TextBox Text="{Binding ValorAte, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Valor máximo em reais" />
                            </StackPanel>
                            <CheckBox Content="Sem informação de valor" IsChecked="{Binding ValorSemInformacao}" VerticalAlignment="Bottom" Margin="0,0,24,16" />
                            <StackPanel Margin="0,0,12,8" Width="140">
                                <TextBlock Text="Data da OS de" Style="{StaticResource Rotulo}" />
                                <TextBox t:Mascaras.Data="True" Text="{Binding OsDe, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Data da OS a partir de, dia mês ano" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8" Width="140">
                                <TextBlock Text="até" Style="{StaticResource Rotulo}" />
                                <TextBox t:Mascaras.Data="True" Text="{Binding OsAte, UpdateSourceTrigger=PropertyChanged, Delay=400}" AutomationProperties.Name="Data da OS até, dia mês ano" />
                            </StackPanel>
                            <CheckBox Content="Sem data da OS" IsChecked="{Binding SemDataOs}" VerticalAlignment="Bottom" Margin="0,0,24,16" />
                            <StackPanel Margin="0,0,12,8" Width="230">
                                <TextBlock Text="Ordenar por" Style="{StaticResource Rotulo}" />
                                <ComboBox SelectedValue="{Binding Ordem}" SelectedValuePath="Tag" AutomationProperties.Name="Ordenar por">
                                    <ComboBoxItem Content="Contrato" Tag="{x:Static b:OrdemObras.Contrato}" />
                                    <ComboBoxItem Content="Escola" Tag="{x:Static b:OrdemObras.Escola}" />
                                    <ComboBoxItem Content="Data da OS" Tag="{x:Static b:OrdemObras.DataOs}" />
                                    <ComboBoxItem Content="Maior saldo a pagar" Tag="{x:Static b:OrdemObras.SaldoAPagar}" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Texto2}" FontSize="13"
                                   Text="Os limites entram na faixa. Valor zero e valor sem informação são coisas diferentes. Os valores são os que a planilha traz para cada obra." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
        <!-- Totais do lote escolhido -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Painel}" Padding="20,10" Margin="0,0,0,12"
                Visibility="{Binding TemLote, Converter={StaticResource Visivel}}">
            <StackPanel>
                <TextBlock Text="{Binding TituloDoLote}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding TotaisDoLote}" Focusable="False" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Rotulo}" Style="{StaticResource Texto2}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Valor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Valor}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Grid x:Name="Divisao">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColunaLista" Width="2*" MinWidth="440" />
                <ColumnDefinition x:Name="ColunaDivisoria" Width="16" />
                <ColumnDefinition x:Name="ColunaFicha" Width="3*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="Divisoria" Grid.Column="1" Width="16" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" DragCompleted="AoSoltarDivisoria" Focusable="False"
                          ToolTip="Arraste para mudar o tamanho da lista e da ficha" AutomationProperties.Name="Divisória entre a lista e a ficha" />

            <!-- Resultados -->
            <Border x:Name="PainelLista" Style="{StaticResource Painel}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,4,26,6">
                        <TextBlock DockPanel.Dock="Right" Text="Saldo a pagar" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Obra" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="{Binding Resumo}" Style="{StaticResource Texto2}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding Obras.Count, Converter={StaticResource VisivelSeNao}}" />
                        <ListBox ItemsSource="{Binding Obras}" SelectedItem="{Binding Selecionada}" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource LinhaSelecionavel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Obras encontradas">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Duas linhas: o nome da escola inteiro em cima; contrato, status, lote e OS embaixo -->
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SaldoAPagar}" Margin="12,0,0,0" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Escola}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Marca}" FontSize="12" Foreground="{StaticResource Azul}" Visibility="{Binding Marca, Converter={StaticResource VisivelSe}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Ficha da obra escolhida -->
            <Border Grid.Column="2" Style="{StaticResource Painel}" Padding="0">
                <Grid>
                    <TextBlock Text="Clique numa obra para ver todos os dados dela." VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Texto2}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Selecionada}" Value="{x:Null}" />
                                            <Condition Binding="{Binding Editando}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selecionada}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Editando}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <DockPanel DockPanel.Dock="Top" Margin="20,14,20,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" MinHeight="40" Margin="8,0,0,0" Command="{Binding AlternarAmpliarCommand}"
                                    ToolTip="A ficha ocupa a área toda; clique de novo para voltar para o lado da lista">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⤢ Ampliar" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FichaAmpliada}" Value="True"><Setter Property="Text" Value="⤡ Voltar à lista" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Editar dados" MinHeight="40" Margin="8,0,0,0" Command="{Binding EditarObraCommand}"
                                    ToolTip="Mude qualquer dado desta obra no app. A planilha mestra não é alterada." />
                            <TextBlock Text="{Binding Selecionada.Marca}" Foreground="{StaticResource Azul}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="20,12,20,12">
                                <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Selecionada.Escola}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selecionada.Situacao}" Foreground="{StaticResource Azul}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6" />
                            <TextBlock Text="{Binding ResumoDasMedicoes}" Style="{StaticResource Texto2}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Button Style="{StaticResource BotaoSecundario}" Content="Usar no relatório fotográfico" Command="{Binding UsarNoRelatorioCommand}"
                                    ToolTip="Leva escola, contratada, contrato, lote, portaria, SEI e Data da OS para o relatório" />
                            <Button Style="{StaticResource BotaoSecundario}" Content="Usar no cronograma" Margin="0,8,0,0" Command="{Binding UsarNoCronogramaCommand}"
                                    ToolTip="Acrescenta esta obra ao cronograma, com o início na Data da OS" />
                            <Button Style="{StaticResource BotaoLinha}" Content="Buscar o contrato nos arquivos" Margin="0,8,0,0" MinHeight="44" Command="{Binding BuscarNosArquivosCommand}" CommandParameter="contrato"
                                    ToolTip="Procura o número do contrato dentro das planilhas, PDFs e documentos das suas pastas" />
                            <Button Style="{StaticResource BotaoSecundario}" Content="Usar em modelo Excel" Margin="0,8,0,0" Command="{Binding UsarEmModeloCommand}"
                                    ToolTip="Acrescenta esta obra à lista do modelo Excel selecionado, nos campos ligados à Base de dados" />
                        </StackPanel>
                            <!-- Valores (como na planilha) -->
                            <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,10,0,4">
                                <StackPanel>
                                    <TextBlock Text="Valores" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Selecionada.Valores.Campos}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,16,8">
                                                    <TextBlock Text="{Binding Key}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Medicoes em tramite desta escola (so contrato em andamento) -->
                            <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,10,0,8"
                                    Visibility="{Binding TemMedicoesEmTramite, Converter={StaticResource Visivel}}">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                        <Run Text="Medições em trâmite" /><Run Text="  ·  valor considerado + reajuste" FontWeight="Normal" FontSize="13" Foreground="{StaticResource Secundario}" />
                                    </TextBlock>
                                    <Grid Margin="0,8,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Nº" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Status da medição" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Valor" Style="{StaticResource Texto2}" FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding MedicoesEmTramiteDaObra}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Numero}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Valor}" FontWeight="SemiBold" TextAlignment="Right"
                                                                   ToolTip="{Binding Reajuste, StringFormat=Reajuste: {0}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalEmTramite}" FontWeight="Bold" />
                                        <TextBlock Text="Total em trâmite" FontWeight="Bold" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Selecionada.GruposSecundarios}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BordaClara}" BorderThickness="0,1,0,0" Padding="0,10,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Campos}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,16,8">
                                                                <TextBlock Text="{Binding Key}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Edicao da obra -->
                    <DockPanel Visibility="{Binding Editando, Converter={StaticResource Visivel}}" DataContext="{Binding}">
                        <StackPanel DockPanel.Dock="Top" Margin="20,14,20,8">
                            <TextBlock Text="{Binding Edicao.Titulo}" Style="{StaticResource TituloPainel}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Edicao.Explicacao}" Style="{StaticResource Texto2}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,16">
                            <TextBlock Text="{Binding Edicao.Problemas}" Foreground="{StaticResource Vermelho}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding Edicao.Problemas, Converter={StaticResource VisivelSe}}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" Content="Salvar" Margin="8,0,0,0" Command="{Binding SalvarEdicaoCommand}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Cancelar" Command="{Binding CancelarEdicaoCommand}" />
                                <Button Style="{StaticResource BotaoLink}" Content="Tirar do app" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding RemoverObraIncluidaCommand}"
                                        Visibility="{Binding Selecionada.Obra.IncluidaNoApp, Converter={StaticResource Visivel}}" />
                            </DockPanel>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Edicao.Campos}" Margin="20,0,20,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Rotulo}" Style="{StaticResource Rotulo}" />
                                            <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding SomenteLeitura}" t:Mascaras.Data="{Binding Campo.Tipo, Converter={StaticResource EnumIgual}, ConverterParameter=Data}" AutomationProperties.Name="{Binding Rotulo}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SomenteLeitura}" Value="True">
                                                                <Setter Property="ToolTip" Value="Contrato e escola identificam a obra da planilha e não mudam aqui." />
                                                                <Setter Property="Foreground" Value="{StaticResource Secundario}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <DockPanel Visibility="{Binding Editado, Converter={StaticResource Visivel}}" Margin="0,2,0,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Voltar ao da planilha" Margin="8,0,0,0" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.VoltarAoDaPlanilhaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding NaPlanilha}" FontSize="12" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Azul}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlanilhaMudou}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource Laranja}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        </DockPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Incluir obra" Margin="12,0,0,0" MinHeight="44" Command="{Binding NovaObraCommand}"
                        ToolTip="Uma obra que ainda não está na planilha mestra" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Conferir uma planilha" Margin="12,0,0,0" MinHeight="44" Command="{Binding ConferirPlanilhaCommand}"
                        ToolTip="Aponta portarias e dotações escritas fora do padrão numa planilha sua e propõe corrigir numa cópia" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoSecundario}" Content="Exportar para Excel" Margin="12,0,0,0" Command="{Binding ExportarCommand}"
                        Visibility="{Binding PodeSalvarConsultas, Converter={StaticResource Visivel}}"
                        ToolTip="Planilha nova com todas as obras deste filtro e uma aba com os filtros e a data da consulta" />
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLinha}" Content="Mostrar mais" Margin="12,0,0,0" Command="{Binding MostrarMaisCommand}"
                        Visibility="{Binding TemMais, Converter={StaticResource Visivel}}" />
                <TextBlock Text="{Binding Resumo}" Style="{StaticResource Forte}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0" Visibility="{Binding Resultado, Converter={StaticResource VisivelSe}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Mostrar na pasta" Margin="12,0,0,0" VerticalAlignment="Center"
                        Command="{Binding AbrirExportacaoCommand}" Visibility="{Binding PodeAbrirExportacao, Converter={StaticResource Visivel}}" />
                <TextBlock Text="{Binding Resultado}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Avisos}" ItemTemplate="{StaticResource AvisoModelo}" Margin="0,8,0,-8" Focusable="False" />
        </StackPanel>
    </Grid>
</UserControl>
